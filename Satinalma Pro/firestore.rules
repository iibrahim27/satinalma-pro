// ESKİ / KULLANILMAYAN KOPYA
// Canlı kurallar: depo kökündeki firestore.rules
// Deploy: E:\METRİK klasöründen → firebase deploy --only firestore:rules
// Bu dosyayı değiştirmeyin; yanlışlıkla buradan deploy etmeyin.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
