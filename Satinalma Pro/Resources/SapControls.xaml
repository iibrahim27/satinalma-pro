<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- SAP Fiori Quartz Light — global kontroller -->

  <Style TargetType="Window">
    <Setter Property="Background" Value="#EEF2F5" />
    <Setter Property="Foreground" Value="#102A43" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style TargetType="UserControl">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#102A43" />
    <Setter Property="FontFamily" Value="Segoe UI" />
  </Style>

  <!-- Foreground zorlanmaz: parent'tan miras (beyaz buton yazıları kaybolmasın) -->
  <Style TargetType="TextBlock" />

  <Style TargetType="Label">
    <Setter Property="Foreground" Value="#627D98" />
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="Foreground" Value="#102A43" />
    <Setter Property="CaretBrush" Value="#102A43" />
    <Setter Property="SelectionBrush" Value="#0D7377" />
    <Setter Property="SelectionTextBrush" Value="White" />
    <Setter Property="BorderBrush" Value="#9FB3C8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="FontSize" Value="13" />
    <Style.Triggers>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter Property="BorderBrush" Value="#0D7377" />
      </Trigger>
      <Trigger Property="IsReadOnly" Value="True">
        <Setter Property="Background" Value="#EEF2F5" />
        <Setter Property="Foreground" Value="#627D98" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="PasswordBox">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="Foreground" Value="#102A43" />
    <Setter Property="CaretBrush" Value="#102A43" />
    <Setter Property="SelectionBrush" Value="#0D7377" />
    <Setter Property="BorderBrush" Value="#9FB3C8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,7" />
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="Foreground" Value="#102A43" />
    <Setter Property="BorderBrush" Value="#9FB3C8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="MinHeight" Value="36" />
  </Style>

  <Style TargetType="DatePicker">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="Foreground" Value="#102A43" />
    <Setter Property="BorderBrush" Value="#9FB3C8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,4" />
  </Style>

  <Style TargetType="DatePickerTextBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#102A43" />
    <Setter Property="CaretBrush" Value="#102A43" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="#102A43" />
  </Style>

  <Style TargetType="RadioButton">
    <Setter Property="Foreground" Value="#102A43" />
  </Style>

  <Style TargetType="GroupBox">
    <Setter Property="Foreground" Value="#627D98" />
    <Setter Property="BorderBrush" Value="#D9E2EC" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>

  <Style TargetType="ListBox">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="Foreground" Value="#102A43" />
    <Setter Property="BorderBrush" Value="#D9E2EC" />
  </Style>

  <Style TargetType="ListBoxItem">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Foreground" Value="#102A43" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#F0F4F8" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="#E0FCFF" />
        <Setter Property="Foreground" Value="#102A43" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="TabControl">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="#627D98" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="Tab" Background="Transparent" BorderBrush="Transparent"
                  BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}" Margin="0,0,4,0">
            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Tab" Property="Background" Value="#F0F4F8" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Tab" Property="BorderBrush" Value="#0D7377" />
              <Setter Property="Foreground" Value="#0D7377" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="Foreground" Value="#102A43" />
    <Setter Property="BorderBrush" Value="#D9E2EC" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="RowBackground" Value="#FFFFFF" />
    <Setter Property="AlternatingRowBackground" Value="#EEF2F5" />
    <Setter Property="HorizontalGridLinesBrush" Value="#E5E5E5" />
    <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="RowHeight" Value="44" />
    <Setter Property="ColumnHeaderHeight" Value="40" />
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="CanUserAddRows" Value="False" />
    <Setter Property="AutoGenerateColumns" Value="False" />
  </Style>

  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="#EEF2F5" />
    <Setter Property="Foreground" Value="#627D98" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="BorderBrush" Value="#D9E2EC" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <Style TargetType="DataGridCell">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Foreground" Value="#102A43" />
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="#E0FCFF" />
        <Setter Property="Foreground" Value="#102A43" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="DataGridRow">
    <Setter Property="Background" Value="#FFFFFF" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#F0F4F8" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="#E0FCFF" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="ScrollViewer">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style TargetType="Separator">
    <Setter Property="Background" Value="#D9E2EC" />
  </Style>

  <Style x:Key="SapPageRoot" TargetType="Border">
    <Setter Property="Background" Value="#EEF2F5" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style x:Key="SapPageHeader" TargetType="Border">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#D9E2EC" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="24,16" />
  </Style>

  <Style x:Key="SapSectionCard" TargetType="Border">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#D9E2EC" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style x:Key="SapSideNav" TargetType="Border">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#D9E2EC" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>

  <Style x:Key="SapObjectHeader" TargetType="Border">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#D9E2EC" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="20,14" />
  </Style>

  <Style x:Key="SapCommandBar" TargetType="Border">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#D9E2EC" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="16,8" />
  </Style>

  <Style x:Key="SapFilterBar" TargetType="Border">
    <Setter Property="Background" Value="#F0F4F8" />
    <Setter Property="BorderBrush" Value="#D9E2EC" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="16,10" />
  </Style>

  <Style x:Key="SapMetricStrip" TargetType="Border">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#D9E2EC" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="16,8" />
  </Style>

  <Style x:Key="SapContentHost" TargetType="Border">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style x:Key="SapFooterBar" TargetType="Border">
    <Setter Property="Background" Value="#EEF2F5" />
    <Setter Property="BorderBrush" Value="#D9E2EC" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="16,10" />
  </Style>

  <Style x:Key="SapFacetSection" TargetType="Border">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#D9E2EC" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="16,14" />
    <Setter Property="Margin" Value="0,0,0,1" />
  </Style>

  <Style x:Key="SapMetricItem" TargetType="Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="#D9E2EC" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="Padding" Value="14,4,18,4" />
    <Setter Property="MinWidth" Value="120" />
  </Style>

  <Style x:Key="SapStickyActionBar" TargetType="Border">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#D9E2EC" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="16,12" />
  </Style>

  <Style x:Key="SapInboxMaster" TargetType="Border">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#D9E2EC" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>

  <Style x:Key="SapInboxDetail" TargetType="Border">
    <Setter Property="Background" Value="#EEF2F5" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style x:Key="SapFilterField" TargetType="StackPanel">
    <Setter Property="Margin" Value="0,0,12,0" />
    <Setter Property="MinWidth" Value="140" />
    <Setter Property="MaxWidth" Value="220" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="SapFilterLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#627D98" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <!-- Fiori Launchpad tile -->
  <Style x:Key="SapLaunchTile" TargetType="Border">
    <Setter Property="Background" Value="#0D7377" />
    <Setter Property="Width" Value="176" />
    <Setter Property="Height" Value="176" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Margin" Value="0,0,12,12" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

</ResourceDictionary>
