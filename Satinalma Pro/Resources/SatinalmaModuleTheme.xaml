<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Satınalma — SAP Quartz Light -->
  <Color x:Key="SatModAccent">#0D7377</Color>
  <Color x:Key="SatModAccentSoft">#E0FCFF</Color>
  <Color x:Key="SatModRose">#0D7377</Color>
  <Color x:Key="SatModBg">#EEF2F5</Color>
  <Color x:Key="SatModInk">#102A43</Color>

  <SolidColorBrush x:Key="SatModAccentBrush" Color="{StaticResource SatModAccent}" />
  <SolidColorBrush x:Key="SatModAccentSoftBrush" Color="{StaticResource SatModAccentSoft}" />
  <SolidColorBrush x:Key="SatModBgBrush" Color="{StaticResource SatModBg}" />
  <SolidColorBrush x:Key="SatModInkBrush" Color="{StaticResource SatModInk}" />

  <!-- Talep Pro shell / liste — fallback (TalepProTheme override eder) -->
  <SolidColorBrush x:Key="PrimaryTealBrush" Color="#0D7377" />
  <SolidColorBrush x:Key="PrimaryTealDarkBrush" Color="#0A5C5F" />
  <SolidColorBrush x:Key="PrimaryTealLightBrush" Color="#E0FCFF" />
  <SolidColorBrush x:Key="NavyTextBrush" Color="#102A43" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="#627D98" />
  <SolidColorBrush x:Key="AppBackgroundBrush" Color="#EEF2F5" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="BorderBrush" Color="#D9E2EC" />
  <SolidColorBrush x:Key="DangerBrush" Color="#E83F45" />
  <SolidColorBrush x:Key="WarningBrush" Color="#F28C28" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#24964A" />
  <SolidColorBrush x:Key="InfoBrush" Color="#246FE5" />
  <SolidColorBrush x:Key="PurpleBrush" Color="#7447D8" />
  <SolidColorBrush x:Key="BadgeCreamBrush" Color="#F5E6A8" />
  <SolidColorBrush x:Key="RowHoverBrush" Color="#F0F4F8" />
  <SolidColorBrush x:Key="RowSelectedBrush" Color="#E0FCFF" />
  <SolidColorBrush x:Key="HeaderSurfaceBrush" Color="#F8FAFC" />

  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource NavyTextBrush}" />
  </Style>
  <Style x:Key="SectionSubtitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="BreadcrumbText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryToolbarButtonStyle}">
    <Setter Property="Background" Value="{StaticResource PrimaryTealBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}" />
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
    <Setter Property="Padding" Value="8" />
    <Setter Property="MinWidth" Value="36" />
  </Style>
  <Style x:Key="UserProfilePanel" TargetType="Border">
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="14,12" />
  </Style>
  <Style x:Key="NotificationBadge" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource DangerBrush}" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="MinWidth" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Padding" Value="5,0" />
  </Style>
  <Style x:Key="SummaryCard" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16,14" />
  </Style>
  <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource FilterBoxStyle}" />
  <Style x:Key="FilterButton" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}" />
  <Style x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style x:Key="PaginationButton" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="MinWidth" Value="32" />
  </Style>
  <Style x:Key="StatusBadge" TargetType="Border">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}" />
  <Style x:Key="PurpleOutlineButton" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}" />

  <LinearGradientBrush x:Key="SatModHeroGradient" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#102A43" Offset="0" />
    <GradientStop Color="#0D7377" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="SatModIconGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#0D7377" Offset="0" />
    <GradientStop Color="#102A43" Offset="1" />
  </LinearGradientBrush>

  <DropShadowEffect x:Key="SatModCardShadow" BlurRadius="4" ShadowDepth="0" Opacity="0.08" Color="#102A43" />

  <Style x:Key="SatModCard" TargetType="Border">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#D9E2EC" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="20" />
  </Style>

  <Style x:Key="SatModSectionTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#102A43" />
  </Style>

  <Style x:Key="SatModHint" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="#627D98" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="SatModBackButton" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="0,0,0,14" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style x:Key="SatModDataGrid" TargetType="DataGrid" BasedOn="{StaticResource ModuleDataGridStyle}">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="AlternatingRowBackground" Value="#EEF2F5" />
  </Style>

  <Style x:Key="ModernDataGrid" TargetType="DataGrid" BasedOn="{StaticResource SatModDataGrid}" />

  <Style x:Key="SatModListItem" TargetType="ListViewItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListViewItem">
          <Border x:Name="Kart" Background="#FFFFFF" BorderBrush="#D9E2EC"
                  BorderThickness="1" CornerRadius="0" Padding="14,12" Cursor="Hand">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Kart" Property="Background" Value="#F0F4F8" />
              <Setter TargetName="Kart" Property="BorderBrush" Value="#0D7377" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Kart" Property="Background" Value="#E0FCFF" />
              <Setter TargetName="Kart" Property="BorderBrush" Value="#0D7377" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SatModStatCard" TargetType="Border">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#D9E2EC" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="18,16" />
    <Setter Property="Cursor" Value="Hand" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="BorderBrush" Value="#0D7377" />
        <Setter Property="Background" Value="#E0FCFF" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="SatModBadge" TargetType="Border">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Background" Value="#E0FCFF" />
  </Style>

  <LinearGradientBrush x:Key="SatModNavActiveGradient" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#E0FCFF" Offset="0" />
    <GradientStop Color="#E0FCFF" Offset="1" />
  </LinearGradientBrush>

  <Style x:Key="SatModSideNavGroup" TargetType="TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="#627D98" />
    <Setter Property="Margin" Value="14,16,14,6" />
  </Style>

  <Style x:Key="SatModSideNavItem" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Shell" Background="Transparent" CornerRadius="0" Padding="10,9" Margin="8,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="Accent" Grid.Column="0" Background="Transparent" Margin="0,2" />
              <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Shell" Property="Background" Value="#F0F4F8" />
            </Trigger>
            <Trigger Property="Tag" Value="Active">
              <Setter TargetName="Shell" Property="Background" Value="#E0FCFF" />
              <Setter TargetName="Accent" Property="Background" Value="#0D7377" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="NavigationItem" TargetType="Button" BasedOn="{StaticResource SatModSideNavItem}" />
  <Style x:Key="ActiveNavigationItem" TargetType="Button" BasedOn="{StaticResource SatModSideNavItem}" />

  <Style x:Key="SatModSideNavLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="#102A43" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="SatModSideNavLabelActive" TargetType="TextBlock" BasedOn="{StaticResource SatModSideNavLabel}">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#102A43" />
  </Style>

  <Style x:Key="SatModSideNavBadge" TargetType="Border">
    <Setter Property="MinWidth" Value="22" />
    <Setter Property="Height" Value="20" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Background" Value="#0D7377" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Visibility" Value="Collapsed" />
  </Style>

  <DropShadowEffect x:Key="SatModSoftShadow" BlurRadius="8" ShadowDepth="0" Opacity="0.08" Color="#102A43" />

  <Style x:Key="SatModPremiumCard" TargetType="Border">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#D9E2EC" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="20" />
  </Style>

  <Style x:Key="SatModWorkflowCard" TargetType="Border">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#D9E2EC" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="BorderBrush" Value="#0D7377" />
        <Setter Property="Background" Value="#E0FCFF" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="SatModMiniKpiCard" TargetType="Border">
    <Setter Property="Background" Value="#EEF2F5" />
    <Setter Property="BorderBrush" Value="#D9E2EC" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <Style x:Key="SatModTabBar" TargetType="Border">
    <Setter Property="Background" Value="#F0F4F8" />
    <Setter Property="BorderBrush" Value="#D9E2EC" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="4" />
  </Style>

  <Style x:Key="SatModTabButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="#627D98" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="0"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="B" Property="Background" Value="#F0F4F8" />
              <Setter Property="Foreground" Value="#102A43" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SatModTabButtonActive" TargetType="Button" BasedOn="{StaticResource SatModTabButton}">
    <Setter Property="Foreground" Value="#0D7377" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="#FFFFFF" CornerRadius="0" Padding="{TemplateBinding Padding}"
                  BorderBrush="#0D7377" BorderThickness="1">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SatModIconButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="B" Background="Transparent" CornerRadius="0" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="B" Property="Background" Value="#F0F4F8" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SatModPanosuGrid" TargetType="DataGrid" BasedOn="{StaticResource ModuleDataGridStyle}">
    <Setter Property="RowHeight" Value="46" />
    <Setter Property="CanUserSortColumns" Value="True" />
    <Setter Property="CanUserResizeColumns" Value="True" />
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="RowBackground" Value="#FFFFFF" />
    <Setter Property="AlternatingRowBackground" Value="#EEF2F5" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="#E5E5E5" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="SelectionMode" Value="Single" />
  </Style>

</ResourceDictionary>
