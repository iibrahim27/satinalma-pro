<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:SatinalmaPro.Controls">

  <Color x:Key="LoginNavy">#0F172A</Color>
  <Color x:Key="LoginAccentStart">#0D7377</Color>
  <Color x:Key="LoginAccentEnd">#14919B</Color>
  <Color x:Key="LoginGlassFill">#F2151C2C</Color>
  <Color x:Key="LoginGlassStroke">#243044</Color>

  <SolidColorBrush x:Key="LoginNavyBrush" Color="{StaticResource LoginNavy}" />
  <SolidColorBrush x:Key="LoginGlassFillBrush" Color="{StaticResource LoginGlassFill}" />
  <SolidColorBrush x:Key="LoginGlassStrokeBrush" Color="{StaticResource LoginGlassStroke}" />
  <SolidColorBrush x:Key="LoginTextBrush" Color="#F1F5F9" />
  <SolidColorBrush x:Key="LoginMutedBrush" Color="#94A3B8" />
  <SolidColorBrush x:Key="LoginFieldBgBrush" Color="#0B1220" />
  <SolidColorBrush x:Key="LoginAccentBrush" Color="#0D7377" />

  <LinearGradientBrush x:Key="LoginAccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="{StaticResource LoginAccentStart}" Offset="0" />
    <GradientStop Color="{StaticResource LoginAccentEnd}" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="LoginHeroBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#0B1220" Offset="0" />
    <GradientStop Color="{StaticResource LoginNavy}" Offset="0.55" />
    <GradientStop Color="#1A2740" Offset="1" />
  </LinearGradientBrush>

  <DropShadowEffect x:Key="LoginCardShadow" BlurRadius="20" ShadowDepth="0" Opacity="0.4" Color="#000000" />
  <DropShadowEffect x:Key="LoginGlowShadow" BlurRadius="16" ShadowDepth="0" Opacity="0.28" Color="#0D7377" />

  <controls:LoginBoyutCarpanConverter x:Key="LoginBoyutCarpanConverter" />

  <Style x:Key="LoginGlassCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource LoginGlassFillBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LoginGlassStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="28,24" />
    <Setter Property="Effect" Value="{StaticResource LoginCardShadow}" />
  </Style>

  <Style x:Key="LoginFieldLabelStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource LoginMutedBrush}" />
    <Setter Property="Margin" Value="4,0,0,6" />
  </Style>

  <!-- Koyu kutu + AÇIK yazı (InkBrush kullanma — görünmez olur) -->
  <Style x:Key="LoginTextBoxStyle" TargetType="TextBox">
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Background" Value="{StaticResource LoginFieldBgBrush}" />
    <Setter Property="Foreground" Value="{StaticResource LoginTextBrush}" />
    <Setter Property="CaretBrush" Value="{StaticResource LoginTextBrush}" />
    <Setter Property="SelectionBrush" Value="{StaticResource LoginAccentBrush}" />
    <Setter Property="SelectionTextBrush" Value="White" />
    <Setter Property="BorderBrush" Value="#334155" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Style.Triggers>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource LoginAccentBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="LoginPasswordBoxStyle" TargetType="PasswordBox">
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Background" Value="{StaticResource LoginFieldBgBrush}" />
    <Setter Property="Foreground" Value="{StaticResource LoginTextBrush}" />
    <Setter Property="CaretBrush" Value="{StaticResource LoginTextBrush}" />
    <Setter Property="SelectionBrush" Value="{StaticResource LoginAccentBrush}" />
    <Setter Property="BorderBrush" Value="#334155" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Style.Triggers>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource LoginAccentBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="LoginPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryToolbarButtonStyle}">
    <Setter Property="MinHeight" Value="50" />
    <Setter Property="Height" Value="50" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="BtnBorder" CornerRadius="8" Background="#0D7377"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="BtnBorder" Property="Background" Value="#14919B" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="BtnBorder" Property="Opacity" Value="0.55" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Storyboard x:Key="LoginCardShakeStoryboard">
    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
      <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
      <LinearDoubleKeyFrame KeyTime="0:0:0.05" Value="12" />
      <LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="-12" />
      <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="8" />
      <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="-8" />
      <LinearDoubleKeyFrame KeyTime="0:0:0.25" Value="0" />
    </DoubleAnimationUsingKeyFrames>
  </Storyboard>

  <Storyboard x:Key="LoginCardEnterStoryboard">
    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5" />
    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                     From="36" To="0" Duration="0:0:0.5">
      <DoubleAnimation.EasingFunction>
        <CubicEase EasingMode="EaseOut" />
      </DoubleAnimation.EasingFunction>
    </DoubleAnimation>
  </Storyboard>

</ResourceDictionary>
