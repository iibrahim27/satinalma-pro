<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- SAP Fiori Quartz Light -->
  <Color x:Key="DashPrimary">#0D7377</Color>
  <Color x:Key="DashDark">#102A43</Color>
  <Color x:Key="DashDarkMid">#FFFFFF</Color>
  <Color x:Key="DashBackground">#EEF2F5</Color>
  <Color x:Key="DashCard">#FFFFFF</Color>
  <Color x:Key="DashBorder">#D9E2EC</Color>
  <Color x:Key="DashText">#102A43</Color>
  <Color x:Key="DashTextSecondary">#627D98</Color>
  <Color x:Key="DashSidebarText">#102A43</Color>
  <Color x:Key="DashSidebarMuted">#627D98</Color>
  <Color x:Key="DashSidebarNavHover">#F0F4F8</Color>
  <Color x:Key="DashNavActive">#E0FCFF</Color>
  <Color x:Key="DashNavHover">#F0F4F8</Color>
  <Color x:Key="DashSidebarBg">#FFFFFF</Color>
  <Color x:Key="DashSuccess">#2F9E44</Color>
  <Color x:Key="DashWarning">#F08C00</Color>
  <Color x:Key="DashDanger">#E03131</Color>
  <Color x:Key="DashPurple">#0D7377</Color>
  <Color x:Key="DashTeal">#0F828F</Color>
  <Color x:Key="DashShell">#102A43</Color>
  <Color x:Key="DashShellText">#FFFFFF</Color>
  <Color x:Key="DashNavActiveText">#0D7377</Color>

  <SolidColorBrush x:Key="DashPrimaryBrush" Color="{StaticResource DashPrimary}" />
  <SolidColorBrush x:Key="DashDarkBrush" Color="{StaticResource DashDark}" />
  <SolidColorBrush x:Key="DashDarkMidBrush" Color="{StaticResource DashDarkMid}" />
  <SolidColorBrush x:Key="DashBackgroundBrush" Color="{StaticResource DashBackground}" />
  <SolidColorBrush x:Key="DashCardBrush" Color="{StaticResource DashCard}" />
  <SolidColorBrush x:Key="DashBorderBrush" Color="{StaticResource DashBorder}" />
  <SolidColorBrush x:Key="DashTextBrush" Color="{StaticResource DashText}" />
  <SolidColorBrush x:Key="DashTextSecondaryBrush" Color="{StaticResource DashTextSecondary}" />
  <SolidColorBrush x:Key="DashSidebarTextBrush" Color="{StaticResource DashSidebarText}" />
  <SolidColorBrush x:Key="DashSidebarMutedBrush" Color="{StaticResource DashSidebarMuted}" />
  <SolidColorBrush x:Key="DashSidebarNavHoverBrush" Color="{StaticResource DashSidebarNavHover}" />
  <SolidColorBrush x:Key="DashNavActiveBrush" Color="{StaticResource DashNavActive}" />
  <SolidColorBrush x:Key="DashNavHoverBrush" Color="{StaticResource DashNavHover}" />
  <SolidColorBrush x:Key="DashSuccessBrush" Color="{StaticResource DashSuccess}" />
  <SolidColorBrush x:Key="DashWarningBrush" Color="{StaticResource DashWarning}" />
  <SolidColorBrush x:Key="DashDangerBrush" Color="{StaticResource DashDanger}" />
  <SolidColorBrush x:Key="DashShellBrush" Color="{StaticResource DashShell}" />
  <SolidColorBrush x:Key="DashShellTextBrush" Color="{StaticResource DashShellText}" />
  <SolidColorBrush x:Key="DashNavActiveTextBrush" Color="{StaticResource DashNavActiveText}" />

  <SolidColorBrush x:Key="DashSidebarBgBrush" Color="{StaticResource DashSidebarBg}" />

  <LinearGradientBrush x:Key="DashSidebarGradientBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFFFFF" Offset="0" />
    <GradientStop Color="#EEF2F5" Offset="1" />
  </LinearGradientBrush>

  <DropShadowEffect x:Key="DashCardShadow" BlurRadius="6" ShadowDepth="0" Opacity="0.06" Color="#223548" />
  <DropShadowEffect x:Key="DashCardShadowHover" BlurRadius="10" ShadowDepth="1" Opacity="0.10" Color="#223548" />

  <Style x:Key="DashCardBorderStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource DashCardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DashBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Effect" Value="{StaticResource DashCardShadow}" />
  </Style>

  <Style x:Key="DashGhostButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource DashCardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DashBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource DashTextBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="B" Property="Background" Value="#F0F4F8" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DashPrimaryButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource DashPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="B" Property="Background" Value="#2563EB" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DashNavButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Shell" Background="Transparent" CornerRadius="4" Padding="12,10" Margin="0,2"
                  BorderThickness="3,0,0,0" BorderBrush="Transparent">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Shell" Property="Background" Value="{StaticResource DashNavHoverBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Active">
              <Setter TargetName="Shell" Property="Background" Value="{StaticResource DashNavActiveBrush}" />
              <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource DashPrimaryBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DashSidebarNavButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Shell" Background="Transparent" CornerRadius="4" Padding="12,10" Margin="0,2"
                  BorderThickness="3,0,0,0" BorderBrush="Transparent">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Shell" Property="Background" Value="{StaticResource DashSidebarNavHoverBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Active">
              <Setter TargetName="Shell" Property="Background" Value="#F0F4F8" />
              <Setter TargetName="Shell" Property="BorderBrush" Value="#3B82F6" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DashBadgeStyle" TargetType="Border">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>

  <Style x:Key="DashSectionLinkStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource DashPrimaryBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ContentPresenter />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Opacity" Value="0.75" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DashQuickActionButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource DashCardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DashBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="12,14">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="B" Property="Background" Value="#F0F4F8" />
              <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource DashPrimaryBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DashModernGridHeaderStyle" TargetType="Border">
    <Setter Property="Background" Value="#EEF2F5" />
    <Setter Property="BorderBrush" Value="{StaticResource DashBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <!-- Modül sekmeleri -->
  <Style x:Key="ModuleTabControlStyle" TargetType="TabControl">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style x:Key="ModuleTabItemStyle" TargetType="TabItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource DashTextSecondaryBrush}" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="Tab" Background="Transparent" CornerRadius="4,4,0,0"
                  BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}"
                  Margin="{TemplateBinding Margin}">
            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Tab" Property="Background" Value="#F0F4F8" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Tab" Property="Background" Value="#FFFFFF" />
              <Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource DashPrimaryBrush}" />
              <Setter Property="Foreground" Value="{StaticResource DashPrimaryBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ModuleReportHeaderStyle" TargetType="Border">
    <Setter Property="Background" Value="#EEF2F5" />
    <Setter Property="BorderBrush" Value="{StaticResource DashBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="18,14" />
  </Style>

  <Style x:Key="ModuleKpiCardHoverStyle" TargetType="Border" BasedOn="{StaticResource DashCardBorderStyle}">
    <Setter Property="Padding" Value="18,16" />
    <Setter Property="Margin" Value="0,0,12,0" />
  </Style>

  <Style x:Key="ErpFilterToggleBarStyle" TargetType="Border">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource DashBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="Effect" Value="{StaticResource DashCardShadow}" />
  </Style>

  <Style x:Key="ErpFilterBadgeStyle" TargetType="Border">
    <Setter Property="Background" Value="#E0FCFF" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="Margin" Value="10,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="ErpGridFooterStyle" TargetType="Border">
    <Setter Property="Background" Value="#F0F4F8" />
    <Setter Property="Padding" Value="16,11" />
    <Setter Property="CornerRadius" Value="0,0,12,12" />
  </Style>

  <Style x:Key="ErpStatusBadgeBaseStyle" TargetType="Border">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="ErpStatusBadgeTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <Style x:Key="ErpFilterToggleLinkStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource DashPrimaryBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ContentPresenter />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Opacity" Value="0.75" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
