<UserControl x:Class="SatinalmaPro.Controls.LoginArkaPlanKontrolu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ClipToBounds="True">
  <Grid>
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0B1220" Offset="0" />
        <GradientStop Color="#0F172A" Offset="0.55" />
        <GradientStop Color="#1A2740" Offset="1" />
      </LinearGradientBrush>
    </Grid.Background>
    <Border Width="4" HorizontalAlignment="Left" Background="#3B82F6" />
    <Canvas Opacity="0.25">
      <Line X1="40" Y1="100" X2="700" Y2="160" Stroke="#3B82F6" StrokeThickness="1" />
      <Line X1="40" Y1="260" X2="700" Y2="320" Stroke="#60A5FA" StrokeThickness="1" />
      <Ellipse Canvas.Left="90" Canvas.Top="60" Width="8" Height="8" Fill="#3B82F6" />
      <Ellipse Canvas.Left="240" Canvas.Top="180" Width="6" Height="6" Fill="#60A5FA" />
      <Ellipse Canvas.Left="380" Canvas.Top="120" Width="10" Height="10" Fill="#3B82F6" />
    </Canvas>
  </Grid>
</UserControl>
