<UserControl x:Class="SatinalmaPro.Controls.Dashboard.DashboardHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dash="clr-namespace:SatinalmaPro.Controls.Dashboard">
  <!-- Açık workspace üst çubuğu — mavi SAP shell bar yok -->
  <Border Background="#FFFFFF" Padding="24,0" Height="58"
          BorderBrush="#D9E2EC" BorderThickness="0,0,0,1">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Satınalma" FontSize="16" FontWeight="SemiBold" Foreground="#102A43" />
        <TextBlock Text=" Pro" FontSize="16" FontWeight="Light" Foreground="#0D7377" />
        <Border Background="#E0FCFF" CornerRadius="8" Padding="10,4" Margin="14,0,0,0">
          <TextBlock x:Name="TxtBreadcrumb" Text="Workspace" FontSize="11"
                     FontWeight="SemiBold" Foreground="#0D7377" />
        </Border>
      </StackPanel>

      <Border Grid.Column="1" Margin="32,0" MaxWidth="520" HorizontalAlignment="Left"
              Background="#F0F4F8" BorderBrush="#D9E2EC" BorderThickness="1" CornerRadius="10"
              Padding="14,8" VerticalAlignment="Center" Height="38">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                     Foreground="#627D98" VerticalAlignment="Center" />
          <TextBox x:Name="TxtArama" Grid.Column="1" Margin="10,0,0,0" BorderThickness="0" Background="Transparent"
                   CaretBrush="#102A43" FontSize="13" Foreground="#102A43"
                   VerticalAlignment="Center" TextChanged="TxtArama_TextChanged" />
          <TextBlock Grid.Column="1" IsHitTestVisible="False" Margin="10,0,0,0"
                     Text="Ara: belge, tedarikçi, malzeme..." FontSize="13"
                     Foreground="#9FB3C8" VerticalAlignment="Center">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=TxtArama}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="6" Padding="8,2" Margin="8,0,0,0"
                  BorderBrush="#D9E2EC" BorderThickness="1">
            <TextBlock Text="Ctrl+K" FontSize="10" Foreground="#627D98" />
          </Border>
        </Grid>
      </Border>

      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Background="#F0F4F8" CornerRadius="8" Padding="12,6" Margin="0,0,10,0">
          <TextBlock x:Name="TxtFirmaKisa" Text="Merkez Satınalma" FontSize="12" Foreground="#102A43" />
        </Border>

        <Button x:Name="BtnTalepPro" Content="Talep Pro'yu aç"
                Margin="0,0,10,0" Padding="12,8" Cursor="Hand"
                Background="#4F46E5" Foreground="White" BorderThickness="0"
                FontSize="12" FontWeight="SemiBold"
                Click="BtnTalepPro_Click" ToolTip="Talep Pro uygulamasını aç"
                Visibility="Collapsed">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="8"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="B" Property="Background" Value="#4338CA" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>

        <Button x:Name="BtnBildirim" Margin="0,0,4,0" Padding="10,8" Background="Transparent"
                BorderThickness="0" Cursor="Hand" Click="BtnBildirim_Click" ToolTip="Bildirimler">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="B" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="B" Property="Background" Value="#E0FCFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
          <Grid>
            <dash:IconControl Kind="Bell" IconSize="18" StrokeBrush="#102A43" />
            <Border x:Name="BadgeBildirim" Background="#E03131" CornerRadius="8" MinWidth="18" Height="18"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10,-4,-4,0"
                    Visibility="Collapsed">
              <TextBlock x:Name="TxtBadgeSayi" Text="0" FontSize="10" FontWeight="Bold"
                         Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Grid>
        </Button>

        <Button x:Name="BtnAyarlar" Padding="10,8" Background="Transparent" BorderThickness="0"
                Cursor="Hand" Click="BtnAyarlar_Click" ToolTip="Ayarlar">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="B" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="B" Property="Background" Value="#E0FCFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
          <dash:IconControl Kind="Settings" IconSize="18" StrokeBrush="#102A43" />
        </Button>

        <Button x:Name="BtnCikis" Content="Çıkış Yap" Style="{StaticResource DashGhostButtonStyle}"
                Margin="8,0,0,0" Padding="12,8" Click="BtnCikis_Click"
                ToolTip="Oturumu kapat" Visibility="Collapsed" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
