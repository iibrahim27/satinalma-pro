<Window x:Class="SatinalmaPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:dash="clr-namespace:SatinalmaPro.Controls.Dashboard"
        xmlns:helpers="clr-namespace:SatinalmaPro.Helpers"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Satınalma Pro"
        Icon="Assets/app.ico"
        Height="900"
        Width="1600"
        MinHeight="768"
        MinWidth="1366"
        WindowStartupLocation="CenterScreen"
        Background="#EEF2F5"
        FontFamily="Segoe UI Variable, Segoe UI"
        Focusable="True">

  <!-- Workspace 26: etiketli sol menü + içerik -->
  <Grid Background="#EEF2F5">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <dash:AppSidebarView x:Name="Sidebar" Grid.Column="0" />

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <dash:DashboardHeaderView x:Name="Header" Grid.Row="0" />

      <Grid Grid.Row="1" Background="#EEF2F5">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="ModulBaslikPanel" Grid.Row="0" Visibility="Collapsed"
                Background="Transparent" Padding="28,18,28,0">
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource DashGhostButtonStyle}" Padding="10,8" Click="Home_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="#627D98" Margin="0,0,8,0" />
                <TextBlock Text="Workspace" VerticalAlignment="Center" Foreground="#102A43" />
              </StackPanel>
            </Button>
            <Rectangle Width="1" Margin="14,4" Fill="#D9E2EC" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
              <Border x:Name="ModulIkonZemin" Width="40" Height="40" CornerRadius="12" Background="#0D7377">
                <TextBlock x:Name="TxtModulIkon" FontFamily="Segoe MDL2 Assets" FontSize="16"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TxtModulBaslik" FontSize="20" FontWeight="SemiBold" Foreground="#102A43" />
                <TextBlock x:Name="TxtModulAltBaslik" FontSize="12" Foreground="#627D98" Margin="0,2,0,0" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <ContentControl x:Name="MainRegion" Grid.Row="1"
                        helpers:ScrollWheelHelper.IsEnabled="True" Margin="0" />
      </Grid>

      <Border Grid.Row="2" Padding="24,7" Background="#FFFFFF" BorderBrush="#D9E2EC" BorderThickness="0,1,0,0">
        <Grid>
          <TextBlock x:Name="TxtAltBilgi" FontSize="11" Foreground="#627D98"
                     HorizontalAlignment="Left" VerticalAlignment="Center" />
          <!-- Teklif Onay kaldırıldı (Talep Pro) — CS uyumluluğu için gizli -->
          <Button x:Name="BtnYonetimTeklifOnay" Visibility="Collapsed" Click="YonetimTeklifOnay_Click" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
