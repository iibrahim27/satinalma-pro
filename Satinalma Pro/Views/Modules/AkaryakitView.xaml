<UserControl x:Class="SatinalmaPro.Views.Modules.AkaryakitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:controls="clr-namespace:SatinalmaPro.Views.Controls"
             Background="#EEF2F5">
  <!-- Workspace 26: hero + yatay filtre + tam genişlik tablo -->
  <Grid x:Name="AnaIcerikGrid" Margin="20,12,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="320" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="16" BorderBrush="#D9E2EC" BorderThickness="1"
            Padding="22,16" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock Text="AKARYAKIT" FontSize="11" FontWeight="Bold" Foreground="#0D7377" />
          <TextBlock Text="Akaryakıt" FontSize="22" FontWeight="SemiBold" Foreground="#102A43" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
          <Border BorderBrush="#D9E2EC" BorderThickness="0,0,1,0" Padding="0,0,12,0" Margin="0,0,12,0">
            <StackPanel>
              <TextBlock Text="Gelen" FontSize="10" FontWeight="SemiBold" Foreground="#627D98" />
              <TextBlock x:Name="TxtGelenAkaryakit" Text="0 Lt" FontSize="14" FontWeight="SemiBold" Foreground="#102A43" />
              <TextBlock x:Name="TxtGelenKayit" Text="0 alım kaydı" FontSize="10" Foreground="#627D98" />
            </StackPanel>
          </Border>
          <Border BorderBrush="#D9E2EC" BorderThickness="0,0,1,0" Padding="0,0,12,0" Margin="0,0,12,0">
            <StackPanel>
              <TextBlock Text="Stok" FontSize="10" FontWeight="SemiBold" Foreground="#627D98" />
              <TextBlock x:Name="TxtStokAkaryakit" Text="0 Lt" FontSize="14" FontWeight="SemiBold" Foreground="#102A43" />
              <TextBlock x:Name="TxtStokDurum" Text="Gelen − dağıtılan" FontSize="10" Foreground="#627D98" />
            </StackPanel>
          </Border>
          <Border BorderBrush="#D9E2EC" BorderThickness="0,0,1,0" Padding="0,0,12,0" Margin="0,0,12,0">
            <StackPanel>
              <TextBlock Text="Dağıtılan" FontSize="10" FontWeight="SemiBold" Foreground="#627D98" />
              <TextBlock x:Name="TxtDagitilanAkaryakit" Text="0 Lt" FontSize="14" FontWeight="SemiBold" Foreground="#102A43" />
              <TextBlock x:Name="TxtDagitilanKayit" Text="0 dağıtım kaydı" FontSize="10" Foreground="#627D98" />
            </StackPanel>
          </Border>
          <Border BorderBrush="#D9E2EC" BorderThickness="0,0,1,0" Padding="0,0,12,0" Margin="0,0,12,0">
            <StackPanel>
              <TextBlock Text="Kayıt" FontSize="10" FontWeight="SemiBold" Foreground="#627D98" />
              <TextBlock x:Name="TxtToplamKayit" Text="0" FontSize="14" FontWeight="SemiBold" Foreground="#102A43" />
            </StackPanel>
          </Border>
          <Border BorderBrush="#D9E2EC" BorderThickness="0,0,1,0" Padding="0,0,12,0" Margin="0,0,12,0">
            <StackPanel>
              <TextBlock Text="Alınan Tutar" FontSize="10" FontWeight="SemiBold" Foreground="#627D98" />
              <TextBlock x:Name="TxtToplamTutar" Text="₺0" FontSize="14" FontWeight="SemiBold" Foreground="#102A43" />
            </StackPanel>
          </Border>
          <StackPanel>
            <TextBlock Text="Filtrelenen" FontSize="10" FontWeight="SemiBold" Foreground="#627D98" />
            <TextBlock x:Name="TxtFiltrelenen" Text="0 kayıt" FontSize="14" FontWeight="SemiBold" Foreground="#102A43" />
          </StackPanel>
        </StackPanel>
        <WrapPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
          <Button Style="{StaticResource PrimaryToolbarButtonStyle}" Click="YeniKayit_Click" Margin="0,0,6,0" Padding="12,8" Content="+ Yeni" />
          <Button x:Name="BtnExcelYukle" Style="{StaticResource ToolbarButtonStyle}" Click="ExcelYukle_Click" Margin="0,0,6,0" Padding="10,8" Content="Excel Yükle" />
          <Button x:Name="BtnSablonIndir" Style="{StaticResource ToolbarButtonStyle}" Click="SablonIndir_Click" Margin="0,0,6,0" Padding="10,8" Content="Şablon" />
          <Button Style="{StaticResource ToolbarButtonStyle}" Click="PdfIndir_Click" Margin="0,0,6,0" Padding="10,8" Content="PDF" />
          <Button Style="{StaticResource ToolbarButtonStyle}" Click="PdfYazdir_Click" Margin="0,0,6,0" Padding="10,8" Content="Yazdır" />
          <Button Style="{StaticResource ToolbarButtonStyle}" Click="DisaAktar_Click" Margin="0,0,6,0" Padding="10,8" Content="Dışa Aktar" />
          <Button x:Name="BtnKayitDuzenle" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,6,0" Padding="10,8"
                  IsEnabled="False" Click="KayitDuzenle_Click" Content="Düzenle" />
          <Button x:Name="BtnKayitSil" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,6,0" Padding="10,8"
                  IsEnabled="False" Click="KayitSil_Click" Content="Sil" />
          <Button Style="{StaticResource ErpIconBtn}" Click="Yenile_Click" ToolTip="Yenile">
            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#102A43" />
          </Button>
        </WrapPanel>
      </Grid>
    </Border>

    <Border x:Name="FiltreKart" Grid.Row="1" Background="#FFFFFF" CornerRadius="14"
            BorderBrush="#D9E2EC" BorderThickness="1" Padding="16,12" Margin="0,0,0,12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel LastChildFill="False">
          <TextBlock Text="Filtreler" FontSize="13" FontWeight="SemiBold" Foreground="#102A43"
                     VerticalAlignment="Center" DockPanel.Dock="Left" />
          <Button Style="{StaticResource ToolbarButtonStyle}" Content="Filtreleri Temizle" Click="FiltreleriTemizle_Click"
                  DockPanel.Dock="Right" Padding="14,7" />
        </DockPanel>
        <WrapPanel Grid.Row="1" Margin="0,12,0,0">
          <StackPanel Width="200" Margin="0,0,12,8">
            <TextBlock Text="Ara" Style="{StaticResource SapFilterLabel}" />
            <TextBox x:Name="TxtArama" Style="{StaticResource FilterBoxStyle}" Height="34"
                     TextChanged="FiltreDegisti"
                     ui:ControlHelper.PlaceholderText="Plaka, tedarikçi, şoför..." />
          </StackPanel>
          <StackPanel Width="140" Margin="0,0,12,8">
            <TextBlock Text="Başlangıç" Style="{StaticResource SapFilterLabel}" />
            <DatePicker x:Name="DpBaslangic" Height="34" SelectedDateChanged="FiltreDegisti" />
          </StackPanel>
          <StackPanel Width="140" Margin="0,0,12,8">
            <TextBlock Text="Bitiş" Style="{StaticResource SapFilterLabel}" />
            <DatePicker x:Name="DpBitis" Height="34" SelectedDateChanged="FiltreDegisti" />
          </StackPanel>
          <StackPanel Width="140" Margin="0,0,12,8">
            <TextBlock Text="Kayıt Tipi" Style="{StaticResource SapFilterLabel}" />
            <ComboBox x:Name="CmbKayitTipi" Style="{StaticResource FilterComboStyle}" Height="34"
                      SelectionChanged="FiltreDegisti" />
          </StackPanel>
          <StackPanel Width="140" Margin="0,0,12,8">
            <TextBlock Text="Araç Tipi" Style="{StaticResource SapFilterLabel}" />
            <ComboBox x:Name="CmbAracTipi" Style="{StaticResource FilterComboStyle}" Height="34"
                      SelectionChanged="FiltreDegisti" />
          </StackPanel>
          <StackPanel Width="140" Margin="0,0,12,8">
            <TextBlock Text="Yakıt Türü" Style="{StaticResource SapFilterLabel}" />
            <ComboBox x:Name="CmbYakitTuru" Style="{StaticResource FilterComboStyle}" Height="34"
                      SelectionChanged="FiltreDegisti" />
          </StackPanel>
          <StackPanel Width="140" Margin="0,0,0,8">
            <TextBlock Text="Plaka / Kod" Style="{StaticResource SapFilterLabel}" />
            <ComboBox x:Name="CmbPlaka" Style="{StaticResource FilterComboStyle}" Height="34"
                      SelectionChanged="FiltreDegisti" />
          </StackPanel>
        </WrapPanel>
      </Grid>
    </Border>

    <Border x:Name="TabloKart" Grid.Row="2" Background="#FFFFFF" CornerRadius="16"
            BorderBrush="#D9E2EC" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F0F4F8" BorderBrush="#D9E2EC" BorderThickness="0,0,0,1"
                CornerRadius="16,16,0,0" Padding="16,10">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource ErpTableToolbarBtn}" Content="Kolonlar" Click="Kolonlar_Click" />
            <Button Style="{StaticResource ErpTableToolbarBtn}" Content="Grupla" Click="Grupla_Click" />
            <Button Style="{StaticResource ErpTableToolbarBtn}" Content="Filtre" Click="FiltreOdak_Click" />
            <Button Style="{StaticResource ErpTableToolbarBtn}" Content="Yoğun" Click="YogunGorunum_Click" />
            <Button x:Name="BtnTamEkran" Style="{StaticResource ErpTableToolbarBtn}" Content="Tam Ekran" Click="TamEkran_Click" />
          </StackPanel>
        </Border>

        <DataGrid x:Name="YakitGrid" Grid.Row="1" Style="{StaticResource ErpPremiumGrid}"
                  BorderThickness="0"
                  CanUserReorderColumns="True"
                  LoadingRow="YakitGrid_LoadingRow"
                  SelectionChanged="YakitGrid_SelectionChanged"
                  MouseDoubleClick="YakitGrid_MouseDoubleClick"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Düzenle" Click="MenuDuzenle_Click" />
              <Separator />
              <MenuItem Header="Sil" Click="MenuSil_Click" />
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.Columns>
            <DataGridTextColumn Header="Kayıt Tipi" Binding="{Binding KayitTipi}" Width="90" />
            <DataGridTextColumn Header="Tarih" Binding="{Binding Tarih}" Width="95" />
            <DataGridTextColumn Header="Miktar" Binding="{Binding MiktarMetin}" Width="90" />
            <DataGridTextColumn Header="Birim" Binding="{Binding BirimMetin}" Width="55" />
            <DataGridTextColumn Header="Birim Fiyatı" Binding="{Binding BirimFiyatiMetin}" Width="100" />
            <DataGridTextColumn Header="Toplam Tutar" Binding="{Binding ToplamTutarMetin}" Width="110" />
            <DataGridTextColumn Header="Tedarikçi" Binding="{Binding TedarikciMetin}" Width="120" />
            <DataGridTextColumn Header="Teslim Alan" Binding="{Binding TeslimAlanMetin}" Width="110" />
            <DataGridTextColumn Header="Plaka" Binding="{Binding PlakaMetin}" Width="100" />
            <DataGridTextColumn Header="Araç Tipi" Binding="{Binding AracTipiMetin}" Width="95" />
            <DataGridTextColumn Header="Araç / Makine" Binding="{Binding AracMakineMetin}" Width="130" />
            <DataGridTextColumn Header="Yakıt" Binding="{Binding YakitTuruMetin}" Width="75" />
            <DataGridTextColumn Header="Km" Binding="{Binding KmSayaciMetin}" Width="75" />
            <DataGridTextColumn Header="Saat" Binding="{Binding SaatSayaciMetin}" Width="75" />
            <DataGridTextColumn Header="Şoför" Binding="{Binding SoforMetin}" Width="110" />
            <DataGridTextColumn Header="Saha" Binding="{Binding SahaMetin}" Width="100" />
            <DataGridTextColumn Header="L/100km" Binding="{Binding Tuketim100KmMetin}" Width="95" />
            <DataGridTextColumn Header="Lt/Saat" Binding="{Binding TuketimSaatMetin}" Width="90" />
            <DataGridTextColumn Header="Açıklama" Binding="{Binding AciklamaMetin}" Width="*" MinWidth="120" />
          </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Style="{StaticResource ErpFooterBar}" CornerRadius="0,0,16,16">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtGrupBilgi" Style="{StaticResource ErpFooterText}" Visibility="Collapsed" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Sayfa boyutu:" Style="{StaticResource ErpFooterText}" Margin="0,0,8,0" />
                <ComboBox x:Name="CmbSayfaBoyutu" Width="72" Height="28" VerticalContentAlignment="Center"
                          SelectionChanged="SayfaBoyutuDegisti">
                  <ComboBoxItem Content="25" Tag="25" />
                  <ComboBoxItem Content="50" Tag="50" IsSelected="True" />
                  <ComboBoxItem Content="100" Tag="100" />
                </ComboBox>
              </StackPanel>
            </Grid>
            <controls:SayfalamaCubugu x:Name="SayfalamaBar" Grid.Row="1" Margin="0,8,0,0" />
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
