<UserControl x:Class="SatinalmaPro.Views.Modules.AracFiloView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:controls="clr-namespace:SatinalmaPro.Views.Controls"
             Loaded="AracFiloView_Loaded"
             Background="#EEF2F5">
  <!-- Workspace 26: hero + yatay filtre + tam genişlik tablo -->
  <Grid x:Name="AnaIcerikGrid" Margin="20,12,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="320" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="16" BorderBrush="#D9E2EC" BorderThickness="1"
            Padding="22,16" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock Text="FİLO" FontSize="11" FontWeight="Bold" Foreground="#0D7377" />
          <TextBlock Text="Araç Filo" FontSize="22" FontWeight="SemiBold" Foreground="#102A43" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
          <Border BorderBrush="#D9E2EC" BorderThickness="0,0,1,0" Padding="0,0,14,0" Margin="0,0,14,0">
            <StackPanel>
              <TextBlock Text="Toplam Araç" FontSize="10" FontWeight="SemiBold" Foreground="#627D98" />
              <TextBlock x:Name="TxtToplamArac" Text="0" FontSize="15" FontWeight="SemiBold" Foreground="#102A43" />
            </StackPanel>
          </Border>
          <Border BorderBrush="#D9E2EC" BorderThickness="0,0,1,0" Padding="0,0,14,0" Margin="0,0,14,0">
            <StackPanel>
              <TextBlock Text="Toplam Gider" FontSize="10" FontWeight="SemiBold" Foreground="#627D98" />
              <TextBlock x:Name="TxtToplamGider" Text="₺0" FontSize="15" FontWeight="SemiBold" Foreground="#102A43" />
            </StackPanel>
          </Border>
          <Border BorderBrush="#D9E2EC" BorderThickness="0,0,1,0" Padding="0,0,14,0" Margin="0,0,14,0">
            <StackPanel>
              <TextBlock Text="Muayene Yaklaşan" FontSize="10" FontWeight="SemiBold" Foreground="#627D98" />
              <TextBlock x:Name="TxtYaklasanMuayene" Text="0" FontSize="15" FontWeight="SemiBold" Foreground="#102A43" />
            </StackPanel>
          </Border>
          <StackPanel>
            <TextBlock Text="Filtrelenen" FontSize="10" FontWeight="SemiBold" Foreground="#627D98" />
            <TextBlock x:Name="TxtFiltrelenen" Text="0 araç" FontSize="15" FontWeight="SemiBold" Foreground="#102A43" />
          </StackPanel>
        </StackPanel>
        <WrapPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" MaxWidth="560">
          <Button Style="{StaticResource PrimaryToolbarButtonStyle}" Click="YeniArac_Click" Margin="0,0,6,4" Padding="12,8" Content="+ Yeni" />
          <Button Style="{StaticResource ToolbarButtonStyle}" Click="ExcelYukle_Click" Margin="0,0,6,4" Padding="10,8" Content="Excel" />
          <Button Style="{StaticResource ToolbarButtonStyle}" Click="SablonIndir_Click" Margin="0,0,6,4" Padding="10,8" Content="Şablon" />
          <Button Style="{StaticResource ToolbarButtonStyle}" Click="PdfYazdir_Click" Margin="0,0,6,4" Padding="10,8" Content="Yazdır" />
          <Button Style="{StaticResource ToolbarButtonStyle}" Click="DisaAktar_Click" Margin="0,0,6,4" Padding="10,8" Content="Dışa Aktar" />
          <Button x:Name="BtnAracDetay" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,6,4" Padding="10,8"
                  IsEnabled="False" Click="AracDetay_Click" Content="Detay" />
          <Button x:Name="BtnAracGider" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,6,4" Padding="10,8"
                  IsEnabled="False" Click="AracGider_Click" Content="Gider" />
          <Button x:Name="BtnAracDuzenle" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,6,4" Padding="10,8"
                  IsEnabled="False" Click="AracDuzenle_Click" Content="Düzenle" />
          <Button x:Name="BtnAracSil" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,6,4" Padding="10,8"
                  IsEnabled="False" Click="AracSil_Click" Content="Sil" />
          <Button x:Name="BtnAracSevk" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,6,4" Padding="10,8"
                  IsEnabled="False" Click="AracSevk_Click" Content="Sevk" />
          <Button x:Name="BtnAracZimmet" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,6,4" Padding="10,8"
                  IsEnabled="False" Click="AracZimmet_Click" Content="Zimmet" />
          <Button x:Name="BtnZimmetIptal" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,6,4" Padding="10,8"
                  IsEnabled="False" Click="ZimmetIptal_Click" Content="Zimmet İptal" />
          <Button x:Name="BtnZimmetPdf" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,6,4" Padding="10,8"
                  IsEnabled="False" Click="ZimmetPdf_Click" Content="Zimmet PDF" />
          <Button Style="{StaticResource ErpIconBtn}" Click="Yenile_Click" ToolTip="Yenile" Margin="0,0,0,4">
            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#102A43" />
          </Button>
        </WrapPanel>
      </Grid>
    </Border>

    <Border x:Name="FiltreKart" Grid.Row="1" Background="#FFFFFF" CornerRadius="14"
            BorderBrush="#D9E2EC" BorderThickness="1" Padding="16,12" Margin="0,0,0,12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel LastChildFill="False">
          <TextBlock Text="Filtreler" FontSize="13" FontWeight="SemiBold" Foreground="#102A43"
                     VerticalAlignment="Center" DockPanel.Dock="Left" />
          <Button Style="{StaticResource ToolbarButtonStyle}" Content="Filtreleri Temizle" Click="FiltreleriTemizle_Click"
                  DockPanel.Dock="Right" Padding="14,7" />
        </DockPanel>
        <WrapPanel Grid.Row="1" Margin="0,12,0,0">
          <StackPanel Width="220" Margin="0,0,12,8">
            <TextBlock Text="Ara" Style="{StaticResource SapFilterLabel}" />
            <TextBox x:Name="TxtArama" Style="{StaticResource FilterBoxStyle}" Height="34"
                     TextChanged="FiltreDegisti"
                     ui:ControlHelper.PlaceholderText="Plaka, marka, şirket..." />
          </StackPanel>
          <StackPanel Width="160" Margin="0,0,12,8">
            <TextBlock Text="Araç Tipi" Style="{StaticResource SapFilterLabel}" />
            <ComboBox x:Name="CmbAracTipi" Style="{StaticResource FilterComboStyle}" Height="34"
                      SelectionChanged="FiltreDegisti">
              <ComboBoxItem Content="Tümü" />
              <ComboBoxItem Content="Binek" />
              <ComboBoxItem Content="İş Makinası" />
            </ComboBox>
          </StackPanel>
          <StackPanel Width="160" Margin="0,0,0,8">
            <TextBlock Text="Sahiplik" Style="{StaticResource SapFilterLabel}" />
            <ComboBox x:Name="CmbSahiplik" Style="{StaticResource FilterComboStyle}" Height="34"
                      SelectionChanged="FiltreDegisti">
              <ComboBoxItem Content="Tümü" />
              <ComboBoxItem Content="Bizim" />
              <ComboBoxItem Content="Kiralık" />
            </ComboBox>
          </StackPanel>
        </WrapPanel>
      </Grid>
    </Border>

    <Border x:Name="TabloKart" Grid.Row="2" Background="#FFFFFF" CornerRadius="16"
            BorderBrush="#D9E2EC" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F0F4F8" BorderBrush="#D9E2EC" BorderThickness="0,0,0,1"
                CornerRadius="16,16,0,0" Padding="16,10">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource ErpTableToolbarBtn}" Content="Kolonlar" Click="Kolonlar_Click" />
            <Button Style="{StaticResource ErpTableToolbarBtn}" Content="Grupla" Click="Grupla_Click" />
            <Button Style="{StaticResource ErpTableToolbarBtn}" Content="Filtre" Click="FiltreOdak_Click" />
            <Button Style="{StaticResource ErpTableToolbarBtn}" Content="Yoğun" Click="YogunGorunum_Click" />
            <Button x:Name="BtnTamEkran" Style="{StaticResource ErpTableToolbarBtn}" Content="Tam Ekran" Click="TamEkran_Click" />
          </StackPanel>
        </Border>

        <DataGrid x:Name="FiloGrid" Grid.Row="1" Style="{StaticResource ErpPremiumGrid}"
                  BorderThickness="0"
                  CanUserReorderColumns="True"
                  LoadingRow="FiloGrid_LoadingRow"
                  SelectionChanged="FiloGrid_SelectionChanged"
                  MouseDoubleClick="FiloGrid_MouseDoubleClick"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Detay / Düzenle" Click="MenuDetay_Click" />
              <Separator />
              <MenuItem Header="Sil" Click="MenuSil_Click" />
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.Columns>
            <DataGridTextColumn Header="Plaka" Binding="{Binding Plaka}" Width="110" />
            <DataGridTextColumn Header="Şasi No" Binding="{Binding SasiNo}" Width="120" />
            <DataGridTextColumn Header="Tip" Binding="{Binding AracTipi}" Width="95" />
            <DataGridTextColumn Header="Marka / Model" Binding="{Binding MarkaModel}" Width="140" />
            <DataGridTextColumn Header="Zimmet" Binding="{Binding ZimmetMetin}" Width="120" />
            <DataGridTextColumn Header="Sahiplik" Binding="{Binding SahiplikMetin}" Width="85" />
            <DataGridTextColumn Header="Şirket" Binding="{Binding Sirket}" Width="130" />
            <DataGridTextColumn Header="Saha" Binding="{Binding Saha}" Width="120" />
            <DataGridTextColumn Header="Muayene" Binding="{Binding MuayeneUyariMetin}" Width="120" />
            <DataGridTextColumn Header="Sigorta" Binding="{Binding SigortaUyariMetin}" Width="120" />
            <DataGridTextColumn Header="Toplam Gider" Binding="{Binding ToplamGiderMetin}" Width="115" />
            <DataGridTextColumn Header="Durum" Binding="{Binding Durum}" Width="80" />
            <DataGridTextColumn Header="Açıklama" Binding="{Binding Aciklama}" Width="*" MinWidth="120" />
          </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Style="{StaticResource ErpFooterBar}" CornerRadius="0,0,16,16">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
              <TextBlock x:Name="TxtGrupBilgi" Style="{StaticResource ErpFooterText}" Visibility="Collapsed" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Sayfa boyutu:" Style="{StaticResource ErpFooterText}" Margin="0,0,8,0" />
                <ComboBox x:Name="CmbSayfaBoyutu" Width="72" Height="28" VerticalContentAlignment="Center"
                          SelectionChanged="SayfaBoyutuDegisti">
                  <ComboBoxItem Content="25" Tag="25" />
                  <ComboBoxItem Content="50" Tag="50" IsSelected="True" />
                  <ComboBoxItem Content="100" Tag="100" />
                </ComboBox>
              </StackPanel>
            </Grid>
            <controls:SayfalamaCubugu x:Name="SayfalamaBar" Grid.Row="1" Margin="0,8,0,0" />
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
