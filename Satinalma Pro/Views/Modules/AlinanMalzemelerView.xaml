<UserControl x:Class="SatinalmaPro.Views.Modules.AlinanMalzemelerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:controls="clr-namespace:SatinalmaPro.Views.Controls"
             Background="#EEF2F5">
  <!-- Workspace page: hero komut + yatay filtre şeridi + tam genişlik tablo (sol filtre paneli YOK) -->
  <Grid x:Name="AnaIcerikGrid" Margin="20,12,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="320" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="16" BorderBrush="#D9E2EC" BorderThickness="1"
            Padding="22,16" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="MALZEME GİRİŞİ" FontSize="11" FontWeight="Bold" Foreground="#0D7377" />
          <TextBlock Text="Alınan Malzemeler" FontSize="22" FontWeight="SemiBold" Foreground="#102A43" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel x:Name="KpiPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0" />
        <WrapPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
          <Button Style="{StaticResource PrimaryToolbarButtonStyle}" Click="YeniKayit_Click" Margin="0,0,6,0" Padding="12,8" Content="+ Yeni" />
          <Button Style="{StaticResource ToolbarButtonStyle}" Click="ExcelYukle_Click" Margin="0,0,6,0" Padding="10,8" Content="Excel Yükle" />
          <Button Style="{StaticResource ToolbarButtonStyle}" Click="SablonIndir_Click" Margin="0,0,6,0" Padding="10,8" Content="Şablon" />
          <Button Style="{StaticResource ToolbarButtonStyle}" Click="PdfIndir_Click" Margin="0,0,6,0" Padding="10,8" Content="PDF" />
          <Button Style="{StaticResource ToolbarButtonStyle}" Click="PdfYazdir_Click" Margin="0,0,6,0" Padding="10,8" Content="Yazdır" />
          <Button Style="{StaticResource ToolbarButtonStyle}" Click="DisaAktar_Click" Margin="0,0,6,0" Padding="10,8" Content="Dışa Aktar" />
          <Button Style="{StaticResource ErpIconBtn}" Click="Yenile_Click" ToolTip="Yenile">
            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#102A43" />
          </Button>
        </WrapPanel>
      </Grid>
    </Border>

    <!-- Yatay filtre şeridi -->
    <Border x:Name="FiltreBaslikKart" Grid.Row="1" Background="#FFFFFF" CornerRadius="14"
            BorderBrush="#D9E2EC" BorderThickness="1" Padding="16,12" Margin="0,0,0,12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel LastChildFill="False">
          <TextBlock Text="Filtreler" FontSize="13" FontWeight="SemiBold" Foreground="#102A43"
                     VerticalAlignment="Center" DockPanel.Dock="Left" />
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
            <Button Style="{StaticResource PrimaryToolbarButtonStyle}" Content="Uygula" Click="FiltreYenile_Click"
                    Margin="0,0,8,0" Padding="14,7" />
            <Button Style="{StaticResource ToolbarButtonStyle}" Content="Temizle" Click="FiltreleriTemizle_Click"
                    Margin="0" Padding="14,7" />
          </StackPanel>
        </DockPanel>
        <WrapPanel Grid.Row="1" Margin="0,12,0,0">
          <StackPanel Width="220" Margin="0,0,12,8">
            <TextBlock Text="Arama" Style="{StaticResource SapFilterLabel}" />
            <TextBox x:Name="TxtArama" Style="{StaticResource FilterBoxStyle}" Height="34"
                     TextChanged="FiltreDegisti"
                     ui:ControlHelper.PlaceholderText="Fatura, tedarikçi, malzeme..." />
          </StackPanel>
          <StackPanel Width="140" Margin="0,0,12,8">
            <TextBlock Text="Başlangıç" Style="{StaticResource SapFilterLabel}" />
            <DatePicker x:Name="DpBaslangic" Height="34" SelectedDateChanged="FiltreDegisti" />
          </StackPanel>
          <StackPanel Width="140" Margin="0,0,12,8">
            <TextBlock Text="Bitiş" Style="{StaticResource SapFilterLabel}" />
            <DatePicker x:Name="DpBitis" Height="34" SelectedDateChanged="FiltreDegisti" />
          </StackPanel>
          <StackPanel Width="180" Margin="0,0,12,8">
            <TextBlock Text="Malzeme" Style="{StaticResource SapFilterLabel}" />
            <Border BorderBrush="#D9E2EC" BorderThickness="1" Background="#FFFFFF" MinHeight="34" CornerRadius="8">
              <controls:MalzemeOneriGiris x:Name="MalzemeFiltre" />
            </Border>
          </StackPanel>
          <StackPanel Width="160" Margin="0,0,12,8">
            <TextBlock Text="Tedarikçi" Style="{StaticResource SapFilterLabel}" />
            <ComboBox x:Name="CmbTedarikci" Style="{StaticResource FilterComboStyle}" Height="34" SelectionChanged="FiltreDegisti" />
          </StackPanel>
          <StackPanel Width="140" Margin="0,0,12,8">
            <TextBlock Text="Kategori" Style="{StaticResource SapFilterLabel}" />
            <ComboBox x:Name="CmbKategori" Style="{StaticResource FilterComboStyle}" Height="34" SelectionChanged="FiltreDegisti" />
          </StackPanel>
          <StackPanel Width="140" Margin="0,0,12,8">
            <TextBlock Text="Şantiye" Style="{StaticResource SapFilterLabel}" />
            <ComboBox x:Name="CmbSantiye" Style="{StaticResource FilterComboStyle}" Height="34" SelectionChanged="FiltreDegisti" />
          </StackPanel>
          <StackPanel Width="140" Margin="0,0,0,8">
            <TextBlock Text="Teslim Alan" Style="{StaticResource SapFilterLabel}" />
            <ComboBox x:Name="CmbTeslimAlan" Style="{StaticResource FilterComboStyle}" Height="34" SelectionChanged="FiltreDegisti" />
          </StackPanel>
        </WrapPanel>
        <Button x:Name="BtnFiltreToggle" Visibility="Collapsed" Click="FiltreToggle_Click" Content="▼" />
        <Border x:Name="FilterIcerik" Visibility="Collapsed" />
      </Grid>
    </Border>

    <Border x:Name="TabloKart" Grid.Row="2" Background="#FFFFFF" CornerRadius="16"
            BorderBrush="#D9E2EC" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F0F4F8" BorderBrush="#D9E2EC" BorderThickness="0,0,0,1"
                CornerRadius="16,16,0,0" Padding="16,10">
          <Grid>
            <TextBlock x:Name="TxtTabloBaslik" Text="Malzeme Listesi" FontSize="13" FontWeight="SemiBold"
                       Foreground="#102A43" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Style="{StaticResource ErpTableToolbarBtn}" Content="Kolonlar" Click="Kolonlar_Click" />
              <Button Style="{StaticResource ErpTableToolbarBtn}" Content="Grupla" Click="Grupla_Click" />
              <Button Style="{StaticResource ErpTableToolbarBtn}" Content="Filtre" Click="FiltreOdak_Click" />
              <Button Style="{StaticResource ErpTableToolbarBtn}" Content="Excel" Click="DisaAktar_Click" />
              <Button Style="{StaticResource ErpTableToolbarBtn}" Content="PDF" Click="PdfIndir_Click" />
              <Button Style="{StaticResource ErpTableToolbarBtn}" Content="Yazdır" Click="PdfYazdir_Click" />
              <Button Style="{StaticResource ErpTableToolbarBtn}" Content="Yoğun" Click="YogunGorunum_Click" />
              <Button x:Name="BtnTamEkran" Style="{StaticResource ErpTableToolbarBtn}" Content="Tam Ekran" Click="TamEkran_Click" />
            </StackPanel>
          </Grid>
        </Border>

        <DataGrid x:Name="MalzemeGrid" Grid.Row="1"
                  Style="{StaticResource ErpPremiumGrid}"
                  BorderThickness="0"
                  CanUserReorderColumns="True"
                  LoadingRow="MalzemeGrid_LoadingRow"
                  SelectionChanged="MalzemeGrid_SelectionChanged"
                  MouseDoubleClick="MalzemeGrid_MouseDoubleClick"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Tarih" Binding="{Binding Tarih}" Width="95" />
            <DataGridTextColumn Header="İrsaliye No" Binding="{Binding FaturaNo}" Width="105" />
            <DataGridTextColumn Header="Sipariş No" Binding="{Binding SiparisNoGoster}" Width="100" />
            <DataGridTextColumn Header="Malzeme" Binding="{Binding MalzemeHizmet}" Width="160" />
            <DataGridTextColumn Header="Kategori" Binding="{Binding Kategori}" Width="100" />
            <DataGridTextColumn Header="Miktar" Binding="{Binding Miktar, StringFormat=N2}" Width="80" />
            <DataGridTextColumn Header="Birim" Binding="{Binding Birim}" Width="60" />
            <DataGridTextColumn Header="Para" Binding="{Binding ParaBirimi}" Width="60" />
            <DataGridTextColumn Header="Birim Fiyat" Binding="{Binding BirimFiyatiMetin}" Width="140" />
            <DataGridTextColumn Header="% Artış" Binding="{Binding ArtisYuzdesiMetin}" Width="75" />
            <DataGridTextColumn Header="Toplam (₺)" Binding="{Binding ToplamTutar, StringFormat='₺{0:N2}'}" Width="110" />
            <DataGridTextColumn Header="Tedarikçi" Binding="{Binding Tedarikci}" Width="120" />
            <DataGridTextColumn Header="Şantiye" Binding="{Binding IndirildigiSaha}" Width="110" />
            <DataGridTextColumn Header="Teslim Alan" Binding="{Binding TeslimAlan}" Width="100" />
            <DataGridTextColumn Header="Açıklama" Binding="{Binding Aciklama}" Width="*" MinWidth="120" />
            <DataGridTemplateColumn Header="" Width="48" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource ErpIconBtn}" Tag="{Binding}" Click="SatirMenu_Click" ToolTip="İşlemler">
                    <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#102A43" />
                  </Button>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Style="{StaticResource ErpFooterBar}" CornerRadius="0,0,16,16">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource ErpFooterText}" Text="Toplam Kayıt:" />
                <TextBlock x:Name="TxtAltKayit" Style="{StaticResource ErpFooterValue}" Text="0" />
                <TextBlock Style="{StaticResource ErpFooterText}" Text="Toplam Miktar:" />
                <TextBlock x:Name="TxtAltMiktar" Style="{StaticResource ErpFooterValue}" Text="0" />
                <TextBlock Style="{StaticResource ErpFooterText}" Text="Toplam Tutar:" />
                <TextBlock x:Name="TxtAltTutar" Style="{StaticResource ErpFooterValue}" Text="₺0" />
                <TextBlock x:Name="TxtGrupBilgi" Style="{StaticResource ErpFooterText}" Margin="12,0,0,0" Visibility="Collapsed" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Sayfa boyutu:" Style="{StaticResource ErpFooterText}" Margin="0,0,8,0" />
                <ComboBox x:Name="CmbSayfaBoyutu" Width="72" Height="28" VerticalContentAlignment="Center"
                          SelectionChanged="SayfaBoyutuDegisti">
                  <ComboBoxItem Content="25" Tag="25" />
                  <ComboBoxItem Content="50" Tag="50" IsSelected="True" />
                  <ComboBoxItem Content="100" Tag="100" />
                  <ComboBoxItem Content="200" Tag="200" />
                </ComboBox>
              </StackPanel>
            </Grid>
            <controls:SayfalamaCubugu x:Name="SayfalamaBar" Grid.Row="1" Margin="0,8,0,0" />
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
