<UserControl x:Class="SatinalmaPro.Views.Modules.RaporlamalarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:helpers="clr-namespace:SatinalmaPro.Helpers"
             Background="#EEF2F5">
  <Grid Margin="20,12,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="320" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="16" BorderBrush="#D9E2EC" BorderThickness="1"
            Padding="22,16" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="RAPORLAR" FontSize="11" FontWeight="Bold" Foreground="#0D7377" />
          <TextBlock Text="Raporlamalar" FontSize="22" FontWeight="SemiBold" Foreground="#102A43" Margin="0,4,0,0" />
        </StackPanel>
        <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
          <Button Style="{StaticResource PrimaryToolbarButtonStyle}" Click="PdfIndir_Click" Margin="0,0,6,0" Padding="12,8" Content="PDF İndir" />
          <Button Style="{StaticResource ToolbarButtonStyle}" Click="PdfYazdir_Click" Margin="0,0,6,0" Padding="10,8" Content="Yazdır" />
          <Button Style="{StaticResource ToolbarButtonStyle}" Click="ExcelAktar_Click" Margin="0,0,6,0" Padding="10,8" Content="Excel" />
          <Button Style="{StaticResource ErpIconBtn}" Click="Yenile_Click" ToolTip="Yenile">
            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#102A43" />
          </Button>
        </WrapPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="14" BorderBrush="#D9E2EC" BorderThickness="1"
            Padding="16,12" Margin="0,0,0,12">
      <StackPanel>
        <DockPanel LastChildFill="False" Margin="0,0,0,12">
          <TextBlock Text="Filtreler" FontSize="13" FontWeight="SemiBold" Foreground="#102A43"
                     VerticalAlignment="Center" DockPanel.Dock="Left" />
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
            <Button Style="{StaticResource ToolbarButtonStyle}" Content="Filtreleri Temizle"
                    Margin="0,0,8,0" Click="FiltreleriTemizle_Click" Padding="14,7" />
            <Button Style="{StaticResource PrimaryToolbarButtonStyle}" Click="PdfIndir_Click" Padding="14,7">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" />
                <TextBlock Text="Filtreli PDF" />
              </StackPanel>
            </Button>
          </StackPanel>
        </DockPanel>
        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
          <StackPanel Width="140" Margin="0,0,12,8">
            <TextBlock Text="Başlangıç" Style="{StaticResource SapFilterLabel}" />
            <DatePicker x:Name="DpBaslangic" Height="32" SelectedDateChanged="FiltreDegisti" />
          </StackPanel>
          <StackPanel Width="140" Margin="0,0,12,8">
            <TextBlock Text="Bitiş" Style="{StaticResource SapFilterLabel}" />
            <DatePicker x:Name="DpBitis" Height="32" SelectedDateChanged="FiltreDegisti" />
          </StackPanel>
          <StackPanel Width="180" Margin="0,0,12,8">
            <TextBlock Text="Rapor Türü" Style="{StaticResource SapFilterLabel}" />
            <ComboBox x:Name="CmbRaporTuru" Style="{StaticResource FilterComboStyle}"
                      Height="32" SelectionChanged="FiltreDegisti" />
          </StackPanel>
          <StackPanel Width="160" Margin="0,0,12,8">
            <TextBlock Text="Modül" Style="{StaticResource SapFilterLabel}" />
            <ComboBox x:Name="CmbModul" Style="{StaticResource FilterComboStyle}"
                      Height="32" SelectionChanged="FiltreDegisti" />
          </StackPanel>
          <StackPanel Width="160" Margin="0,0,12,8">
            <TextBlock Text="Kategori" Style="{StaticResource SapFilterLabel}" />
            <Button x:Name="BtnKategoriSec" Style="{StaticResource ToolbarButtonStyle}"
                    Height="32" Click="KategoriSec_Click" Padding="12,6">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" />
                <TextBlock x:Name="TxtKategoriSecim" Text="Tümü" />
              </StackPanel>
            </Button>
          </StackPanel>
          <StackPanel Width="180" Margin="0,0,0,8">
            <TextBlock Text="Malzeme / Hizmet" Style="{StaticResource SapFilterLabel}" />
            <Button x:Name="BtnMalzemeSec" Style="{StaticResource ToolbarButtonStyle}"
                    Height="32" Click="MalzemeSec_Click" Padding="12,6">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" />
                <TextBlock x:Name="TxtMalzemeSecim" Text="Tümü" />
              </StackPanel>
            </Button>
          </StackPanel>
        </WrapPanel>
        <TextBlock Text="Kategori veya malzeme seçip PDF İndir / Filtreli PDF deyin. Rapor türü Genel Özet olsa bile PDF'nin 1. sayfasında «Seçilen Kategoriler — Aylık Maliyet» tablosu çıkar."
                   FontSize="11" Foreground="#627D98" TextWrapping="Wrap" Margin="0,4,0,0" />
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="16" BorderBrush="#D9E2EC" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F0F4F8" BorderBrush="#D9E2EC" BorderThickness="0,0,0,1"
                CornerRadius="16,16,0,0" Padding="16,10">
          <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                         Foreground="#0D7377" Margin="0,0,10,0" VerticalAlignment="Center" />
              <TextBlock x:Name="TxtRaporBaslik" Text="Genel Özet" FontSize="13" FontWeight="SemiBold"
                         Foreground="#102A43" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <TextBlock x:Name="TxtKayitSayisi" Text="0 kayıt" FontSize="12"
                         Foreground="#627D98" Margin="0,0,16,0" VerticalAlignment="Center" />
              <TextBlock x:Name="TxtRaporToplam" Text="₺0" FontSize="15" FontWeight="SemiBold"
                         Foreground="#102A43" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Row="1" BorderBrush="#D9E2EC" BorderThickness="0,0,0,1" Padding="16,10" MaxHeight="120">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Modül Özeti" FontSize="12" FontWeight="SemiBold" Foreground="#102A43" Margin="0,0,0,8" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="ModulOzetPanel" Orientation="Vertical" />
            </ScrollViewer>
          </Grid>
        </Border>

        <TabControl x:Name="RaporTab" Grid.Row="2" Padding="0" BorderThickness="0" Visibility="Collapsed"
                    Style="{StaticResource ModuleTabControlStyle}"
                    ItemContainerStyle="{StaticResource ModuleTabItemStyle}">
          <TabItem Header="Modül Özeti" x:Name="TabModulOzet">
            <DataGrid x:Name="ModulOzetGrid" Style="{StaticResource ModuleDataGridStyle}"
                      BorderThickness="0" AlternatingRowBackground="Transparent" IsReadOnly="True"
                      AutoGenerateColumns="False" ScrollViewer.HorizontalScrollBarVisibility="Auto">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Modül" Binding="{Binding ModulAdi}" Width="*" MinWidth="160" />
                <DataGridTextColumn Header="Kayıt" Binding="{Binding KayitSayisi}" Width="80" />
                <DataGridTextColumn Header="Toplam Tutar" Binding="{Binding ToplamTutar, StringFormat='₺{0:N2}'}" Width="130" />
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
          <TabItem Header="Grup Özeti" x:Name="TabGrupOzet">
            <DataGrid x:Name="GrupOzetGrid" Style="{StaticResource ModuleDataGridStyle}"
                      BorderThickness="0" AlternatingRowBackground="Transparent" IsReadOnly="True"
                      AutoGenerateColumns="False" ScrollViewer.HorizontalScrollBarVisibility="Auto">
              <DataGrid.Columns>
                <DataGridTextColumn x:Name="ColGrupAdi" Header="Grup" Binding="{Binding GrupAdi}" Width="*" MinWidth="140" />
                <DataGridTextColumn Header="Kayıt" Binding="{Binding KayitSayisi}" Width="80" />
                <DataGridTextColumn Header="Toplam Tutar" Binding="{Binding ToplamTutar, StringFormat='₺{0:N2}'}" Width="130" />
                <DataGridTextColumn Header="Modül Dağılımı" Binding="{Binding ModulDagilimi}" Width="*" MinWidth="180" />
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
          <TabItem Header="Detay" x:Name="TabDetay">
            <DataGrid x:Name="DetayGrid" Style="{StaticResource ModuleDataGridStyle}"
                      BorderThickness="0" AlternatingRowBackground="Transparent" IsReadOnly="True"
                      AutoGenerateColumns="False" ScrollViewer.HorizontalScrollBarVisibility="Auto">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Modül" Binding="{Binding Modul}" Width="110" />
                <DataGridTextColumn Header="Tarih" Binding="{Binding Tarih}" Width="85" />
                <DataGridTextColumn Header="Belge No" Binding="{Binding BelgeNo}" Width="95" />
                <DataGridTextColumn Header="Kategori" Binding="{Binding Kategori}" Width="95" />
                <DataGridTextColumn Header="Malzeme / Hizmet" Binding="{Binding Aciklama}" Width="*" MinWidth="140" />
                <DataGridTextColumn Header="Miktar" Binding="{Binding Miktar, StringFormat=N2}" Width="70" />
                <DataGridTextColumn Header="Birim" Binding="{Binding Birim}" Width="55" />
                <DataGridTextColumn Header="B.Fiyat" Binding="{Binding BirimFiyati, StringFormat='₺{0:N2}'}" Width="80" />
                <DataGridTextColumn Header="Artış" Binding="{Binding ArtisYuzdesiMetin}" Width="65" />
                <DataGridTextColumn Header="Tedarikçi" Binding="{Binding Tedarikci}" Width="110" />
                <DataGridTextColumn Header="Saha" Binding="{Binding Saha}" Width="100" />
                <DataGridTextColumn Header="Tutar" Binding="{Binding Tutar, StringFormat='₺{0:N2}'}" Width="95" />
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
        </TabControl>

        <DataGrid x:Name="AnaGrid" Grid.Row="2" Style="{StaticResource ModuleDataGridStyle}"
                  BorderThickness="0" AlternatingRowBackground="Transparent" IsReadOnly="True"
                  AutoGenerateColumns="False" ScrollViewer.HorizontalScrollBarVisibility="Auto">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Modül" Binding="{Binding ModulAdi}" Width="*" MinWidth="160" />
            <DataGridTextColumn Header="Kayıt" Binding="{Binding KayitSayisi}" Width="80" />
            <DataGridTextColumn Header="Toplam Tutar" Binding="{Binding ToplamTutar, StringFormat='₺{0:N2}'}" Width="130" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
