<UserControl x:Class="SatinalmaPro.Views.Modules.Satinalma.Part1.MalKabulTalepListesiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9">
  <Grid Margin="20,12,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="16" BorderBrush="#E2E8F0"
            BorderThickness="1" Padding="22,16" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="TALEP PRO" FontSize="11" FontWeight="Bold" Foreground="#4F46E5" />
        <TextBlock Text="Mal Kabul" FontSize="22" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,4,0,0" />
        <TextBlock x:Name="TxtYardim" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,6,0,0" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1">
      <Grid>
        <DataGrid x:Name="Tablo" Style="{StaticResource SatModDataGrid}" BorderThickness="0"
                  MouseDoubleClick="Tablo_MouseDoubleClick">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Talep No" Binding="{Binding TalepNo}" Width="100" />
            <DataGridTextColumn Header="Sipariş No" Binding="{Binding SiparisNo}" Width="110" />
            <DataGridTextColumn Header="Tarih" Binding="{Binding Tarih}" Width="90" />
            <DataGridTextColumn Header="Talep Eden" Binding="{Binding TalepEden}" Width="130" />
            <DataGridTextColumn Header="Firma" Binding="{Binding FirmaOzet}" Width="*" />
            <DataGridTextColumn Header="Mal Kabul" Binding="{Binding MalKabulOzeti}" Width="110" />
          </DataGrid.Columns>
        </DataGrid>

        <Border x:Name="BosPanel" Background="#FFFFFF" CornerRadius="14" Padding="32,28" Visibility="Collapsed">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
            <TextBlock Text="Henüz tamamlanmış mal kabul kaydı yok"
                       FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" TextAlignment="Center" />
            <TextBlock Text="Mal kabul işlemi «Siparişler» sekmesinde yapılır. Malzeme geldikçe kabul edin; tüm kalemler bitince talep burada listelenir."
                       FontSize="13" Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" />
            <Button x:Name="BtnSiparislereGit" Content="Siparişler — Mal Kabul Yap"
                    Style="{StaticResource PrimaryToolbarButtonStyle}"
                    HorizontalAlignment="Center" Margin="0,20,0,0" Padding="20,10"
                    Click="SiparislereGit_Click" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
