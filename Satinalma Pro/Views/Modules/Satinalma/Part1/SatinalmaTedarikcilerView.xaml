<UserControl x:Class="SatinalmaPro.Views.Modules.Satinalma.Part1.SatinalmaTedarikcilerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             Background="#F1F5F9">
  <Grid Margin="20,12,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="16" BorderBrush="#E2E8F0"
            BorderThickness="1" Padding="22,16" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="TALEP PRO" FontSize="11" FontWeight="Bold" Foreground="#4F46E5" />
        <TextBlock Text="Tedarikçiler" FontSize="22" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,4,0,0" />
        <TextBlock Text="Firma performansını ve teslimat metriklerini izleyin."
                   FontSize="12" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <UniformGrid x:Name="KpiPanel" Grid.Row="1" Rows="1" Columns="4" Margin="0,0,0,12" />

    <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="14" BorderBrush="#E2E8F0"
            BorderThickness="1" Padding="16">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" MinHeight="320" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
          <TextBlock Text="Tedarikçi Performans" FontSize="14" FontWeight="SemiBold"
                     Foreground="#0F172A" VerticalAlignment="Center" />
          <Grid Width="240" HorizontalAlignment="Right">
            <TextBox x:Name="TxtArama" Style="{StaticResource FilterBoxStyle}" Height="36"
                     TextChanged="AramaDegisti"
                     ui:ControlHelper.PlaceholderText="Firma ara..." />
            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                       Foreground="#64748B" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False" />
          </Grid>
        </Grid>

        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
          <DataGrid x:Name="TedarikciGrid" Style="{StaticResource SatModPanosuGrid}"
                    CanUserSortColumns="True" CanUserResizeColumns="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Firma" Binding="{Binding Firma}" Width="*" MinWidth="160" />
              <DataGridTextColumn Header="Sipariş" Binding="{Binding ToplamSiparis}" Width="72" />
              <DataGridTextColumn Header="Toplam Tutar" Binding="{Binding ToplamTutar, StringFormat=N0}" Width="110" />
              <DataGridTextColumn Header="Zamanında" Binding="{Binding ZamanindaTeslim}" Width="88" />
              <DataGridTextColumn Header="Eksik" Binding="{Binding EksikTeslim}" Width="68" />
              <DataGridTextColumn Header="İade" Binding="{Binding Iade}" Width="58" />
              <DataGridTextColumn Header="Kalite" Binding="{Binding Kalite}" Width="68" />
              <DataGridTextColumn Header="Ort. Teslim" Binding="{Binding OrtTeslimSuresi}" Width="90" />
              <DataGridTemplateColumn Header="Performans" Width="100">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Center">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="#E0FCFF" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding PerformansPuani}" Value="0">
                              <Setter Property="Background" Value="#F0F4F8" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding PerformansPuani}" FontSize="11" FontWeight="SemiBold"
                                 Foreground="#4F46E5" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
