<UserControl x:Class="SatinalmaPro.Views.Modules.Satinalma.Part1.OnaylananTalepListesiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             Background="#F1F5F9">
  <Grid Margin="20,12,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="16" BorderBrush="#E2E8F0"
            BorderThickness="1" Padding="22,16" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="TALEP PRO" FontSize="11" FontWeight="Bold" Foreground="#4F46E5" />
        <TextBlock Text="Onaylanan Talepler" FontSize="22" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,4,0,0" />
        <TextBlock x:Name="TxtYardim" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,6,0,0" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="14" BorderBrush="#E2E8F0"
            BorderThickness="1" Padding="16,12" Margin="0,0,0,12">
      <Grid>
        <Grid Width="280" HorizontalAlignment="Left">
          <TextBox x:Name="TxtArama" Style="{StaticResource FilterBoxStyle}" Height="34"
                   TextChanged="AramaDegisti"
                   ui:ControlHelper.PlaceholderText="Talep no, onaylayan, firma..." />
          <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                     Foreground="#64748B" HorizontalAlignment="Right"
                     VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False" />
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Onay Belgesi PDF" Style="{StaticResource ToolbarButtonStyle}"
                  Click="OnayPdf_Click" Padding="12,7" Margin="0,0,6,0" />
          <Button Content="Karşılaştırma PDF" Style="{StaticResource ToolbarButtonStyle}"
                  Click="KarsilastirmaPdf_Click" Padding="12,7" Margin="0" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1">
      <DataGrid x:Name="Tablo" Style="{StaticResource SatModDataGrid}"
                BorderThickness="0" MouseDoubleClick="Tablo_MouseDoubleClick">
        <DataGrid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Onay Belgesi PDF" Click="OnayPdf_Click" />
            <MenuItem Header="Karşılaştırma PDF" Click="KarsilastirmaPdf_Click" />
            <Separator />
            <MenuItem x:Name="BtnSiparis" Header="Siparişlendir" Click="Siparislendir_Click" />
          </ContextMenu>
        </DataGrid.ContextMenu>
        <DataGrid.Columns>
          <DataGridTextColumn Header="Talep No" Binding="{Binding TalepNo}" Width="100" />
          <DataGridTextColumn Header="Onay Türü" Binding="{Binding OnayTuruMetni}" Width="90" />
          <DataGridTextColumn Header="Onay Tarihi" Binding="{Binding OnayTarihi}" Width="120" />
          <DataGridTextColumn Header="Talep Tarihi" Binding="{Binding Tarih}" Width="95" />
          <DataGridTextColumn Header="Talep Eden" Binding="{Binding TalepEden}" Width="115" />
          <DataGridTextColumn Header="Onaylayan" Binding="{Binding OnaylayanOzet}" Width="150" />
          <DataGridTextColumn Header="Onaylı Firma" Binding="{Binding OnayliFirmaOzet}" Width="*" MinWidth="120" />
          <DataGridTextColumn Header="Durum" Binding="{Binding DurumEtiketi}" Width="140" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </Grid>
</UserControl>
