<UserControl x:Class="SatinalmaPro.Views.Modules.Satinalma.Part1.SiparisVerilenTalepDetayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#EEF2F5">
  <Grid Margin="20,12,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="16" BorderBrush="#D9E2EC"
            BorderThickness="1" Padding="22,16" Margin="0,0,0,12">
      <StackPanel>
        <Button Style="{StaticResource SatModBackButton}" Click="Geri_Click" Content="← Listeye dön"
                Margin="0,0,0,10" Padding="10,6" />
        <TextBlock x:Name="TxtBaslik" FontSize="20" FontWeight="SemiBold" Foreground="#102A43" />
        <TextBlock x:Name="TxtOzet" FontSize="12" Foreground="#627D98" Margin="0,4,0,0" TextWrapping="Wrap" />
        <Border Margin="0,12,0,0" Background="#E0FCFF" BorderBrush="#0D7377" BorderThickness="1"
                CornerRadius="10" Padding="12,10">
          <TextBlock x:Name="TxtDurum" FontSize="12" Foreground="#0D7377" TextWrapping="Wrap" />
        </Border>
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="14" BorderBrush="#D9E2EC" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Padding="16,12" BorderBrush="#D9E2EC" BorderThickness="0,0,0,1" Background="#F0F4F8">
          <TextBlock Text="Sipariş kalemleri" FontSize="13" FontWeight="SemiBold" Foreground="#102A43" />
        </Border>
        <DataGrid x:Name="KalemTablosu" Grid.Row="1" Style="{StaticResource SatModDataGrid}" BorderThickness="0"
                  SelectionChanged="KalemTablosu_SelectionChanged"
                  MouseDoubleClick="KalemTablosu_MouseDoubleClick">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Malzeme" Binding="{Binding Malzeme}" Width="*" />
            <DataGridTextColumn Header="Sipariş" Binding="{Binding SiparisMiktariMetni}" Width="90" />
            <DataGridTextColumn Header="Kabul" Binding="{Binding KabulMiktarMetni}" Width="90" />
            <DataGridTextColumn Header="Kalan" Binding="{Binding KalanMiktarMetni}" Width="90" />
            <DataGridTextColumn Header="Firma" Binding="{Binding Firma}" Width="*" />
            <DataGridTextColumn Header="Durum" Binding="{Binding KabulDurumu}" Width="100" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>

    <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="14" BorderBrush="#D9E2EC"
            BorderThickness="1" Padding="16,12" Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="BtnSevkiyatiTamamla" Content="Sevkiyatı Tamamla" Style="{StaticResource ToolbarButtonStyle}"
                Click="SevkiyatiTamamla_Click" Padding="18,8" Margin="0,0,8,0" IsEnabled="False" />
        <Button x:Name="BtnTopluMalKabul" Content="Teklifin Tüm Kalemlerini Kabul Et" Style="{StaticResource ToolbarButtonStyle}"
                Click="TopluMalKabul_Click" Padding="18,8" Margin="0,0,8,0" IsEnabled="False" />
        <Button x:Name="BtnMalKabul" Content="Mal Kabul — Depoya Kaydet" Style="{StaticResource PrimaryToolbarButtonStyle}"
                Click="MalKabul_Click" Padding="18,8" IsEnabled="False" Margin="0" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
