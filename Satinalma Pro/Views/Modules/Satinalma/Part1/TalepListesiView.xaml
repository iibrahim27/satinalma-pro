<UserControl x:Class="SatinalmaPro.Views.Modules.Satinalma.Part1.TalepListesiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9">
  <Grid Margin="20,12,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="16" BorderBrush="#E2E8F0"
            BorderThickness="1" Padding="22,16" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="TALEP PRO" FontSize="11" FontWeight="Bold" Foreground="#4F46E5" />
        <TextBlock Text="Talepler" FontSize="22" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,4,0,0" />
        <TextBlock x:Name="TxtYardim" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,6,0,0" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1">
      <DataGrid x:Name="Tablo" Style="{StaticResource SatModDataGrid}"
                BorderThickness="0" MouseDoubleClick="Tablo_MouseDoubleClick">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Talep No" Binding="{Binding TalepNo}" Width="110" />
          <DataGridTextColumn Header="Tarih" Binding="{Binding Tarih}" Width="90" />
          <DataGridTextColumn Header="Talep Eden" Binding="{Binding TalepEden}" Width="140" />
          <DataGridTextColumn Header="Öncelik" Binding="{Binding Oncelik}" Width="90" />
          <DataGridTextColumn Header="Talep Durumu" Binding="{Binding TalepDurumu}" Width="*" />
          <DataGridTextColumn Header="Teklif Durumu" Binding="{Binding TeklifDurumu}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </Grid>
</UserControl>
