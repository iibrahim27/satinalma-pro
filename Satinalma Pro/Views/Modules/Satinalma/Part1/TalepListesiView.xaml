<UserControl x:Class="SatinalmaPro.Views.Modules.Satinalma.Part1.TalepListesiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             FontFamily="Segoe UI">
  <UserControl.Resources>
    <Style x:Key="BadgeText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ColHeader" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#10233F" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ColCell" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="#10233F" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </UserControl.Resources>

  <Grid Margin="4,0,4,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <UniformGrid x:Name="OzetKartlar" Grid.Row="0" Columns="4" Margin="0,0,0,14" Visibility="Collapsed">
      <Border Background="White" BorderBrush="#DDE4EC" BorderThickness="1" CornerRadius="12"
              Padding="16,14" Margin="0,0,12,0">
        <DockPanel>
          <Border Width="42" Height="42" CornerRadius="21" Background="#DBEAFE" DockPanel.Dock="Left" Margin="0,0,12,0">
            <TextBlock Text="&#xE121;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#246FE5"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Onay Bekleyen" FontSize="12" Foreground="#607089" />
            <TextBlock x:Name="TxtKpiOnay" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="#10233F" Margin="0,2,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Background="White" BorderBrush="#DDE4EC" BorderThickness="1" CornerRadius="12"
              Padding="16,14" Margin="0,0,12,0"
              ToolTip="Bugün tarihli/güncellenen talepler (sonlanma tarihi yok)">
        <DockPanel>
          <Border Width="42" Height="42" CornerRadius="21" Background="#FFEDD5" DockPanel.Dock="Left" Margin="0,0,12,0">
            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#F28C28"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Bugün Gelen" FontSize="12" Foreground="#607089" />
            <TextBlock x:Name="TxtKpiBugun" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="#10233F" Margin="0,2,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Background="White" BorderBrush="#DDE4EC" BorderThickness="1" CornerRadius="12"
              Padding="16,14" Margin="0,0,12,0">
        <DockPanel>
          <Border Width="42" Height="42" CornerRadius="21" Background="#EDE9FE" DockPanel.Dock="Left" Margin="0,0,12,0">
            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#7447D8"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Revize Bekleyen" FontSize="12" Foreground="#607089" />
            <TextBlock x:Name="TxtKpiRevize" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="#10233F" Margin="0,2,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Background="White" BorderBrush="#DDE4EC" BorderThickness="1" CornerRadius="12" Padding="16,14">
        <DockPanel>
          <Border Width="42" Height="42" CornerRadius="21" Background="#DCFCE7" DockPanel.Dock="Left" Margin="0,0,12,0">
            <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#24964A"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Toplam Tutar" FontSize="12" Foreground="#607089" />
            <TextBlock x:Name="TxtKpiTutar" Text="—" FontSize="20" FontWeight="SemiBold" Foreground="#10233F" Margin="0,2,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>
    </UniformGrid>

    <Border Grid.Row="1" Background="White" BorderBrush="#DDE4EC" BorderThickness="1" CornerRadius="12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,16,20,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock x:Name="TxtListeBaslik" Text="Talepler" FontSize="16" FontWeight="SemiBold" Foreground="#10233F" />
              <TextBlock x:Name="TxtYardim" FontSize="12" Foreground="#607089" TextWrapping="Wrap" Margin="0,4,0,12" />
              <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnFiltreTumu" Style="{DynamicResource TabButton}" Content="Tümü" Click="FiltreTab_Click" />
                <Button x:Name="BtnFiltreAcil" Style="{DynamicResource TabButton}" Content="Acil" Click="FiltreTab_Click" />
                <Button x:Name="BtnFiltreHafta" Style="{DynamicResource TabButton}" Content="Bu Hafta" Click="FiltreTab_Click" />
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
              <Grid Width="280" Margin="0,0,8,0">
                <TextBox x:Name="TxtArama" Style="{DynamicResource SearchBox}" Padding="34,9,12,9"
                         BorderBrush="#DDE4EC" TextChanged="TxtArama_TextChanged" />
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#607089"
                           Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                <TextBlock x:Name="TxtAramaPlaceholder" Text="Talep no, kişi veya tedarikçi ara..."
                           Foreground="#94A3B8" FontSize="12" Margin="34,0,12,0"
                           VerticalAlignment="Center" IsHitTestVisible="False" />
              </Grid>
              <Button Style="{DynamicResource SecondaryButton}" Click="BtnFiltre_Click" Padding="12,8">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                  <TextBlock Text="Filtreler" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Kolon başlıkları -->
        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#DDE4EC" BorderThickness="0,1,0,1" Padding="16,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="36" />
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="100" />
              <ColumnDefinition Width="140" />
              <ColumnDefinition Width="100" />
              <ColumnDefinition Width="1.1*" />
              <ColumnDefinition Width="1.2*" />
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Style="{StaticResource ColHeader}" Text="Talep No" />
            <TextBlock Grid.Column="2" Style="{StaticResource ColHeader}" Text="Talep Tarihi" />
            <TextBlock Grid.Column="3" Style="{StaticResource ColHeader}" Text="Talep Eden" />
            <TextBlock Grid.Column="4" Style="{StaticResource ColHeader}" Text="Öncelik" />
            <TextBlock Grid.Column="5" Style="{StaticResource ColHeader}" Text="Talep Durumu" />
            <TextBlock Grid.Column="6" Style="{StaticResource ColHeader}" Text="Teklif Durumu" />
            <TextBlock Grid.Column="7" Style="{StaticResource ColHeader}" Text="Son İşlem" />
          </Grid>
        </Border>

        <ListBox x:Name="Tablo" Grid.Row="2" BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 MouseDoubleClick="Tablo_MouseDoubleClick"
                 SelectionChanged="Tablo_SelectionChanged">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="{Binding SatirArka}"
                            BorderBrush="#DDE4EC" BorderThickness="0,0,0,1">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="#F3F6F9" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <Grid MinHeight="48" Margin="16,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="36" />
                  </Grid.ColumnDefinitions>
                  <CheckBox VerticalAlignment="Center" IsHitTestVisible="False" Focusable="False" />
                  <TextBlock Grid.Column="1" Style="{StaticResource ColCell}" Text="{Binding TalepNo}" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="2" Style="{StaticResource ColCell}" Text="{Binding Tarih}" />
                  <TextBlock Grid.Column="3" Style="{StaticResource ColCell}" Text="{Binding TalepEden}" ToolTip="{Binding TalepEden}" />
                  <Border Grid.Column="4" Style="{DynamicResource StatusBadge}" Background="{Binding OncelikArka}"
                          BorderBrush="{Binding OncelikKenar}" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="{Binding Oncelik}" Style="{StaticResource BadgeText}" Foreground="{Binding OncelikYazi}" />
                  </Border>
                  <Border Grid.Column="5" Style="{DynamicResource StatusBadge}" Background="{Binding TalepDurumArka}"
                          BorderBrush="{Binding TalepDurumKenar}" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="{Binding TalepDurumu}" Style="{StaticResource BadgeText}" Foreground="{Binding TalepDurumYazi}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding TalepDurumu}" />
                  </Border>
                  <Border Grid.Column="6" Style="{DynamicResource StatusBadge}" Background="{Binding TeklifDurumArka}"
                          BorderBrush="{Binding TeklifDurumKenar}" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="{Binding TeklifDurumu}" Style="{StaticResource BadgeText}" Foreground="{Binding TeklifDurumYazi}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding TeklifDurumu}" />
                  </Border>
                  <TextBlock Grid.Column="7" Style="{StaticResource ColCell}" Text="{Binding SonIslem}" Foreground="#607089" FontSize="12" />
                  <Button Grid.Column="8" Style="{DynamicResource IconButton}" Width="28" Height="28"
                          Content="{Binding OkIkon}" FontFamily="Segoe MDL2 Assets" FontSize="12"
                          Click="BtnSatirAc_Click" Tag="{Binding}" ToolTip="Detay" />
                </Grid>

                <Border Background="#F0FBFC" BorderBrush="#DDE4EC" BorderThickness="0,0,0,0"
                        Padding="20,14" Visibility="{Binding DetayGorunur}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,32,0">
                      <TextBlock Text="Talep Özeti" FontSize="11" Foreground="#607089" />
                      <TextBlock Text="{Binding KalemOzet}" FontSize="14" FontWeight="SemiBold" Foreground="#10233F" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,32,0">
                      <TextBlock Text="Tahmini Tutar" FontSize="11" Foreground="#607089" />
                      <TextBlock Text="{Binding TahminiTutarMetin}" FontSize="18" FontWeight="SemiBold" Foreground="#10233F" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Content="İncele" Style="{DynamicResource OutlineButton}" Margin="0,0,8,0" Padding="14,8"
                              Click="BtnIncele_Click" Tag="{Binding}" />
                      <Button Style="{DynamicResource PrimaryButton}" Margin="0,0,8,0" Padding="14,8"
                              Click="BtnOnayla_Click" Tag="{Binding}">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                          <TextBlock Text="Onayla" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Button Style="{DynamicResource PurpleOutlineButton}" Padding="14,8"
                              Click="BtnRevize_Click" Tag="{Binding}">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                          <TextBlock Text="Revize İste" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="3" Padding="16,10" BorderBrush="#DDE4EC" BorderThickness="0,1,0,0">
          <DockPanel>
            <TextBlock x:Name="TxtSayfalamaBilgi" DockPanel.Dock="Left" FontSize="12" Foreground="#607089"
                       VerticalAlignment="Center" Text="0 kayıt" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Style="{DynamicResource PaginationButton}" Content="«" Click="BtnIlkSayfa_Click" ToolTip="İlk" />
              <Button Style="{DynamicResource PaginationButton}" Content="‹" Click="BtnOnceki_Click" ToolTip="Önceki" />
              <Border Background="#E8F7F7" CornerRadius="8" Padding="12,5" Margin="4,0" VerticalAlignment="Center">
                <TextBlock x:Name="TxtSayfaNo" Text="1" FontWeight="SemiBold" FontSize="12" Foreground="#046C75" />
              </Border>
              <Button Style="{DynamicResource PaginationButton}" Content="›" Click="BtnSonraki_Click" ToolTip="Sonraki" />
              <Button Style="{DynamicResource PaginationButton}" Content="»" Click="BtnSonSayfa_Click" ToolTip="Son" />
              <ComboBox x:Name="CmbSayfaBoyutu" Width="72" Margin="10,0,0,0" SelectedIndex="0"
                        SelectionChanged="CmbSayfaBoyutu_SelectionChanged" VerticalAlignment="Center">
                <ComboBoxItem Content="10" Tag="10" />
                <ComboBoxItem Content="25" Tag="25" />
                <ComboBoxItem Content="50" Tag="50" />
              </ComboBox>
            </StackPanel>
          </DockPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
