<UserControl x:Class="SatinalmaPro.Views.Modules.Satinalma.Part1.OnaylananTalepDetayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#EEF2F5">
  <Grid Margin="20,12,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="16" BorderBrush="#D9E2EC"
            BorderThickness="1" Padding="22,16" Margin="0,0,0,12">
      <StackPanel>
        <Button Style="{StaticResource SatModBackButton}" Click="Geri_Click" Content="← Listeye dön"
                Margin="0,0,0,10" Padding="10,6" />
        <TextBlock x:Name="TxtBaslik" FontSize="20" FontWeight="SemiBold" Foreground="#102A43" />
        <TextBlock x:Name="TxtOzet" FontSize="12" Foreground="#627D98" Margin="0,4,0,0" TextWrapping="Wrap" />
        <TextBlock x:Name="TxtOnaylayan" FontSize="12" Foreground="#627D98" Margin="0,4,0,0" TextWrapping="Wrap" />
        <Border Margin="0,12,0,0" Background="#E0FCFF" BorderBrush="#0D7377" BorderThickness="1"
                CornerRadius="10" Padding="12,10">
          <TextBlock x:Name="TxtDurum" FontSize="12" Foreground="#0D7377" TextWrapping="Wrap" />
        </Border>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="140" />
        <RowDefinition Height="12" />
        <RowDefinition Height="*" MinHeight="120" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="14" BorderBrush="#D9E2EC" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Padding="16,12" BorderBrush="#D9E2EC" BorderThickness="0,0,0,1" Background="#F0F4F8">
            <TextBlock Text="Onaylanan kalemler" FontSize="13" FontWeight="SemiBold" Foreground="#102A43" />
          </Border>
          <DataGrid x:Name="KalemTablosu" Grid.Row="1" Style="{StaticResource SatModDataGrid}" BorderThickness="0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Malzeme" Binding="{Binding Malzeme}" Width="*" />
              <DataGridTextColumn Header="Miktar" Binding="{Binding MiktarMetni}" Width="100" />
              <DataGridTextColumn Header="Firma" Binding="{Binding Firma}" Width="*" />
              <DataGridTextColumn Header="Birim Fiyat" Binding="{Binding BirimFiyatMetni}" Width="110" />
              <DataGridTextColumn Header="Toplam" Binding="{Binding ToplamMetni}" Width="110" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="14" BorderBrush="#D9E2EC" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Padding="16,12" BorderBrush="#D9E2EC" BorderThickness="0,0,0,1" Background="#F0F4F8">
            <TextBlock x:Name="TxtTeklifBaslik" Text="Firma Teklif Geçmişi"
                       FontSize="13" FontWeight="SemiBold" Foreground="#102A43"
                       Visibility="Collapsed" />
          </Border>
          <DataGrid x:Name="TeklifTablosu" Grid.Row="1" Style="{StaticResource SatModDataGrid}"
                    BorderThickness="0" Visibility="Collapsed" IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Durum" Binding="{Binding DurumMetni}" Width="90" />
              <DataGridTextColumn Header="Firma" Binding="{Binding FirmaAdi}" Width="*" />
              <DataGridTextColumn Header="Marka" Binding="{Binding MarkaOzeti}" Width="100" />
              <DataGridTextColumn Header="Vade" Binding="{Binding VadeGosterim}" Width="80" />
              <DataGridTextColumn Header="Teslim" Binding="{Binding TeslimSuresi}" Width="90" />
              <DataGridTextColumn Header="Ödeme" Binding="{Binding OdemeSekli}" Width="100" />
              <DataGridTextColumn Header="KDV Hariç" Binding="{Binding KdvHaricMetni}" Width="110" />
              <DataGridTextColumn Header="KDV Dahil" Binding="{Binding KdvDahilMetni}" Width="110" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="14" BorderBrush="#D9E2EC"
            BorderThickness="1" Padding="16,12" Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="BtnOnayiGeriAl" Content="Onayı Geri Al" Style="{StaticResource ToolbarButtonStyle}"
                Click="OnayiGeriAl_Click" Margin="0,0,8,0" Padding="12,8" Visibility="Collapsed"
                ToolTip="Onayı geri alır; teklifleri düzenleyip yönetime yeniden gönderebilirsiniz." />
        <Button x:Name="BtnFirmaFiyat" Content="Firma / Fiyat Gir" Style="{StaticResource ToolbarButtonStyle}"
                Click="FirmaFiyat_Click" Margin="0,0,8,0" Padding="12,8" Visibility="Collapsed" />
        <Button Content="Karşılaştırma PDF" Style="{StaticResource ToolbarButtonStyle}"
                Click="KarsilastirmaPdf_Click" Margin="0,0,8,0" Padding="12,8" />
        <Button Content="Onay Belgesi PDF" Style="{StaticResource ToolbarButtonStyle}"
                Click="OnayPdf_Click" Margin="0,0,8,0" Padding="12,8" />
        <Button x:Name="BtnSiparisVer" Content="Sipariş Ver" Style="{StaticResource PrimaryToolbarButtonStyle}"
                Click="SiparisVer_Click" Padding="18,8" Margin="0" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
