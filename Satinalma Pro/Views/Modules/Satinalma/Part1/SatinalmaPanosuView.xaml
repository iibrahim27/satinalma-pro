<UserControl x:Class="SatinalmaPro.Views.Modules.Satinalma.Part1.SatinalmaPanosuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dash="clr-namespace:SatinalmaPro.Controls.Dashboard"
             Background="#EEF2F5">
  <!-- Workspace 26: hero → workflow chips → KPI → grid → charts -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                Padding="20,12,20,16">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" MinHeight="280" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Row0: hero -->
      <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="16" BorderBrush="#D9E2EC"
              BorderThickness="1" Padding="22,16" Margin="0,0,0,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="TALEP PRO" FontSize="11" FontWeight="Bold" Foreground="#4F46E5" />
            <TextBlock Text="İş merkezi" FontSize="22" FontWeight="SemiBold"
                       Foreground="#0F172A" Margin="0,4,0,0" />
            <TextBlock x:Name="TxtPanoKapsam" Margin="0,6,0,0" MaxWidth="720"
                       Foreground="#64748B" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
          <WrapPanel x:Name="HizliEylemPanel" Grid.Column="1" VerticalAlignment="Center"
                     MaxWidth="520" HorizontalAlignment="Right" />
        </Grid>
      </Border>

      <!-- Row1: horizontal workflow -->
      <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="14" BorderBrush="#D9E2EC"
              BorderThickness="1" Padding="16,12" Margin="0,0,0,12">
        <StackPanel>
          <DockPanel LastChildFill="False" Margin="0,0,0,10">
            <TextBlock Text="Süreç kuyruğu" FontSize="13" FontWeight="SemiBold" Foreground="#102A43"
                       DockPanel.Dock="Left" VerticalAlignment="Center" />
            <TextBlock Text="Aşamaya tıklayın" FontSize="11" Foreground="#627D98"
                       DockPanel.Dock="Right" VerticalAlignment="Center" />
          </DockPanel>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="WorkflowPanel" Orientation="Horizontal" />
          </ScrollViewer>
        </StackPanel>
      </Border>

      <!-- Row2: KPI strip -->
      <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="14" BorderBrush="#D9E2EC"
              BorderThickness="1" Padding="16,12" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Anlık özet" FontSize="13" FontWeight="SemiBold" Foreground="#102A43"
                     Margin="0,0,0,10" />
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="KpiPanel" Orientation="Horizontal" />
          </ScrollViewer>
        </StackPanel>
      </Border>

      <!-- Row3: full-width talep grid -->
      <Border Grid.Row="3" Background="#FFFFFF" CornerRadius="14" BorderBrush="#D9E2EC"
              BorderThickness="1" Margin="0,0,0,12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="240" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Padding="16,12" BorderBrush="#D9E2EC" BorderThickness="0,0,0,1">
            <Grid>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="İş listesi" FontSize="13" FontWeight="SemiBold" Foreground="#102A43"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
                <Grid Width="240">
                  <TextBox x:Name="TxtArama" Style="{StaticResource FilterBoxStyle}" Height="34"
                           TextChanged="AramaDegisti" />
                  <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                             Foreground="#627D98" HorizontalAlignment="Right"
                             VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False" />
                </Grid>
              </StackPanel>
              <Button HorizontalAlignment="Right" Style="{StaticResource ToolbarButtonStyle}" Height="34"
                      Content="Tüm talepler" Click="TumTalepler_Click" Padding="12,6" Margin="0" />
            </Grid>
          </Border>

          <Border Grid.Row="1" Background="#F0F4F8" Padding="12,6" BorderBrush="#D9E2EC" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="TabTumu" Style="{StaticResource SatModTabButtonActive}" Content="Tümü"
                      Click="Tab_Click" Tag="Tumu" />
              <Button x:Name="TabBekleyen" Style="{StaticResource SatModTabButton}" Content="İşlem Bekleyen"
                      Click="Tab_Click" Tag="Bekleyen" />
              <Button x:Name="TabTeklif" Style="{StaticResource SatModTabButton}" Content="Teklif"
                      Click="Tab_Click" Tag="Teklif" />
              <Button x:Name="TabOnay" Style="{StaticResource SatModTabButton}" Content="Onay"
                      Click="Tab_Click" Tag="Onay" />
              <Button x:Name="TabSiparis" Style="{StaticResource SatModTabButton}" Content="Sipariş"
                      Click="Tab_Click" Tag="Siparis" />
            </StackPanel>
          </Border>

          <DataGrid x:Name="TalepGrid" Grid.Row="2" Style="{StaticResource SatModPanosuGrid}"
                    BorderThickness="0"
                    CanUserSortColumns="True" CanUserResizeColumns="True"
                    SelectionChanged="TalepGrid_SelectionChanged"
                    MouseDoubleClick="TalepGrid_MouseDoubleClick">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Talep No" Binding="{Binding TalepNo}" Width="100" />
              <DataGridTextColumn Header="Talep Eden" Binding="{Binding TalepEden}" Width="110" />
              <DataGridTextColumn Header="Şantiye" Binding="{Binding Santiye}" Width="100" />
              <DataGridTextColumn Header="Malzeme" Binding="{Binding Malzeme}" Width="*" MinWidth="110" />
              <DataGridTemplateColumn Header="Öncelik" Width="88">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border CornerRadius="6" Padding="6,2" HorizontalAlignment="Center" Background="{Binding OncelikArkaPlan}">
                      <TextBlock Text="{Binding Oncelik}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding OncelikYazi}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Teklif" Binding="{Binding TeklifSayisi}" Width="54" />
              <DataGridTemplateColumn Header="Süreç" Width="110">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border CornerRadius="6" Padding="6,2" HorizontalAlignment="Center" Background="{Binding DurumArkaPlan}">
                      <TextBlock Text="{Binding Durum}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding DurumYazi}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Son İşlem" Binding="{Binding SonIslem}" Width="90" />
              <DataGridTemplateColumn Header="" Width="44" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource SatModIconButton}" Tag="{Binding}" Click="SatirMenu_Tikla" ToolTip="İşlemler">
                      <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#102A43" />
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <!-- Row4: charts side-by-side -->
      <Grid Grid.Row="4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="14" BorderBrush="#D9E2EC"
                BorderThickness="1" Padding="16,14">
          <StackPanel>
            <TextBlock Text="Talep yoğunluğu" FontSize="13" FontWeight="SemiBold" Foreground="#102A43" />
            <dash:ErpLineChartPanel x:Name="AylikGrafik" Height="180" Margin="0,10,0,0" />
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="14" BorderBrush="#D9E2EC"
                BorderThickness="1" Padding="16,14">
          <StackPanel>
            <TextBlock Text="Kategori dağılımı" FontSize="13" FontWeight="SemiBold" Foreground="#102A43" />
            <dash:ErpDonutChartPanel x:Name="KategoriGrafik" Height="180" Margin="0,10,0,0" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
