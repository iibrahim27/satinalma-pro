<UserControl x:Class="SatinalmaPro.Views.Modules.Satinalma.Part1.SatinalmaPanosuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             FontFamily="Segoe UI">
  <UserControl.Resources>
    <Style x:Key="DashCard" TargetType="Border">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#DDE4EC" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="18,16" />
    </Style>
    <Style x:Key="KpiCard" TargetType="Border" BasedOn="{StaticResource DashCard}">
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="#07858E" />
          <Setter Property="Background" Value="#F7FCFC" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="QuickCard" TargetType="Border" BasedOn="{StaticResource DashCard}">
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="#07858E" />
          <Setter Property="Background" Value="#F7FCFC" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#10233F" />
    </Style>
    <Style x:Key="MutedLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#607089" />
    </Style>
    <Style x:Key="PillBox" TargetType="Border">
      <Setter Property="Background" Value="#F8FAFC" />
      <Setter Property="BorderBrush" Value="#DDE4EC" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                Padding="4,0,4,4">
    <StackPanel>
      <!-- 5 KPI -->
      <UniformGrid Columns="5" Margin="0,0,0,12">
        <Border Style="{StaticResource KpiCard}" MouseLeftButtonUp="KpiOnay_Click">
          <DockPanel>
            <Border Width="40" Height="40" CornerRadius="20" Background="#DBEAFE"
                    DockPanel.Dock="Left" Margin="0,0,12,0">
              <TextBlock Text="&#xE121;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#246FE5"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Onay Bekleyen" Style="{StaticResource MutedLabel}" />
              <TextBlock x:Name="TxtKpiOnay" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="#10233F" Margin="0,2,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource KpiCard}" MouseLeftButtonUp="KpiTeklif_Click">
          <DockPanel>
            <Border Width="40" Height="40" CornerRadius="20" Background="#EDE9FE"
                    DockPanel.Dock="Left" Margin="0,0,12,0">
              <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#7447D8"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Teklif Sürecinde" Style="{StaticResource MutedLabel}" />
              <TextBlock x:Name="TxtKpiTeklif" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="#10233F" Margin="0,2,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource KpiCard}" MouseLeftButtonUp="KpiSiparis_Click">
          <DockPanel>
            <Border Width="40" Height="40" CornerRadius="20" Background="#E0F2FE"
                    DockPanel.Dock="Left" Margin="0,0,12,0">
              <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#0284C7"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Siparişe Dönüşen" Style="{StaticResource MutedLabel}" />
              <TextBlock x:Name="TxtKpiSiparis" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="#10233F" Margin="0,2,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource KpiCard}">
          <DockPanel>
            <Border Width="40" Height="40" CornerRadius="20" Background="#DCFCE7"
                    DockPanel.Dock="Left" Margin="0,0,12,0">
              <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#24964A"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Bu Ay Harcama" Style="{StaticResource MutedLabel}" />
              <TextBlock x:Name="TxtKpiHarcama" Text="₺0" FontSize="18" FontWeight="SemiBold"
                         Foreground="#10233F" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource KpiCard}" Margin="0" MouseLeftButtonUp="KpiGeciken_Click"
                ToolTip="3+ gündür bekleyen onay/teklif veya acil talepler (sonlanma tarihi alanı yok)">
          <DockPanel>
            <Border Width="40" Height="40" CornerRadius="20" Background="#FEE2E2"
                    DockPanel.Dock="Left" Margin="0,0,12,0">
              <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#E83F45"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Geciken" Style="{StaticResource MutedLabel}" />
              <TextBlock x:Name="TxtKpiGeciken" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="#10233F" Margin="0,2,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>
      </UniformGrid>

      <!-- Orta: grafik + donut -->
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.4*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource DashCard}" MinHeight="280">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,10">
              <TextBlock Style="{StaticResource CardTitle}" Text="Aylık Satınalma Harcaması" />
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Border Style="{StaticResource PillBox}">
                  <TextBlock x:Name="TxtYilEtiket" Text="Bu Yıl" FontSize="12" Foreground="#10233F" />
                </Border>
                <Border Style="{StaticResource PillBox}" Margin="0">
                  <TextBlock Text="Aylık" FontSize="12" Foreground="#10233F" />
                </Border>
              </StackPanel>
            </DockPanel>
            <Canvas x:Name="AylikCanvas" Grid.Row="1" ClipToBounds="True" MinHeight="200"
                    SizeChanged="AylikCanvas_SizeChanged" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
              <Border Width="10" Height="10" CornerRadius="2" Background="#07858E" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="Harcama (₺)" FontSize="11" Foreground="#607089" Margin="0,0,14,0" VerticalAlignment="Center" />
              <Border Width="10" Height="10" CornerRadius="5" Background="#246FE5" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="Talep Sayısı" FontSize="11" Foreground="#607089" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource DashCard}" MinHeight="280">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource CardTitle}" Text="Talep Durumu" Margin="0,0,0,10" />
            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" MinWidth="130" />
              </Grid.ColumnDefinitions>
              <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="160" Height="160">
                <Canvas x:Name="DonutCanvas" Width="160" Height="160" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <TextBlock Text="Toplam" FontSize="11" Foreground="#607089" HorizontalAlignment="Center" />
                  <TextBlock x:Name="TxtDonutToplam" Text="0" FontSize="20" FontWeight="SemiBold"
                             Foreground="#10233F" HorizontalAlignment="Center" />
                </StackPanel>
              </Grid>
              <StackPanel x:Name="DonutLegend" Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" />
            </Grid>
            <DockPanel Grid.Row="2" Margin="0,10,0,0">
              <TextBlock x:Name="TxtSonGuncelleme" Style="{StaticResource MutedLabel}" FontSize="11"
                         Text="Son güncelleme: —" VerticalAlignment="Center" />
              <Button DockPanel.Dock="Right" Style="{DynamicResource IconButton}" Width="28" Height="28"
                      Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                      ToolTip="Yenile" Click="Yenile_Click" HorizontalAlignment="Right" />
            </DockPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- Alt: kritik tablo + kategori -->
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.35*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource DashCard}" Padding="0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" MinHeight="180" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource CardTitle}" Text="Kritik ve Bekleyen Talepler"
                       Margin="18,16,18,10" />
            <ListBox x:Name="KritikListe" Grid.Row="1" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="Kritik_DoubleClick">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="#DDE4EC"
                                BorderThickness="0,0,0,1" Padding="18,10" Cursor="Hand">
                          <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F3F6F9" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="90" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="90" />
                      <ColumnDefinition Width="80" />
                      <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding TalepNo}" FontSize="12" FontWeight="SemiBold" Foreground="#10233F"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Malzeme}" FontSize="12" Foreground="#10233F"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"
                               ToolTip="{Binding Malzeme}" />
                    <TextBlock Grid.Column="2" Text="{Binding Santiye}" FontSize="12" Foreground="#607089"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Santiye}" />
                    <Border Grid.Column="3" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left"
                            Background="{Binding OncelikArkaPlan}" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Oncelik}" FontSize="11" FontWeight="SemiBold"
                                 Foreground="{Binding OncelikYazi}" />
                    </Border>
                    <TextBlock Grid.Column="4" Text="{Binding Bekleme}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{Binding BeklemeYazi}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Button Grid.Row="2" Content="Tüm kritik ve bekleyen talepleri görüntüle  ›"
                    HorizontalAlignment="Left" Margin="14,8,14,12"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Foreground="#07858E" FontSize="12" FontWeight="SemiBold"
                    Click="TumKritik_Click" Padding="4,6" />
          </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource DashCard}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
              <TextBlock Style="{StaticResource CardTitle}" Text="En Çok Harcama Yapılan Kategoriler"
                         TextWrapping="Wrap" />
              <Border DockPanel.Dock="Right" Style="{StaticResource PillBox}" Margin="8,0,0,0"
                      VerticalAlignment="Top" HorizontalAlignment="Right">
                <TextBlock Text="Bu Yıl" FontSize="12" Foreground="#10233F" />
              </Border>
            </DockPanel>
            <StackPanel x:Name="KategoriPanel" Grid.Row="1" />
          </Grid>
        </Border>
      </Grid>

      <!-- Hızlı işlemler -->
      <UniformGrid Columns="4" Margin="0,0,0,8">
        <Border Style="{StaticResource QuickCard}" MouseLeftButtonUp="HizliYeniTalep_Click">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="›" FontSize="18" Foreground="#94A3B8"
                       VerticalAlignment="Center" Margin="8,0,0,0" />
            <Border Width="40" Height="40" CornerRadius="10" Background="#E0F2FE"
                    DockPanel.Dock="Left" Margin="0,0,12,0">
              <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#0284C7"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Yeni Talep Oluştur" FontSize="13" FontWeight="SemiBold" Foreground="#10233F" />
              <TextBlock Text="Satınalma talebi başlatın" FontSize="11" Foreground="#607089" Margin="0,2,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource QuickCard}" MouseLeftButtonUp="HizliTeklifIstemi_Click">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="›" FontSize="18" Foreground="#94A3B8"
                       VerticalAlignment="Center" Margin="8,0,0,0" />
            <Border Width="40" Height="40" CornerRadius="10" Background="#EDE9FE"
                    DockPanel.Dock="Left" Margin="0,0,12,0">
              <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#7447D8"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Teklif İstemi Oluştur" FontSize="13" FontWeight="SemiBold" Foreground="#10233F" />
              <TextBlock Text="Tedarikçilere teklif isteyin" FontSize="11" Foreground="#607089" Margin="0,2,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource QuickCard}" MouseLeftButtonUp="HizliTeklifOnay_Click">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="›" FontSize="18" Foreground="#94A3B8"
                       VerticalAlignment="Center" Margin="8,0,0,0" />
            <Border Width="40" Height="40" CornerRadius="10" Background="#DCFCE7"
                    DockPanel.Dock="Left" Margin="0,0,12,0">
              <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#24964A"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Teklif İnceleme &amp; Onay" FontSize="13" FontWeight="SemiBold" Foreground="#10233F" />
              <TextBlock Text="Teklifleri inceleyip onaylayın" FontSize="11" Foreground="#607089" Margin="0,2,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource QuickCard}" Margin="0" MouseLeftButtonUp="HizliKarsilastirma_Click">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="›" FontSize="18" Foreground="#94A3B8"
                       VerticalAlignment="Center" Margin="8,0,0,0" />
            <Border Width="40" Height="40" CornerRadius="10" Background="#DBEAFE"
                    DockPanel.Dock="Left" Margin="0,0,12,0">
              <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#246FE5"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Fiyat Karşılaştırma" FontSize="13" FontWeight="SemiBold" Foreground="#10233F" />
              <TextBlock Text="Teklifleri karşılaştırın" FontSize="11" Foreground="#607089" Margin="0,2,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>
      </UniformGrid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
