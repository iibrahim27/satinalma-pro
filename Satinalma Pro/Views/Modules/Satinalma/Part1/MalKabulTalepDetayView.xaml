<UserControl x:Class="SatinalmaPro.Views.Modules.Satinalma.Part1.MalKabulTalepDetayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#EEF2F5">
  <Grid Margin="20,12,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="16" BorderBrush="#D9E2EC"
            BorderThickness="1" Padding="22,16" Margin="0,0,0,12">
      <StackPanel>
        <Button Style="{StaticResource SatModBackButton}" Click="Geri_Click" Content="← Listeye dön"
                Margin="0,0,0,10" Padding="10,6" />
        <TextBlock x:Name="TxtBaslik" FontSize="20" FontWeight="SemiBold" Foreground="#102A43" />
        <TextBlock x:Name="TxtOzet" FontSize="12" Foreground="#627D98" Margin="0,4,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="14" BorderBrush="#D9E2EC" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Padding="16,12" BorderBrush="#D9E2EC" BorderThickness="0,0,0,1" Background="#F0F4F8">
          <TextBlock Text="Kabul edilen kalemler" FontSize="13" FontWeight="SemiBold" Foreground="#102A43" />
        </Border>
        <DataGrid x:Name="KalemTablosu" Grid.Row="1" Style="{StaticResource SatModDataGrid}"
                  BorderThickness="0" IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Malzeme" Binding="{Binding Malzeme}" Width="*" />
            <DataGridTextColumn Header="Sipariş" Binding="{Binding SiparisMiktariMetni}" Width="90" />
            <DataGridTextColumn Header="Kabul" Binding="{Binding KabulMiktarMetni}" Width="90" />
            <DataGridTextColumn Header="Firma" Binding="{Binding Firma}" Width="*" />
            <DataGridTextColumn Header="Durum" Binding="{Binding KabulDurumu}" Width="100" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
