<Window x:Class="SatinalmaPro.Views.Modules.Satinalma.Part1.TalepMiktarDuzenlemeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SatinalmaPro.Views.Controls"
        Title="Talep Kalemlerini Düzenle" Height="560" Width="820"
        MinHeight="440" MinWidth="680" WindowStartupLocation="CenterOwner"
        Background="{StaticResource DashBackgroundBrush}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,16">
      <TextBlock Text="Miktar güncelle, kalem ekle veya sil" FontSize="20" FontWeight="SemiBold"
                 Foreground="{StaticResource DashTextBrush}" />
      <TextBlock x:Name="TxtAciklama" Margin="0,6,0,0" TextWrapping="Wrap"
                 Foreground="{StaticResource DashTextSecondaryBrush}" />
    </StackPanel>

    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource DashBorderBrush}"
            BorderThickness="1" CornerRadius="10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DataGrid x:Name="KalemTablosu" Style="{StaticResource SatModDataGrid}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="False" SelectionMode="Single" Margin="0">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Malzeme" Binding="{Binding Malzeme}" Width="*" IsReadOnly="True" />
            <DataGridTextColumn Header="Birim" Binding="{Binding Birim}" Width="100" IsReadOnly="True" />
            <DataGridTextColumn Header="Talep Miktarı" Width="150">
              <DataGridTextColumn.Binding>
                <Binding Path="Miktar" UpdateSourceTrigger="PropertyChanged" StringFormat="N2" />
              </DataGridTextColumn.Binding>
            </DataGridTextColumn>
          </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,8">
          <Button Content="Seçili kalemi sil" Style="{StaticResource ToolbarButtonStyle}"
                  Click="KalemSil_Click" Padding="14,8" />
          <TextBlock Text="En az bir kalem kalmalıdır. Silinen kalem tekliflerden de düşer."
                     VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12"
                     Foreground="{StaticResource DashTextSecondaryBrush}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource DashBorderBrush}"
            BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,12,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Yeni kalem ekle" FontSize="13" FontWeight="SemiBold"
                   Foreground="{StaticResource DashTextBrush}" Margin="0,0,0,8" />
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Malzeme" FontSize="11" Foreground="{StaticResource DashTextSecondaryBrush}" Margin="0,0,0,4" />
            <Border BorderBrush="{StaticResource DashBorderBrush}" BorderThickness="1" CornerRadius="6"
                    Background="#F8FAFC" Padding="2,0" MinHeight="32">
              <controls:MalzemeOneriGiris x:Name="YeniMalzemeGiris" VerticalAlignment="Center" />
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Birim" FontSize="11" Foreground="{StaticResource DashTextSecondaryBrush}" Margin="0,0,0,4" />
            <ComboBox x:Name="CmbBirim" Style="{StaticResource FilterComboStyle}" Height="32"
                      IsEditable="True" />
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Text="Miktar" FontSize="11" Foreground="{StaticResource DashTextSecondaryBrush}" Margin="0,0,0,4" />
            <TextBox x:Name="TxtYeniMiktar" Style="{StaticResource FilterBoxStyle}" Height="32" Text="1" />
          </StackPanel>
          <Button Grid.Column="6" Content="+ Kalem Ekle" Style="{StaticResource PrimaryToolbarButtonStyle}"
                  VerticalAlignment="Bottom" Padding="16,8" Click="KalemEkle_Click" />
        </Grid>
      </Grid>
    </Border>

    <Grid Grid.Row="3" Margin="0,18,0,0">
      <TextBlock Text="Kayıt sonrası yeni kalemler tüm tekliflere otomatik eklenir; birim fiyatları teklif düzenlemede girilir."
                 VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="480"
                 Foreground="{StaticResource DashTextSecondaryBrush}" FontSize="12" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Vazgeç" Style="{StaticResource ToolbarButtonStyle}"
                Click="Vazgec_Click" Margin="0,0,8,0" Padding="16,9" />
        <Button Content="Kaydet" Style="{StaticResource PrimaryToolbarButtonStyle}"
                Click="Kaydet_Click" Padding="18,9" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
