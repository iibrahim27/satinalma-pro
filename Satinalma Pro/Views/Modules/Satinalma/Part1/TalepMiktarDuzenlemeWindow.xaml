<Window x:Class="SatinalmaPro.Views.Modules.Satinalma.Part1.TalepMiktarDuzenlemeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Talep Kalemlerini Düzenle" Height="480" Width="780"
        MinHeight="380" MinWidth="640" WindowStartupLocation="CenterOwner"
        Background="{StaticResource DashBackgroundBrush}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,16">
      <TextBlock Text="Miktar güncelle veya kalem sil" FontSize="20" FontWeight="SemiBold"
                 Foreground="{StaticResource DashTextBrush}" />
      <TextBlock x:Name="TxtAciklama" Margin="0,6,0,0" TextWrapping="Wrap"
                 Foreground="{StaticResource DashTextSecondaryBrush}" />
    </StackPanel>

    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource DashBorderBrush}"
            BorderThickness="1" CornerRadius="10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DataGrid x:Name="KalemTablosu" Style="{StaticResource SatModDataGrid}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="False" SelectionMode="Single" Margin="0">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Malzeme" Binding="{Binding Malzeme}" Width="*" IsReadOnly="True" />
            <DataGridTextColumn Header="Birim" Binding="{Binding Birim}" Width="100" IsReadOnly="True" />
            <DataGridTextColumn Header="Talep Miktarı" Width="150">
              <DataGridTextColumn.Binding>
                <Binding Path="Miktar" UpdateSourceTrigger="PropertyChanged" StringFormat="N2" />
              </DataGridTextColumn.Binding>
            </DataGridTextColumn>
          </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,8">
          <Button Content="Seçili kalemi sil" Style="{StaticResource ToolbarButtonStyle}"
                  Click="KalemSil_Click" Padding="14,8" />
          <TextBlock Text="En az bir kalem kalmalıdır. Silinen kalem tekliflerden de düşer."
                     VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12"
                     Foreground="{StaticResource DashTextSecondaryBrush}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2" Margin="0,18,0,0">
      <TextBlock Text="Kayıt sonrası teklif tutarları yeni miktar/kalemlere göre yeniden hesaplanır."
                 VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                 Foreground="{StaticResource DashTextSecondaryBrush}" FontSize="12" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Vazgeç" Style="{StaticResource ToolbarButtonStyle}"
                Click="Vazgec_Click" Margin="0,0,8,0" Padding="16,9" />
        <Button Content="Kaydet" Style="{StaticResource PrimaryToolbarButtonStyle}"
                Click="Kaydet_Click" Padding="18,9" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
