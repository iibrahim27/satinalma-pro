<UserControl x:Class="SatinalmaPro.Views.Modules.Satinalma.Part1.TeklifGirisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#EEF2F5">
  <UserControl.Resources>
    <DataTemplate x:Key="KalemOneriSatirSablonu">
      <Border BorderBrush="#D9E2EC" BorderThickness="1" CornerRadius="8"
              Padding="8,6" Margin="0,0,0,4" Background="#E0FCFF">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="64" />
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" MinWidth="160" />
            <ColumnDefinition Width="90" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{Binding Malzeme}" VerticalAlignment="Center" FontSize="12"
                     TextTrimming="CharacterEllipsis" Foreground="#102A43" />
          <TextBlock Grid.Column="1" Text="{Binding Miktar}" VerticalAlignment="Center" FontSize="11"
                     HorizontalAlignment="Right" Foreground="#627D98" />
          <TextBlock Grid.Column="2" Text="{Binding Birim}" VerticalAlignment="Center" FontSize="11"
                     HorizontalAlignment="Center" Foreground="#627D98" />
          <ComboBox Grid.Column="4" ItemsSource="{Binding Firmalar}"
                    SelectedValue="{Binding OnerilenTeklifId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    SelectedValuePath="Id" DisplayMemberPath="Ad"
                    Style="{StaticResource FilterComboStyle}" Height="28" />
          <TextBlock Grid.Column="5" Text="{Binding OneriToplamMetni}" VerticalAlignment="Center"
                     FontSize="11" Foreground="#627D98" HorizontalAlignment="Right" />
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="KalemOnaySatirSablonu">
      <Border BorderBrush="#D9E2EC" BorderThickness="1" CornerRadius="8"
              Padding="8,6" Margin="0,0,0,4" Background="#F0F4F8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="64" />
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" MinWidth="140" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{Binding Malzeme}" VerticalAlignment="Center" FontSize="12"
                     TextTrimming="CharacterEllipsis" Foreground="#102A43" />
          <TextBlock Grid.Column="1" Text="{Binding Miktar}" VerticalAlignment="Center" FontSize="11"
                     HorizontalAlignment="Right" Foreground="#627D98" />
          <TextBlock Grid.Column="2" Text="{Binding Birim}" VerticalAlignment="Center" FontSize="11"
                     HorizontalAlignment="Center" Foreground="#627D98" />
          <ComboBox Grid.Column="4" ItemsSource="{Binding Firmalar}"
                    SelectedValue="{Binding OnaylananTeklifId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    SelectedValuePath="Id" DisplayMemberPath="Ad"
                    Style="{StaticResource FilterComboStyle}" Height="28" />
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <Grid Margin="20,12,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="16" BorderBrush="#D9E2EC"
            BorderThickness="1" Padding="22,16" Margin="0,0,0,12">
      <StackPanel>
        <Button Style="{StaticResource SatModBackButton}" Click="Geri_Click" Content="← Listeye dön"
                Margin="0,0,0,10" Padding="10,6" />
        <TextBlock x:Name="TxtBaslik" FontSize="20" FontWeight="SemiBold" Foreground="#102A43" />
        <TextBlock x:Name="TxtOzet" FontSize="12" Foreground="#627D98" Margin="0,4,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="14" BorderBrush="#D9E2EC"
            BorderThickness="1" Padding="16">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" MinHeight="160" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="DuzeltmeNotuPanel" Grid.Row="0" Background="#FFF7ED"
                BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="10"
                Padding="12,8" Margin="0,0,0,10" Visibility="Collapsed">
          <TextBlock x:Name="TxtDuzeltmeNotu" TextWrapping="Wrap" FontSize="12"
                     Foreground="#9A3412" />
        </Border>

        <Expander x:Name="KalemExpander" Grid.Row="1" Header="Talep kalemleri (miktar / sil)"
                  IsExpanded="True" Margin="0,0,0,8" FontSize="12" Foreground="#102A43">
          <StackPanel>
            <DataGrid x:Name="KalemTablosu" Style="{StaticResource SatModDataGrid}"
                      MaxHeight="160" Margin="0,6,0,6"
                      CanUserAddRows="False" SelectionMode="Single"
                      CellEditEnding="KalemTablosu_CellEditEnding">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Malzeme" Binding="{Binding Malzeme}" Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="Miktar" Binding="{Binding Miktar, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                <DataGridTextColumn Header="Birim" Binding="{Binding Birim}" Width="90" IsReadOnly="True" />
              </DataGrid.Columns>
            </DataGrid>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="BtnKalemDuzenlePencere" Content="Kalemleri Düzenle…"
                      Style="{StaticResource ToolbarButtonStyle}"
                      Click="KalemDuzenle_Click" Margin="0,0,8,0" Padding="12,7" />
              <Button x:Name="BtnKalemSil" Content="Seçili kalemi sil"
                      Style="{StaticResource ToolbarButtonStyle}"
                      Click="KalemSil_Click" Padding="12,7" />
            </StackPanel>
          </StackPanel>
        </Expander>

        <Grid Grid.Row="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Margin="0,0,0,8">
            <TextBlock Text="Teklifler" FontSize="14" FontWeight="SemiBold"
                       Foreground="#102A43" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="Yeni Teklif" Style="{StaticResource ToolbarButtonStyle}"
                      Click="YeniTeklif_Click" Margin="0,0,8,0" Padding="12,7" />
              <Button Content="Düzenle" Style="{StaticResource ToolbarButtonStyle}"
                      Click="Duzenle_Click" Margin="0,0,8,0" Padding="12,7" />
              <Button Content="Sil" Style="{StaticResource ToolbarButtonStyle}"
                      Click="Sil_Click" Padding="12,7" />
            </StackPanel>
          </Grid>

          <DataGrid x:Name="TeklifTablosu" Grid.Row="1" Style="{StaticResource SatModDataGrid}"
                    SelectionChanged="TeklifTablosu_SelectionChanged"
                    MouseDoubleClick="TeklifTablosu_MouseDoubleClick"
                    MinHeight="140">
            <DataGrid.Columns>
              <DataGridTextColumn Header="" Binding="{Binding OneriMetni}" Width="28" />
              <DataGridTextColumn Header="Firma" Binding="{Binding FirmaAdi}" Width="*" />
              <DataGridTextColumn Header="Vade" Binding="{Binding VadeGosterim}" Width="80" />
              <DataGridTextColumn Header="Teslim" Binding="{Binding TeslimSuresi}" Width="90" />
              <DataGridTextColumn Header="KDV Hariç" Binding="{Binding KdvHaricMetni}" Width="110" />
              <DataGridTextColumn Header="KDV Dahil" Binding="{Binding KdvDahilMetni}" Width="110" />
            </DataGrid.Columns>
          </DataGrid>

          <TextBlock x:Name="TxtSatinalmaOnerisi" Grid.Row="2" FontSize="12" Foreground="#627D98"
                     Margin="0,8,0,0" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" />
        </Grid>

        <Expander x:Name="KalemOneriPanel" Grid.Row="3" Margin="0,8,0,0"
                  Header="Satınalma birim önerisi (kalem bazlı)"
                  IsExpanded="False" Visibility="Collapsed"
                  FontSize="12" Foreground="#102A43">
          <StackPanel Margin="0,6,0,0">
            <TextBlock FontSize="12" Foreground="#627D98" Margin="0,0,0,6" TextWrapping="Wrap"
                       Text="Her kalem için önerdiğiniz firmayı seçin. Farklı kalemlerde farklı firmalar önerebilirsiniz." />
            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="KalemOneriListesi" ItemTemplate="{StaticResource KalemOneriSatirSablonu}" />
            </ScrollViewer>
            <Button Content="Kalem Önerilerini Temizle" Style="{StaticResource ToolbarButtonStyle}"
                    Click="KalemOneriTemizle_Click" Margin="0,6,0,0" Padding="10,5" HorizontalAlignment="Left" />
          </StackPanel>
        </Expander>

        <Expander x:Name="KalemOnayPanel" Grid.Row="4" Margin="0,8,0,0"
                  Header="Firma onayı (kalem bazlı)"
                  IsExpanded="False" Visibility="Collapsed"
                  FontSize="12" Foreground="#102A43">
          <StackPanel Margin="0,6,0,0">
            <TextBlock FontSize="12" Foreground="#627D98" Margin="0,0,0,6" TextWrapping="Wrap"
                       Text="Her kalem için onaylanacak firmayı seçin; ardından «Teklif Onayla» ile süreci tamamlayın." />
            <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="KalemOnayListesi" ItemTemplate="{StaticResource KalemOnaySatirSablonu}" />
            </ScrollViewer>
          </StackPanel>
        </Expander>
      </Grid>
    </Border>

    <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="14" BorderBrush="#D9E2EC"
            BorderThickness="1" Padding="16,12" Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="BtnOneri" Content="Tüm Teklifi Öner" Style="{StaticResource ToolbarButtonStyle}"
                Click="Oneri_Click" Margin="0,0,8,0" Padding="12,8" />
        <Button x:Name="BtnTedarikciPdf" Content="Teklif İsteme PDF" Style="{StaticResource ToolbarButtonStyle}"
                Click="TedarikciPdf_Click" Margin="0,0,8,0" Padding="12,8" />
        <Button x:Name="BtnKarsilastirmaPdf" Content="Karşılaştırma PDF" Style="{StaticResource ToolbarButtonStyle}"
                Click="KarsilastirmaPdf_Click" Margin="0,0,8,0" Padding="12,8" Visibility="Collapsed" />
        <Button x:Name="BtnKaydet" Content="Kaydet" Style="{StaticResource ToolbarButtonStyle}"
                Click="Kaydet_Click" Margin="0,0,8,0" Padding="16,8" />
        <Button x:Name="BtnTeklifOnayla" Content="Teklif Onayla" Style="{StaticResource PrimaryToolbarButtonStyle}"
                Click="TeklifOnayla_Click" Margin="0,0,8,0" Padding="18,8" Visibility="Collapsed" />
        <Button x:Name="BtnOnayaGonder" Content="Onaya Gönder" Style="{StaticResource PrimaryToolbarButtonStyle}"
                Click="OnayaGonder_Click" Padding="18,8" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
