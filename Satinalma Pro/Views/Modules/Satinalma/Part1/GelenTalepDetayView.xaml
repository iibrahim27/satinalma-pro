<UserControl x:Class="SatinalmaPro.Views.Modules.Satinalma.Part1.GelenTalepDetayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#EEF2F5">
  <Grid Margin="20,12,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="16" BorderBrush="#D9E2EC"
            BorderThickness="1" Padding="22,16" Margin="0,0,0,12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Button Style="{StaticResource SatModBackButton}" Click="Geri_Click" Content="← Listeye dön"
                Margin="0,0,0,10" Padding="10,6" />
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
          <TextBlock x:Name="TxtBaslik" FontSize="20" FontWeight="SemiBold" Foreground="#102A43" />
          <TextBlock x:Name="TxtOzet" FontSize="12" Foreground="#627D98" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <UniformGrid Grid.Row="2" Columns="3">
          <Border Background="#F0F4F8" CornerRadius="10" BorderBrush="#D9E2EC" BorderThickness="1"
                  Margin="0,0,8,0" Padding="12,10">
            <StackPanel>
              <TextBlock Text="Talep Durumu" FontSize="11" Foreground="#627D98" Margin="0,0,0,4" />
              <TextBlock x:Name="TxtTalepDurumu" FontWeight="SemiBold" Foreground="#102A43" />
            </StackPanel>
          </Border>
          <Border Background="#F0F4F8" CornerRadius="10" BorderBrush="#D9E2EC" BorderThickness="1"
                  Margin="0,0,8,0" Padding="12,10">
            <StackPanel>
              <TextBlock Text="Teklif Durumu" FontSize="11" Foreground="#627D98" Margin="0,0,0,4" />
              <TextBlock x:Name="TxtTeklifDurumu" FontWeight="SemiBold" Foreground="#102A43" />
            </StackPanel>
          </Border>
          <Border Background="#F0F4F8" CornerRadius="10" BorderBrush="#D9E2EC" BorderThickness="1"
                  Padding="12,10">
            <StackPanel>
              <TextBlock Text="Öncelik" FontSize="11" Foreground="#627D98" Margin="0,0,0,4" />
              <TextBlock x:Name="TxtOncelik" FontWeight="SemiBold" Foreground="#102A43" />
            </StackPanel>
          </Border>
        </UniformGrid>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="14" BorderBrush="#D9E2EC" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Padding="16,12" BorderBrush="#D9E2EC" BorderThickness="0,0,0,1" Background="#F0F4F8">
          <TextBlock Text="Talep kalemleri" FontSize="13" FontWeight="SemiBold" Foreground="#102A43" />
        </Border>
        <DataGrid x:Name="KalemTablosu" Grid.Row="1" Style="{StaticResource SatModDataGrid}" BorderThickness="0">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Malzeme" Binding="{Binding Malzeme}" Width="*" />
            <DataGridTextColumn Header="Miktar" Binding="{Binding MiktarGosterim}" Width="90" />
            <DataGridTextColumn Header="Birim" Binding="{Binding Birim}" Width="90" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>

    <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="14" BorderBrush="#D9E2EC"
            BorderThickness="1" Padding="16,12" Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Talep PDF" Style="{StaticResource ToolbarButtonStyle}"
                Click="TalepPdf_Click" Margin="0,0,8,0" Padding="14,8"
                ToolTip="İmzalı talep formu PDF çıktısı" />
        <Button x:Name="BtnMiktarDuzenle" Content="Miktarları Düzenle" Style="{StaticResource ToolbarButtonStyle}"
                Click="MiktarDuzenle_Click" Margin="0,0,8,0" Padding="14,8" Visibility="Collapsed"
                ToolTip="Talep kalemlerinin istenen miktarlarını düzenler" />
        <Button x:Name="BtnReddet" Content="Reddet" Style="{StaticResource ToolbarButtonStyle}"
                Click="Reddet_Click" Margin="0,0,8,0" />
        <Button x:Name="BtnTeklifAl" Content="Teklif Al" Style="{StaticResource ToolbarButtonStyle}"
                Click="TeklifAl_Click" Margin="0,0,8,0" />
        <Button x:Name="BtnOnayla" Content="Onayla" Style="{StaticResource PrimaryToolbarButtonStyle}"
                Click="Onayla_Click" Padding="18,10" Margin="0" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
