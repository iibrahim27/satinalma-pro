<UserControl x:Class="SatinalmaPro.Views.Modules.SatinalmaShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:SatinalmaPro.Helpers"
             Background="#F1F5F9"
             helpers:ScrollWheelHelper.IsEnabled="True">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="248" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Sol menü -->
    <Border Grid.Column="0" Background="#0F172A">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="18,20,18,12">
          <TextBlock Text="MENÜ" FontSize="10" FontWeight="Bold" Foreground="#64748B"
                     Margin="4,0,0,12" />
          <Button x:Name="BtnYeniTalep" Content="+ Yeni Talep"
                  Click="BtnYeniTalep_Click" Visibility="Collapsed"
                  Background="#4F46E5" Foreground="White" BorderThickness="0"
                  Padding="14,11" Cursor="Hand" FontWeight="SemiBold" FontSize="13"
                  HorizontalContentAlignment="Center">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10"
                        Padding="{TemplateBinding Padding}">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#4338CA" />
                  </Trigger>
                  <Trigger Property="Visibility" Value="Collapsed">
                    <Setter TargetName="Bd" Property="Height" Value="0" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Padding="16,14" BorderBrush="#1E293B" BorderThickness="0,1,0,0">
          <TextBlock x:Name="TxtKullanici" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Margin="10,4,10,8" Padding="0,0,4,0">
          <StackPanel x:Name="NavPanel" />
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Ana alan -->
    <Grid Grid.Column="1" Margin="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
              Padding="24,16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="TALEP PRO" FontSize="10" FontWeight="Bold" Foreground="#4F46E5" />
            <TextBlock x:Name="TxtBaslik" FontSize="20" FontWeight="SemiBold"
                       Foreground="#0F172A" Margin="0,2,0,0" />
            <TextBlock x:Name="TxtAciklama" FontSize="12" Foreground="#64748B"
                       Margin="0,4,0,0" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource ToolbarButtonStyle}" Click="Excel_Click"
                    Margin="0,0,6,0" Padding="12,8" Content="Excel" />
            <Button Style="{StaticResource ToolbarButtonStyle}" Click="Pdf_Click"
                    Margin="0,0,6,0" Padding="12,8" Content="PDF" />
            <Button Style="{StaticResource ToolbarButtonStyle}" Click="Yazdir_Click"
                    Margin="0,0,6,0" Padding="12,8" Content="Yazdır" />
            <Button Style="{StaticResource ToolbarButtonStyle}" Click="Yenile_Click"
                    Margin="0,0,6,0" Padding="12,8" Content="Yenile" />
            <Button Style="{StaticResource ToolbarButtonStyle}" Click="Bildirim_Click"
                    Padding="12,8" Content="Bildirim" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" Background="#F1F5F9" Padding="16,14,16,16">
        <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1"
                ClipToBounds="True">
          <ContentControl x:Name="IcerikAlani" />
        </Border>
      </Border>
    </Grid>
  </Grid>
</UserControl>
