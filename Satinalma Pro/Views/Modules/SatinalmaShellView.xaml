<UserControl x:Class="SatinalmaPro.Views.Modules.SatinalmaShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:SatinalmaPro.Helpers"
             Background="{DynamicResource AppBackgroundBrush}"
             FontFamily="Segoe UI"
             helpers:ScrollWheelHelper.IsEnabled="True">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="ColNav" Width="268" MinWidth="72" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Sol menü -->
    <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="16,18,12,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="36" Height="36" CornerRadius="10"
                    Background="{DynamicResource PrimaryTealBrush}" Margin="0,0,10,0">
              <TextBlock Text="TP" Foreground="White" FontWeight="Bold" FontSize="12"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel x:Name="PanelMarkaMetin" VerticalAlignment="Center">
              <TextBlock Text="Talep Pro" FontSize="15" FontWeight="SemiBold"
                         Foreground="{DynamicResource NavyTextBrush}" />
              <TextBlock Text="Satınalma Yönetimi" FontSize="11"
                         Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
          </StackPanel>
          <Button Grid.Column="1" x:Name="BtnMenuDaralt" Style="{DynamicResource IconButton}"
                  Content="&#xE76B;" ToolTip="Menüyü daralt" Click="BtnMenuDaralt_Click"
                  VerticalAlignment="Top" />
        </Grid>

        <Border x:Name="PanelKullanici" Style="{DynamicResource UserProfilePanel}" DockPanel.Dock="Bottom">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="18"
                    Background="{DynamicResource PrimaryTealBrush}" Margin="0,0,10,0">
              <TextBlock x:Name="TxtAvatar" Text="?" Foreground="White" FontWeight="SemiBold"
                         FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel x:Name="PanelKullaniciMetin" Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="TxtKullaniciAd" FontSize="12" FontWeight="SemiBold"
                         Foreground="{DynamicResource NavyTextBrush}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="TxtKullaniciRol" FontSize="11"
                         Foreground="{DynamicResource SecondaryTextBrush}"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="BtnKullaniciMenu" Style="{DynamicResource IconButton}"
                      Content="&#xE70D;" FontSize="12" Width="28" Height="28"
                      ToolTip="Satınalma Pro'ya dön" Click="BtnSatinalmaProDon_Click" Margin="0,0,4,0" />
              <Button x:Name="BtnCikis" Style="{DynamicResource IconButton}"
                      Content="&#xE7E8;" FontSize="12" Width="28" Height="28"
                      ToolTip="Oturumu kapat" Click="BtnCikis_Click" Visibility="Collapsed" />
            </StackPanel>
          </Grid>
        </Border>

        <Button x:Name="BtnCikisAlt" DockPanel.Dock="Bottom" Content="Oturumu Kapat"
                Style="{DynamicResource SecondaryButton}" Margin="12,0,12,10" Padding="10,8"
                Click="BtnCikis_Click" Visibility="Collapsed" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Margin="4,4,4,8" Padding="0,0,2,0">
          <StackPanel x:Name="NavPanel" />
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Ana alan -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="{DynamicResource AppBackgroundBrush}"
              Padding="28,20,24,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock x:Name="TxtBreadcrumb" Style="{DynamicResource BreadcrumbText}"
                       Text="Satınalma" />
            <TextBlock x:Name="TxtBaslik" Style="{DynamicResource SectionTitle}"
                       Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="TxtAciklama" Style="{DynamicResource SectionSubtitle}"
                       Margin="0,4,0,0" />
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Grid Margin="0,0,8,0" VerticalAlignment="Center">
              <Button x:Name="BtnBildirim" Style="{DynamicResource IconButton}"
                      Content="&#xEA8F;" ToolTip="Bildirimler" Click="Bildirim_Click" />
              <Border x:Name="BildirimRozet" Style="{DynamicResource NotificationBadge}"
                      HorizontalAlignment="Right" VerticalAlignment="Top"
                      Margin="0,-2,-2,0" Visibility="Collapsed">
                <TextBlock x:Name="TxtBildirimSayi" Text="0" Foreground="White"
                           FontSize="10" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>

            <Border Width="34" Height="34" CornerRadius="17" Margin="0,0,10,0"
                    Background="{DynamicResource PrimaryTealLightBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    VerticalAlignment="Center">
              <TextBlock x:Name="TxtHeaderAvatar" Text="?"
                         Foreground="{DynamicResource PrimaryTealDarkBrush}"
                         FontWeight="SemiBold" FontSize="11"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <Button x:Name="BtnDisaAktar" Style="{DynamicResource SecondaryButton}"
                    Click="Excel_Click" Margin="0,0,8,0" ToolTip="Listeyi Excel'e aktar">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xEDE1;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="Dışa Aktar" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button x:Name="BtnCikisUst" Style="{DynamicResource SecondaryButton}"
                    Click="BtnCikis_Click" Margin="0,0,8,0" ToolTip="Oturumu kapat"
                    Visibility="Collapsed">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="Çıkış Yap" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button x:Name="BtnYeniTalep" Style="{DynamicResource PrimaryButton}"
                    Click="BtnYeniTalep_Click" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="+" FontSize="15" FontWeight="Bold" Margin="0,0,6,0"
                           VerticalAlignment="Center" />
                <TextBlock Text="Yeni Talep" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" Background="{DynamicResource AppBackgroundBrush}"
              Padding="20,8,20,16">
        <ContentControl x:Name="IcerikAlani" />
      </Border>
    </Grid>
  </Grid>
</UserControl>
