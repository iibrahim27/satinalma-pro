<UserControl x:Class="SatinalmaPro.Views.Modules.StokYonetimiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:controls="clr-namespace:SatinalmaPro.Views.Controls"
             Background="#EEF2F5">
  <UserControl.Resources>
    <Style x:Key="StokNavActiveStyle" TargetType="Button" BasedOn="{StaticResource ErpNavPillActive}" />
  </UserControl.Resources>

  <Grid x:Name="AnaIcerikGrid" Margin="20,12,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="400" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="16" BorderBrush="#D9E2EC" BorderThickness="1"
            Padding="22,16" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Text="STOK" FontSize="11" FontWeight="Bold" Foreground="#0D7377" />
          <TextBlock Text="Stok Yönetimi" FontSize="22" FontWeight="SemiBold" Foreground="#102A43" Margin="0,4,0,0" />
          <Border Background="#EEF2F5" CornerRadius="10" Padding="4" BorderBrush="#D9E2EC" BorderThickness="1" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="BtnNavDurum" Style="{StaticResource StokNavActiveStyle}" Content="Stok Durumu" Click="NavDurum_Click" />
              <Button x:Name="BtnNavTukenen" Style="{StaticResource ErpNavPill}" Content="Tükenen Stoklar" Click="NavTukenen_Click" />
              <Button x:Name="BtnNavHareket" Style="{StaticResource ErpNavPill}" Content="Stok Hareketleri" Click="NavHareket_Click" />
              <Button x:Name="BtnNavSayim" Style="{StaticResource ErpNavPill}" Content="Stok Sayım" Click="NavSayim_Click" />
            </StackPanel>
          </Border>
        </StackPanel>
        <ScrollViewer x:Name="StokKpiScroll" Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center" Margin="8,0">
          <StackPanel x:Name="StokKpiPanel" Orientation="Horizontal" />
        </ScrollViewer>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="BtnDepoTopluGiris" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,6,0" Padding="12,8" Click="DepoTopluGiris_Click" Content="Depo Giriş" />
          <Button x:Name="BtnStokGiris" Style="{StaticResource PrimaryToolbarButtonStyle}" Margin="0,0,6,0" Padding="12,8" Click="StokGiris_Click" Content="+ Stok Girişi" />
          <Button x:Name="BtnStokCikis" Style="{StaticResource ToolbarButtonStyle}" Margin="0,0,6,0" Padding="12,8" Click="StokCikis_Click" Content="Stok Çıkışı" />
          <Button Style="{StaticResource ErpIconBtn}" Click="Yenile_Click" ToolTip="Yenile">
            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#102A43" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- STOK DURUMU -->
    <Grid x:Name="PanelDurum" Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" MinHeight="280" />
      </Grid.RowDefinitions>
      <!-- Compatibility stubs for TamEkran column math (unused in Workspace 26 layout) -->
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0" />
        <ColumnDefinition Width="0" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border x:Name="StokFiltreKart" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
              Background="#FFFFFF" CornerRadius="14" BorderBrush="#D9E2EC" BorderThickness="1"
              Padding="16,12" Margin="0,0,0,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border x:Name="StokSolPanel" BorderBrush="#D9E2EC" BorderThickness="0,0,1,0" Padding="0,0,14,0" Margin="0,0,14,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="80" MaxHeight="140" />
              </Grid.RowDefinitions>
              <TextBlock Text="Kategori Ağacı" FontSize="13" FontWeight="SemiBold" Foreground="#102A43" Margin="0,0,0,8" />
              <Grid Grid.Row="1" Margin="0,0,0,8">
                <TextBox x:Name="TxtKategoriAra" Style="{StaticResource FilterBoxStyle}" Height="32"
                         TextChanged="KategoriAraDegisti"
                         ui:ControlHelper.PlaceholderText="Kategori ara..." />
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                           Foreground="#627D98" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False" />
              </Grid>
              <TreeView x:Name="KategoriAgaci" Grid.Row="2" BorderThickness="0" Background="Transparent"
                        SelectedItemChanged="KategoriAgaci_SelectionChanged">
                <TreeView.ItemContainerStyle>
                  <Style TargetType="TreeViewItem" BasedOn="{StaticResource ErpTreeItem}" />
                </TreeView.ItemContainerStyle>
              </TreeView>
            </Grid>
          </Border>
          <StackPanel Grid.Column="1">
            <TextBlock Text="Filtreler" FontSize="13" FontWeight="SemiBold" Foreground="#102A43" Margin="0,0,0,10" />
            <WrapPanel>
              <StackPanel Width="200" Margin="0,0,12,8">
                <TextBlock Text="Ara" Style="{StaticResource SapFilterLabel}" />
                <TextBox x:Name="TxtArama" Style="{StaticResource FilterBoxStyle}" Height="32" TextChanged="FiltreDegisti"
                         ui:ControlHelper.PlaceholderText="Malzeme, depo..." />
              </StackPanel>
              <StackPanel Width="160" Margin="0,0,12,8">
                <TextBlock Text="Kategori" Style="{StaticResource SapFilterLabel}" />
                <ComboBox x:Name="CmbKategori" Style="{StaticResource FilterComboStyle}" Height="32" SelectionChanged="FiltreDegisti" />
              </StackPanel>
              <StackPanel Width="160" Margin="0,0,12,8">
                <TextBlock Text="Depo / Saha" Style="{StaticResource SapFilterLabel}" />
                <ComboBox x:Name="CmbDepoSaha" Style="{StaticResource FilterComboStyle}" Height="32" SelectionChanged="FiltreDegisti" />
              </StackPanel>
              <StackPanel Width="140" Margin="0,0,0,8">
                <TextBlock Text="Durum" Style="{StaticResource SapFilterLabel}" />
                <ComboBox x:Name="CmbDurum" Style="{StaticResource FilterComboStyle}" Height="32" SelectionChanged="FiltreDegisti" />
              </StackPanel>
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>

      <Grid x:Name="StokIcerikGrid" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
        <Grid.RowDefinitions>
          <RowDefinition Height="0" />
          <RowDefinition Height="0" />
          <RowDefinition Height="*" MinHeight="280" />
        </Grid.RowDefinitions>

        <Border x:Name="StokTabloKart" Grid.Row="2" Background="#FFFFFF" CornerRadius="16"
                BorderBrush="#D9E2EC" BorderThickness="1">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#F0F4F8" BorderBrush="#D9E2EC" BorderThickness="0,0,0,1"
                    CornerRadius="16,16,0,0" Padding="16,10">
              <Grid>
                <TextBlock x:Name="TxtStokTabloBaslik" Text="Stok Listesi" FontSize="13" FontWeight="SemiBold"
                           Foreground="#102A43" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Style="{StaticResource ErpTableToolbarBtn}" Content="Kolonlar" Click="StokKolonlar_Click" />
                  <Button Style="{StaticResource ErpTableToolbarBtn}" Content="Grupla" Click="StokGrupla_Click" />
                  <Button Style="{StaticResource ErpTableToolbarBtn}" Content="Filtre" Click="StokFiltreOdak_Click" />
                  <Button Style="{StaticResource ErpTableToolbarBtn}" Content="Excel" Click="DisaAktar_Click" />
                  <Button Style="{StaticResource ErpTableToolbarBtn}" Content="PDF" Click="PdfIndir_Click" />
                  <Button Style="{StaticResource ErpTableToolbarBtn}" Content="Yeni Kalem" Click="YeniDurumKayit_Click" />
                  <Button Style="{StaticResource ErpTableToolbarBtn}" Content="Yoğun" Click="StokYogunGorunum_Click" ToolTip="Satır yüksekliği" />
                  <Button x:Name="BtnStokTamEkran" Style="{StaticResource ErpTableToolbarBtn}" Content="Tam Ekran" Click="StokTamEkran_Click" />
                </StackPanel>
              </Grid>
            </Border>
            <DataGrid x:Name="StokGrid" Grid.Row="1" Style="{StaticResource ErpPremiumGrid}"
                      BorderThickness="0"
                      CanUserReorderColumns="True"
                      LoadingRow="StokGrid_LoadingRow" SelectionChanged="StokGrid_SelectionChanged"
                      MouseDoubleClick="StokGrid_MouseDoubleClick">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Stok Kodu" Binding="{Binding StokKoduGoster}" Width="90" />
                <DataGridTextColumn Header="Stok Adı" Binding="{Binding MalzemeAdi}" Width="150" />
                <DataGridTextColumn Header="Kategori" Binding="{Binding Kategori}" Width="100" />
                <DataGridTextColumn Header="Birim" Binding="{Binding Birim}" Width="60" />
                <DataGridTextColumn Header="Mevcut" Binding="{Binding MevcutMiktar, StringFormat=N2}" Width="80" />
                <DataGridTextColumn Header="Minimum" Binding="{Binding MinimumStok, StringFormat=N2}" Width="80" />
                <DataGridTextColumn Header="Birim Fiyat" Binding="{Binding BirimMaliyet, StringFormat='₺{0:N2}'}" Width="100" />
                <DataGridTextColumn Header="Depo" Binding="{Binding DepoSaha}" Width="100" />
                <DataGridTemplateColumn Header="Durum" Width="90">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border CornerRadius="6" Padding="10,4" HorizontalAlignment="Center">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="#DCFCE7" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding DurumMetin}" Value="Kritik">
                                <Setter Property="Background" Value="#FEE2E2" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding DurumMetin}" Value="Düşük">
                                <Setter Property="Background" Value="#FEF3C7" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding DurumMetin}" Value="Tükendi">
                                <Setter Property="Background" Value="#F1F5F9" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding DurumRozetMetin}" FontSize="11" FontWeight="SemiBold">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="#16A34A" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding DurumMetin}" Value="Kritik">
                                  <Setter Property="Foreground" Value="#DC2626" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DurumMetin}" Value="Düşük">
                                  <Setter Property="Foreground" Value="#D97706" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DurumMetin}" Value="Tükendi">
                                  <Setter Property="Foreground" Value="#64748B" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Son Güncelleme" Binding="{Binding SonGuncelleme}" Width="100" />
                <DataGridTemplateColumn Header="" Width="48">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource ErpIconBtn}" Tag="{Binding}" Click="StokSatirMenu_Click">
                        <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#102A43" />
                      </Button>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Row="2" Style="{StaticResource ErpFooterBar}">
              <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Style="{StaticResource ErpFooterText}" Text="Toplam Kalem:" />
                  <TextBlock x:Name="TxtAltKalem" Style="{StaticResource ErpFooterValue}" Text="0" />
                  <TextBlock Style="{StaticResource ErpFooterText}" Text="Toplam Değer:" />
                  <TextBlock x:Name="TxtAltDeger" Style="{StaticResource ErpFooterValue}" Text="₺0" />
                  <TextBlock x:Name="TxtStokGrupBilgi" Style="{StaticResource ErpFooterText}" Margin="12,0,0,0" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <TextBlock Text="Sayfa boyutu:" Style="{StaticResource ErpFooterText}" Margin="0,0,8,0" />
                  <ComboBox x:Name="CmbStokSayfaBoyutu" Width="72" Height="28" VerticalContentAlignment="Center"
                            SelectionChanged="StokSayfaBoyutuDegisti">
                    <ComboBoxItem Content="25" Tag="25" />
                    <ComboBoxItem Content="50" Tag="50" IsSelected="True" />
                    <ComboBoxItem Content="100" Tag="100" />
                    <ComboBoxItem Content="200" Tag="200" />
                  </ComboBox>
                </StackPanel>
              </Grid>
            </Border>
            <controls:SayfalamaCubugu x:Name="StokSayfalamaBar" Grid.Row="3" />
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- STOK HAREKETLERİ -->
    <Grid x:Name="PanelHareket" Grid.Row="1" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="14" BorderBrush="#D9E2EC" BorderThickness="1"
              Padding="16,12" Margin="0,0,0,12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DockPanel LastChildFill="False">
            <TextBlock Text="Filtreler" FontSize="13" FontWeight="SemiBold" Foreground="#102A43"
                       VerticalAlignment="Center" DockPanel.Dock="Left" />
            <Button Style="{StaticResource ToolbarButtonStyle}" Content="Temizle" Click="HareketFiltreTemizle_Click"
                    DockPanel.Dock="Right" Padding="14,7" />
          </DockPanel>
          <WrapPanel Grid.Row="1" Margin="0,12,0,0">
            <StackPanel Width="200" Margin="0,0,12,8">
              <TextBlock Text="Ara" Style="{StaticResource SapFilterLabel}" />
              <TextBox x:Name="TxtHareketAra" Style="{StaticResource FilterBoxStyle}" Height="32"
                       TextChanged="HareketFiltreDegisti" ui:ControlHelper.PlaceholderText="Malzeme, belge..." />
            </StackPanel>
            <StackPanel Width="160" Margin="0,0,12,8">
              <TextBlock Text="Hareket Tipi" Style="{StaticResource SapFilterLabel}" />
              <ComboBox x:Name="CmbHareketTip" Style="{StaticResource FilterComboStyle}" Height="32" SelectionChanged="HareketFiltreDegisti" />
            </StackPanel>
            <StackPanel Width="160" Margin="0,0,0,8">
              <TextBlock Text="Depo" Style="{StaticResource SapFilterLabel}" />
              <ComboBox x:Name="CmbHareketDepo" Style="{StaticResource FilterComboStyle}" Height="32" SelectionChanged="HareketFiltreDegisti" />
            </StackPanel>
          </WrapPanel>
        </Grid>
      </Border>
      <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="16" BorderBrush="#D9E2EC" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DataGrid x:Name="HareketGrid" Style="{StaticResource ErpPremiumGrid}" BorderThickness="0" IsReadOnly="True"
                    MouseDoubleClick="HareketGrid_MouseDoubleClick" PreviewMouseRightButtonDown="HareketGrid_PreviewMouseRightButtonDown">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Tarih" Binding="{Binding Tarih}" Width="90" />
              <DataGridTextColumn Header="Tip" Binding="{Binding HareketTipi}" Width="70" />
              <DataGridTextColumn Header="Malzeme" Binding="{Binding MalzemeAdi}" Width="130" />
              <DataGridTextColumn Header="Miktar" Binding="{Binding MiktarGosterim}" Width="110" />
              <DataGridTextColumn Header="Birim" Binding="{Binding Birim}" Width="55" />
              <DataGridTextColumn Header="Depo" Binding="{Binding DepoSaha}" Width="100" />
              <DataGridTextColumn Header="Belge No" Binding="{Binding BelgeNo}" Width="85" />
              <DataGridTextColumn Header="İşlem Yapan" Binding="{Binding IslemYapan}" Width="100" />
              <DataGridTextColumn Header="Açıklama" Binding="{Binding Aciklama}" Width="*" MinWidth="120" />
            </DataGrid.Columns>
          </DataGrid>
          <Border Grid.Row="1" Style="{StaticResource ErpFooterBar}" CornerRadius="0,0,16,16" Padding="0">
            <controls:SayfalamaCubugu x:Name="HareketSayfalamaBar" />
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!-- STOK SAYIM -->
    <Grid x:Name="PanelSayim" Grid.Row="1" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="14" BorderBrush="#D9E2EC" BorderThickness="1"
              Padding="16,12" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Sayım Formu" FontSize="13" FontWeight="SemiBold" Foreground="#102A43" Margin="0,0,0,12" />
          <WrapPanel>
            <StackPanel Width="140" Margin="0,0,12,8">
              <TextBlock Text="Tarih" Style="{StaticResource SapFilterLabel}" />
              <TextBox x:Name="TxtSayimTarih" Style="{StaticResource FilterBoxStyle}" Height="32" />
            </StackPanel>
            <StackPanel Width="220" Margin="0,0,12,8">
              <TextBlock Text="Sayım Yapılacak Stok" Style="{StaticResource SapFilterLabel}" />
              <ComboBox x:Name="CmbSayimStok" Style="{StaticResource FilterComboStyle}" Height="32"
                        SelectionChanged="SayimStokSecildi" DisplayMemberPath="SecimMetni" />
            </StackPanel>
            <StackPanel Width="140" Margin="0,0,12,8">
              <TextBlock Text="Sistemdeki Miktar" Style="{StaticResource SapFilterLabel}" />
              <TextBox x:Name="TxtSayimMevcut" Style="{StaticResource ModuleReadOnlyFieldStyle}" Height="32" />
            </StackPanel>
            <StackPanel Width="140" Margin="0,0,12,8">
              <TextBlock Text="Sayım Miktarı" Style="{StaticResource SapFilterLabel}" />
              <TextBox x:Name="TxtSayimMiktar" Style="{StaticResource FilterBoxStyle}" Height="32" TextChanged="SayimFarkHesapla" />
            </StackPanel>
            <StackPanel Width="120" Margin="0,0,12,8">
              <TextBlock Text="Fark" Style="{StaticResource SapFilterLabel}" />
              <TextBox x:Name="TxtSayimFark" Style="{StaticResource ModuleReadOnlyFieldStyle}" Height="32" />
            </StackPanel>
            <StackPanel Width="160" Margin="0,0,12,8">
              <TextBlock Text="İşlem Yapan" Style="{StaticResource SapFilterLabel}" />
              <TextBox x:Name="TxtSayimIslemYapan" Style="{StaticResource FilterBoxStyle}" Height="32" />
            </StackPanel>
            <StackPanel Width="200" Margin="0,0,12,8">
              <TextBlock Text="Açıklama" Style="{StaticResource SapFilterLabel}" />
              <TextBox x:Name="TxtSayimAciklama" Style="{StaticResource FilterBoxStyle}" Height="32" />
            </StackPanel>
            <StackPanel Width="140" Margin="0,0,0,8" VerticalAlignment="Bottom">
              <Button Style="{StaticResource PrimaryToolbarButtonStyle}" HorizontalAlignment="Stretch"
                      Content="Sayımı Kaydet" Click="SayimKaydet_Click" Padding="12,9" Height="32" />
            </StackPanel>
          </WrapPanel>
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="16" BorderBrush="#D9E2EC" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DataGrid x:Name="SayimGrid" Style="{StaticResource ErpPremiumGrid}" BorderThickness="0" IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Tarih" Binding="{Binding Tarih}" Width="90" />
              <DataGridTextColumn Header="Malzeme" Binding="{Binding MalzemeAdi}" Width="140" />
              <DataGridTextColumn Header="Sayım" Binding="{Binding MiktarGosterim}" Width="130" />
              <DataGridTextColumn Header="Depo" Binding="{Binding DepoSaha}" Width="110" />
              <DataGridTextColumn Header="İşlem Yapan" Binding="{Binding IslemYapan}" Width="110" />
              <DataGridTextColumn Header="Açıklama" Binding="{Binding Aciklama}" Width="*" MinWidth="120" />
            </DataGrid.Columns>
          </DataGrid>
          <Border Grid.Row="1" Style="{StaticResource ErpFooterBar}" CornerRadius="0,0,16,16" Padding="0">
            <controls:SayfalamaCubugu x:Name="SayimSayfalamaBar" />
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
