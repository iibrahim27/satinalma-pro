<UserControl x:Class="SatinalmaPro.Views.Modules.CimentoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:controls="clr-namespace:SatinalmaPro.Views.Controls"
             Background="#EEF2F5">
  <!-- Workspace 26: hero + yatay filtre + tam genişlik tablo -->
  <Grid x:Name="AnaIcerikGrid" Margin="20,12,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="320" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="16" BorderBrush="#D9E2EC" BorderThickness="1"
            Padding="22,16" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Text="ÇİMENTO" FontSize="11" FontWeight="Bold" Foreground="#0D7377" />
          <TextBlock Text="Çimento" FontSize="22" FontWeight="SemiBold" Foreground="#102A43" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
          <Border BorderBrush="#D9E2EC" BorderThickness="0,0,1,0" Padding="0,0,14,0" Margin="0,0,14,0">
            <StackPanel>
              <TextBlock Text="Toplam Kayıt" FontSize="10" FontWeight="SemiBold" Foreground="#627D98" />
              <TextBlock x:Name="TxtToplamKayit" Text="0" FontSize="15" FontWeight="SemiBold" Foreground="#102A43" />
              <TextBlock x:Name="TxtToplamKayitAlt" Text="Bu filtreleme için" FontSize="10" Foreground="#627D98" />
            </StackPanel>
          </Border>
          <Border BorderBrush="#D9E2EC" BorderThickness="0,0,1,0" Padding="0,0,14,0" Margin="0,0,14,0">
            <StackPanel>
              <TextBlock Text="Toplam Tonaj" FontSize="10" FontWeight="SemiBold" Foreground="#627D98" />
              <TextBlock x:Name="TxtToplamMiktar" Text="0 Ton" FontSize="15" FontWeight="SemiBold" Foreground="#102A43" />
            </StackPanel>
          </Border>
          <Border BorderBrush="#D9E2EC" BorderThickness="0,0,1,0" Padding="0,0,14,0" Margin="0,0,14,0">
            <StackPanel>
              <TextBlock Text="Toplam Tutar" FontSize="10" FontWeight="SemiBold" Foreground="#627D98" />
              <TextBlock x:Name="TxtToplamTutar" Text="₺0" FontSize="15" FontWeight="SemiBold" Foreground="#102A43" />
            </StackPanel>
          </Border>
          <StackPanel>
            <TextBlock Text="Teslim Edilen" FontSize="10" FontWeight="SemiBold" Foreground="#627D98" />
            <TextBlock x:Name="TxtTeslimEdilen" Text="0" FontSize="15" FontWeight="SemiBold" Foreground="#102A43" />
          </StackPanel>
        </StackPanel>
        <WrapPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
          <Button Style="{StaticResource PrimaryToolbarButtonStyle}" Click="YeniKayit_Click" Margin="0,0,6,0" Padding="12,8" Content="+ Yeni" />
          <Button Style="{StaticResource ToolbarButtonStyle}" Click="ExcelYukle_Click" Margin="0,0,6,0" Padding="10,8" Content="Excel Yükle" />
          <Button Style="{StaticResource ToolbarButtonStyle}" Click="SablonIndir_Click" Margin="0,0,6,0" Padding="10,8" Content="Şablon" />
          <Button Style="{StaticResource ToolbarButtonStyle}" Click="PdfIndir_Click" Margin="0,0,6,0" Padding="10,8" Content="PDF" />
          <Button Style="{StaticResource ToolbarButtonStyle}" Click="PdfYazdir_Click" Margin="0,0,6,0" Padding="10,8" Content="Yazdır" />
          <Button Style="{StaticResource ToolbarButtonStyle}" Click="DisaAktar_Click" Margin="0,0,6,0" Padding="10,8" Content="Dışa Aktar" />
          <Button Style="{StaticResource ErpIconBtn}" Click="Yenile_Click" ToolTip="Yenile">
            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#102A43" />
          </Button>
        </WrapPanel>
      </Grid>
    </Border>

    <Border x:Name="FiltrePanelKap" Grid.Row="1" Background="#FFFFFF" CornerRadius="14"
            BorderBrush="#D9E2EC" BorderThickness="1" Padding="16,12" Margin="0,0,0,12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border x:Name="FiltreBaslikBar" Padding="0">
          <DockPanel LastChildFill="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
              <TextBlock Text="Filtreler" FontSize="13" FontWeight="SemiBold" Foreground="#102A43" VerticalAlignment="Center" />
              <Border Background="#E0FCFF" CornerRadius="8" Padding="8,2" Margin="8,0,0,0">
                <TextBlock x:Name="TxtAktifFiltreSayisi" Text="0" FontSize="11" FontWeight="SemiBold" Foreground="#0D7377" />
              </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
              <Button Style="{StaticResource PrimaryToolbarButtonStyle}" Content="Ara" Click="FiltreAra_Click"
                      Margin="0,0,8,0" Padding="14,7" />
              <Button Style="{StaticResource ToolbarButtonStyle}" Content="Temizle" Click="FiltreleriTemizle_Click"
                      Margin="0,0,8,0" Padding="14,7" />
              <Button Style="{StaticResource ToolbarButtonStyle}" Content="Filtrele" Click="FiltreUygula_Click"
                      Margin="0" Padding="14,7" />
              <Button x:Name="BtnFiltreToggle" Visibility="Collapsed" Click="FiltrePaneli_Toggle" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="TxtFiltreToggle" Text="Filtreler" VerticalAlignment="Center" />
                  <TextBlock x:Name="IcoFiltreToggle" Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                             Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </DockPanel>
        </Border>

        <WrapPanel x:Name="FiltrePanelIcerik" Grid.Row="1" Margin="0,12,0,0">
          <StackPanel Width="140" Margin="0,0,12,8">
            <TextBlock Text="Başlangıç Tarihi" Style="{StaticResource SapFilterLabel}" />
            <DatePicker x:Name="DpBaslangic" Height="34" SelectedDateChanged="FiltreDegisti" />
          </StackPanel>
          <StackPanel Width="140" Margin="0,0,12,8">
            <TextBlock Text="Bitiş Tarihi" Style="{StaticResource SapFilterLabel}" />
            <DatePicker x:Name="DpBitis" Height="34" SelectedDateChanged="FiltreDegisti" />
          </StackPanel>
          <StackPanel Width="160" Margin="0,0,12,8">
            <TextBlock Text="Tedarikçi" Style="{StaticResource SapFilterLabel}" />
            <ComboBox x:Name="CmbTedarikci" Style="{StaticResource FilterComboStyle}" Height="34"
                      SelectionChanged="TedarikciDegisti" />
          </StackPanel>
          <StackPanel Width="160" Margin="0,0,12,8">
            <TextBlock Text="Çimento Cinsi" Style="{StaticResource SapFilterLabel}" />
            <Button x:Name="BtnCimentoCinsiSec" Style="{StaticResource ToolbarButtonStyle}"
                    HorizontalAlignment="Stretch" Height="34" Click="CimentoCinsiSec_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" />
                <TextBlock x:Name="TxtCimentoCinsiSecim" Text="Tümü" />
              </StackPanel>
            </Button>
          </StackPanel>
          <StackPanel Width="140" Margin="0,0,12,8">
            <TextBlock Text="Çimento Sınıfı" Style="{StaticResource SapFilterLabel}" />
            <ComboBox x:Name="CmbCimentoSinifi" Style="{StaticResource FilterComboStyle}" Height="34"
                      SelectionChanged="FiltreDegisti" />
          </StackPanel>
          <StackPanel Width="140" Margin="0,0,12,8">
            <TextBlock Text="Şantiye" Style="{StaticResource SapFilterLabel}" />
            <ComboBox x:Name="CmbSantiye" Style="{StaticResource FilterComboStyle}" Height="34"
                      SelectionChanged="FiltreDegisti" />
          </StackPanel>
          <StackPanel Width="160" Margin="0,0,12,8">
            <TextBlock Text="Teslim Alan" Style="{StaticResource SapFilterLabel}" />
            <TextBox x:Name="TxtTeslimAlanFilter" Style="{StaticResource FilterBoxStyle}" Height="34"
                     TextChanged="FiltreDegisti"
                     ui:ControlHelper.PlaceholderText="Teslim alan ara..." />
          </StackPanel>
          <StackPanel Width="140" Margin="0,0,0,8">
            <TextBlock Text="İrsaliye No" Style="{StaticResource SapFilterLabel}" />
            <TextBox x:Name="TxtIrsaliyeNoFilter" Style="{StaticResource FilterBoxStyle}" Height="34"
                     TextChanged="FiltreDegisti"
                     ui:ControlHelper.PlaceholderText="İrsaliye no..." />
          </StackPanel>
        </WrapPanel>
      </Grid>
    </Border>

    <Border x:Name="TabloKart" Grid.Row="2" Background="#FFFFFF" CornerRadius="16"
            BorderBrush="#D9E2EC" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F0F4F8" BorderBrush="#D9E2EC" BorderThickness="0,0,0,1"
                CornerRadius="16,16,0,0" Padding="16,10">
          <Grid>
            <TextBlock x:Name="TxtGridBaslik" Text="Çimento Listesi (0 kayıt)" FontSize="13" FontWeight="SemiBold"
                       Foreground="#102A43" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Grid Width="180" Margin="0,0,8,0">
                <TextBox x:Name="TxtGridArama" Style="{StaticResource FilterBoxStyle}" Height="32"
                         TextChanged="FiltreDegisti"
                         ui:ControlHelper.PlaceholderText="Tabloda ara..." />
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                           Foreground="#627D98" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False" />
              </Grid>
              <Button Style="{StaticResource ErpTableToolbarBtn}" Click="FiltreOdak_Click" Content="Filtre" />
              <Button Style="{StaticResource ErpTableToolbarBtn}" Click="Kolonlar_Click" Content="Kolonlar" />
              <Button Style="{StaticResource ErpTableToolbarBtn}" Click="Grupla_Click" Content="Grupla" />
              <Button Style="{StaticResource ErpTableToolbarBtn}" Click="DisaAktar_Click" Content="Dışa Aktar" />
              <Button x:Name="BtnYogunGorunum" Style="{StaticResource ErpTableToolbarBtn}"
                      Click="YogunGorunum_Click" ToolTip="Yoğun Görünüm" Content="Yoğun" />
              <Button x:Name="BtnTamEkran" Style="{StaticResource ErpTableToolbarBtn}"
                      Click="TamEkran_Click" ToolTip="Tam Ekran" Content="Tam Ekran" />
            </StackPanel>
          </Grid>
        </Border>

        <DataGrid x:Name="CimentoGrid" Grid.Row="1" Style="{StaticResource ErpPremiumGrid}"
                  BorderThickness="0"
                  CanUserSortColumns="True" CanUserReorderColumns="True"
                  SelectionMode="Extended"
                  LoadingRow="CimentoGrid_LoadingRow"
                  SelectionChanged="CimentoGrid_SelectionChanged"
                  MouseDoubleClick="CimentoGrid_MouseDoubleClick"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Düzenle" Click="MenuDuzenle_Click" />
              <Separator />
              <MenuItem Header="Sil" Click="MenuSil_Click" />
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.Columns>
            <DataGridTextColumn Header="Tarih" Binding="{Binding Tarih}" Width="95" />
            <DataGridTextColumn Header="İrsaliye No" Binding="{Binding IrsaliyeNo}" Width="105" />
            <DataGridTextColumn Header="Sipariş No" Binding="{Binding SiparisNo}" Width="100" />
            <DataGridTextColumn Header="Çimento Cinsi" Binding="{Binding CimentoCinsi}" Width="140" />
            <DataGridTextColumn Header="Çimento Sınıfı" Binding="{Binding CimentoSinifi}" Width="115" />
            <DataGridTextColumn Header="Miktar" Binding="{Binding Miktar, StringFormat=N2}" Width="80" />
            <DataGridTextColumn Header="Birim" Binding="{Binding Birim}" Width="65" />
            <DataGridTextColumn Header="Birim Fiyatı" Binding="{Binding BirimFiyati, StringFormat='₺{0:N2}'}" Width="105" />
            <DataGridTextColumn Header="Toplam Tutar" Binding="{Binding ToplamTutar, StringFormat='₺{0:N2}'}" Width="115" />
            <DataGridTextColumn Header="Tedarikçi" Binding="{Binding Tedarikci}" Width="130" />
            <DataGridTextColumn Header="Şantiye" Binding="{Binding IndirildigiSaha}" Width="120" />
            <DataGridTextColumn Header="Teslim Alan" Binding="{Binding TeslimAlan}" Width="110" />
            <DataGridTextColumn Header="Açıklama" Binding="{Binding Aciklama}" Width="*" MinWidth="140" />
            <DataGridTemplateColumn Header="İşlemler" Width="70" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource ErpIconBtn}" Tag="{Binding}" Click="SatirIslem_Tikla" ToolTip="İşlemler">
                    <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#102A43" />
                  </Button>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Style="{StaticResource ErpFooterBar}" CornerRadius="0,0,16,16">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtFooterKayit" Text="Toplam 0 kayıt" FontSize="12" FontWeight="SemiBold"
                           Foreground="#102A43" Margin="0,0,24,0" />
                <TextBlock x:Name="TxtFooterTon" Text="0,00 Ton" FontSize="12" FontWeight="SemiBold"
                           Foreground="#627D98" Margin="0,0,24,0" />
                <TextBlock x:Name="TxtFooterTutar" Text="₺0,00" FontSize="12" FontWeight="SemiBold"
                           Foreground="#627D98" />
                <TextBlock x:Name="TxtGrupBilgi" Text="" FontSize="12" Foreground="#627D98"
                           Margin="16,0,0,0" Visibility="Collapsed" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Sayfa boyutu:" Style="{StaticResource ErpFooterText}" Margin="0,0,8,0" />
                <ComboBox x:Name="CmbSayfaBoyutu" Width="110" Height="28" FontSize="12">
                  <ComboBoxItem Content="25 / Sayfa" Tag="25" IsSelected="True" />
                  <ComboBoxItem Content="50 / Sayfa" Tag="50" />
                  <ComboBoxItem Content="100 / Sayfa" Tag="100" />
                </ComboBox>
              </StackPanel>
            </Grid>
            <controls:SayfalamaCubugu x:Name="SayfalamaBar" Grid.Row="1" Margin="0,8,0,0" />
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
