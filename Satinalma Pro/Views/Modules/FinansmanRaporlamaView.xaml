<UserControl x:Class="SatinalmaPro.Views.Modules.FinansmanRaporlamaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:helpers="clr-namespace:SatinalmaPro.Helpers"
             Background="#EEF2F5">
  <Grid Margin="20,12,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" MinHeight="320" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="16" BorderBrush="#D9E2EC" BorderThickness="1"
            Padding="22,16" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="FİNANSMAN" FontSize="11" FontWeight="Bold" Foreground="#0D7377" />
          <TextBlock Text="Finansman Raporlama" FontSize="22" FontWeight="SemiBold" Foreground="#102A43" Margin="0,4,0,0" />
        </StackPanel>
        <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" MaxWidth="520">
          <Button Style="{StaticResource PrimaryToolbarButtonStyle}" Click="PdfIndir_Click" Margin="0,0,6,4" Padding="12,8" Content="PDF İndir" />
          <Button Style="{StaticResource ToolbarButtonStyle}" Click="PdfYazdir_Click" Margin="0,0,6,4" Padding="10,8" Content="Yazdır" />
          <Button Style="{StaticResource ToolbarButtonStyle}" Click="ExcelAktar_Click" Margin="0,0,6,4" Padding="10,8" Content="Excel" />
          <Button Style="{StaticResource ToolbarButtonStyle}" Click="GelirSablon_Click" Margin="0,0,6,4" Padding="10,8" Content="Gelir Şablon" />
          <Button Style="{StaticResource ToolbarButtonStyle}" Click="GelirExcelYukle_Click" Margin="0,0,6,4" Padding="10,8" Content="Gelir Excel" />
          <Button Style="{StaticResource ToolbarButtonStyle}" Click="YeniGelir_Click" Margin="0,0,6,4" Padding="10,8" Content="+ Yeni Gelir" />
          <Button Style="{StaticResource ErpIconBtn}" Click="Yenile_Click" ToolTip="Yenile" Margin="0,0,0,4">
            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#102A43" />
          </Button>
        </WrapPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="14" BorderBrush="#D9E2EC" BorderThickness="1"
            Padding="16,12" Margin="0,0,0,12">
      <StackPanel>
        <DockPanel LastChildFill="False" Margin="0,0,0,12">
          <TextBlock Text="Filtreler" FontSize="13" FontWeight="SemiBold" Foreground="#102A43"
                     VerticalAlignment="Center" DockPanel.Dock="Left" />
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
            <Button Style="{StaticResource ToolbarButtonStyle}" Content="Filtreleri Temizle"
                    Margin="0,0,8,0" Click="FiltreleriTemizle_Click" Padding="14,7" />
            <Button Style="{StaticResource PrimaryToolbarButtonStyle}" Click="PdfIndir_Click" Padding="14,7">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" />
                <TextBlock Text="Filtreli PDF" />
              </StackPanel>
            </Button>
          </StackPanel>
        </DockPanel>
        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
          <StackPanel Width="140" Margin="0,0,12,8">
            <TextBlock Text="Başlangıç" Style="{StaticResource SapFilterLabel}" />
            <DatePicker x:Name="DpBaslangic" Height="32" SelectedDateChanged="FiltreDegisti" />
          </StackPanel>
          <StackPanel Width="140" Margin="0,0,12,8">
            <TextBlock Text="Bitiş" Style="{StaticResource SapFilterLabel}" />
            <DatePicker x:Name="DpBitis" Height="32" SelectedDateChanged="FiltreDegisti" />
          </StackPanel>
          <StackPanel Width="180" Margin="0,0,12,8">
            <TextBlock Text="Rapor Türü" Style="{StaticResource SapFilterLabel}" />
            <ComboBox x:Name="CmbRaporTuru" Style="{StaticResource FilterComboStyle}"
                      Height="32" SelectionChanged="FiltreDegisti" />
          </StackPanel>
          <StackPanel Width="150" Margin="0,0,12,8">
            <TextBlock Text="Modül" Style="{StaticResource SapFilterLabel}" />
            <ComboBox x:Name="CmbModul" Style="{StaticResource FilterComboStyle}"
                      Height="32" SelectionChanged="FiltreDegisti" />
          </StackPanel>
          <StackPanel Width="120" Margin="0,0,12,8">
            <TextBlock Text="Hareket" Style="{StaticResource SapFilterLabel}" />
            <ComboBox x:Name="CmbHareketTipi" Style="{StaticResource FilterComboStyle}"
                      Height="32" SelectionChanged="FiltreDegisti" />
          </StackPanel>
          <StackPanel Width="140" Margin="0,0,0,8">
            <TextBlock Text="Saha" Style="{StaticResource SapFilterLabel}" />
            <ComboBox x:Name="CmbSaha" Style="{StaticResource FilterComboStyle}"
                      Height="32" SelectionChanged="FiltreDegisti" />
          </StackPanel>
        </WrapPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="16" BorderBrush="#D9E2EC" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F0F4F8" BorderBrush="#D9E2EC" BorderThickness="0,0,0,1"
                CornerRadius="16,16,0,0" Padding="16,10">
          <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                         Foreground="#0D7377" Margin="0,0,10,0" VerticalAlignment="Center" />
              <TextBlock x:Name="TxtRaporBaslik" Text="Finansal Özet" FontSize="13" FontWeight="SemiBold"
                         Foreground="#102A43" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <TextBlock x:Name="TxtKayitSayisi" Text="0 kayıt" FontSize="12"
                         Foreground="#627D98" Margin="0,0,16,0" VerticalAlignment="Center" />
              <TextBlock x:Name="TxtRaporToplam" Text="₺0" FontSize="15" FontWeight="SemiBold"
                         Foreground="#102A43" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Row="1" BorderBrush="#D9E2EC" BorderThickness="0,0,0,1" Padding="16,10" MaxHeight="120">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Finansal Özet" FontSize="12" FontWeight="SemiBold" Foreground="#102A43" Margin="0,0,0,8" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="OzetPanel" Orientation="Vertical" />
            </ScrollViewer>
          </Grid>
        </Border>

        <TabControl x:Name="RaporTab" Grid.Row="2" Padding="0" BorderThickness="0" Visibility="Collapsed"
                    Style="{StaticResource ModuleTabControlStyle}"
                    ItemContainerStyle="{StaticResource ModuleTabItemStyle}">
          <TabItem Header="Modül" x:Name="TabModul">
            <DataGrid x:Name="ModulGrid" Style="{StaticResource ModuleDataGridStyle}"
                      BorderThickness="0" AlternatingRowBackground="Transparent" IsReadOnly="True"
                      AutoGenerateColumns="False" MouseDoubleClick="GelirDuzenle_DoubleClick">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Modül" Binding="{Binding ModulAdi}" Width="*" MinWidth="140" />
                <DataGridTextColumn Header="Tip" Binding="{Binding Tip}" Width="70" />
                <DataGridTextColumn Header="Kayıt" Binding="{Binding KayitSayisi}" Width="65" />
                <DataGridTextColumn Header="Toplam" Binding="{Binding ToplamTutar, StringFormat='₺{0:N2}'}" Width="120" />
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
          <TabItem Header="Nakit Akışı" x:Name="TabAylik">
            <DataGrid x:Name="AylikGrid" Style="{StaticResource ModuleDataGridStyle}"
                      BorderThickness="0" AlternatingRowBackground="Transparent" IsReadOnly="True" AutoGenerateColumns="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Ay" Binding="{Binding Ay}" Width="*" MinWidth="120" />
                <DataGridTextColumn Header="Gider" Binding="{Binding Gider, StringFormat='₺{0:N2}'}" Width="110" />
                <DataGridTextColumn Header="Gelir" Binding="{Binding Gelir, StringFormat='₺{0:N2}'}" Width="110" />
                <DataGridTextColumn Header="Net" Binding="{Binding Net, StringFormat='₺{0:N2}'}" Width="110" />
                <DataGridTextColumn Header="Hareket" Binding="{Binding HareketSayisi}" Width="75" />
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
          <TabItem Header="Vadeler" x:Name="TabVade">
            <DataGrid x:Name="VadeGrid" Style="{StaticResource ModuleDataGridStyle}"
                      BorderThickness="0" AlternatingRowBackground="Transparent" IsReadOnly="True" AutoGenerateColumns="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Vade" Binding="{Binding VadeTarihi}" Width="85" />
                <DataGridTextColumn Header="İşlem" Binding="{Binding IslemTarihi}" Width="85" />
                <DataGridTextColumn Header="Firma" Binding="{Binding Firma}" Width="*" MinWidth="120" />
                <DataGridTextColumn Header="Belge" Binding="{Binding BelgeNo}" Width="90" />
                <DataGridTextColumn Header="Açıklama" Binding="{Binding Aciklama}" Width="*" MinWidth="100" />
                <DataGridTextColumn Header="Vade Gün" Binding="{Binding VadeGunu}" Width="70" />
                <DataGridTextColumn Header="Tutar" Binding="{Binding Tutar, StringFormat='₺{0:N2}'}" Width="95" />
                <DataGridTextColumn Header="KDV Dahil" Binding="{Binding KdvDahilTutar, StringFormat='₺{0:N2}'}" Width="100" />
                <DataGridTextColumn Header="Durum" Binding="{Binding DurumMetin}" Width="110" />
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
          <TabItem Header="Grup" x:Name="TabGrup">
            <DataGrid x:Name="GrupGrid" Style="{StaticResource ModuleDataGridStyle}"
                      BorderThickness="0" AlternatingRowBackground="Transparent" IsReadOnly="True" AutoGenerateColumns="False">
              <DataGrid.Columns>
                <DataGridTextColumn x:Name="ColGrupAdi" Header="Grup" Binding="{Binding GrupAdi}" Width="*" MinWidth="130" />
                <DataGridTextColumn Header="Kayıt" Binding="{Binding KayitSayisi}" Width="65" />
                <DataGridTextColumn Header="Gider" Binding="{Binding GiderTutar, StringFormat='₺{0:N2}'}" Width="100" />
                <DataGridTextColumn Header="Gelir" Binding="{Binding GelirTutar, StringFormat='₺{0:N2}'}" Width="100" />
                <DataGridTextColumn Header="Modül Dağılımı" Binding="{Binding ModulDagilimi}" Width="*" MinWidth="160" />
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
          <TabItem Header="Hareketler" x:Name="TabHareket">
            <DataGrid x:Name="HareketGrid" Style="{StaticResource ModuleDataGridStyle}"
                      BorderThickness="0" AlternatingRowBackground="Transparent" IsReadOnly="True"
                      AutoGenerateColumns="False" MouseDoubleClick="GelirDuzenle_DoubleClick">
              <DataGrid.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Düzenle" Click="GelirDuzenle_Click" />
                  <MenuItem Header="Sil" Click="GelirSil_Click" />
                </ContextMenu>
              </DataGrid.ContextMenu>
              <DataGrid.Columns>
                <DataGridTextColumn Header="Tip" Binding="{Binding Tip}" Width="55" />
                <DataGridTextColumn Header="Tarih" Binding="{Binding Tarih}" Width="85" />
                <DataGridTextColumn Header="Modül" Binding="{Binding Modul}" Width="110" />
                <DataGridTextColumn Header="Belge No" Binding="{Binding BelgeNo}" Width="90" />
                <DataGridTextColumn Header="Kategori" Binding="{Binding Kategori}" Width="90" />
                <DataGridTextColumn Header="Açıklama" Binding="{Binding Aciklama}" Width="*" MinWidth="130" />
                <DataGridTextColumn Header="Tedarikçi/Kaynak" Binding="{Binding Tedarikci}" Width="120" />
                <DataGridTextColumn Header="Saha" Binding="{Binding Saha}" Width="100" />
                <DataGridTextColumn Header="Ödeme" Binding="{Binding OdemeSekli}" Width="80" />
                <DataGridTextColumn Header="Tutar" Binding="{Binding TutarMetin}" Width="100" />
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
        </TabControl>

        <DataGrid x:Name="AnaGrid" Grid.Row="2" Style="{StaticResource ModuleDataGridStyle}"
                  BorderThickness="0" AlternatingRowBackground="Transparent" IsReadOnly="True"
                  AutoGenerateColumns="False" Visibility="Visible">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Modül" Binding="{Binding ModulAdi}" Width="*" MinWidth="140" />
            <DataGridTextColumn Header="Tip" Binding="{Binding Tip}" Width="70" />
            <DataGridTextColumn Header="Kayıt" Binding="{Binding KayitSayisi}" Width="65" />
            <DataGridTextColumn Header="Toplam" Binding="{Binding ToplamTutar, StringFormat='₺{0:N2}'}" Width="120" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
