<UserControl x:Class="SatinalmaPro.Views.Controls.MalzemeOneriGiris"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             VerticalAlignment="Center"
             MinHeight="28"
             ClipToBounds="False">
  <Grid VerticalAlignment="Center">
    <TextBox x:Name="MetinKutusu"
             BorderThickness="0"
             Padding="6,4"
             Background="Transparent"
             Foreground="#102A43"
             CaretBrush="#102A43"
             VerticalContentAlignment="Center"
             VerticalAlignment="Center"
             ToolTip="Yazarak filtrele · F2 — listeden seç"
             TextChanged="MetinKutusu_TextChanged"
             GotKeyboardFocus="MetinKutusu_GotKeyboardFocus"
             LostKeyboardFocus="MetinKutusu_LostKeyboardFocus"
             PreviewKeyDown="MetinKutusu_PreviewKeyDown" />
    <!-- Popup ayrı katmanda; DataGrid satır yüksekliğini şişirmez -->
    <Popup x:Name="OneriPopup"
           PlacementTarget="{Binding ElementName=MetinKutusu}"
           Placement="Bottom"
           StaysOpen="True"
           AllowsTransparency="True"
           PopupAnimation="None"
           Focusable="False">
      <Border BorderBrush="#94A3B8"
              BorderThickness="1"
              Background="White"
              CornerRadius="6"
              MaxWidth="480">
        <Border.Effect>
          <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18" Color="#000000" />
        </Border.Effect>
        <ListBox x:Name="OneriListesi"
                 MaxHeight="180"
                 MinWidth="220"
                 BorderThickness="0"
                 Background="White"
                 Foreground="#102A43"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="OneriListesi_SelectionChanged"
                 PreviewMouseLeftButtonDown="OneriListesi_PreviewMouseLeftButtonDown">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="10,7" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Foreground" Value="#102A43" />
            </Style>
          </ListBox.ItemContainerStyle>
        </ListBox>
      </Border>
    </Popup>
  </Grid>
</UserControl>
