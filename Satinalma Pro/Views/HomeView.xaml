<UserControl x:Class="SatinalmaPro.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dash="clr-namespace:SatinalmaPro.Controls.Dashboard"
             xmlns:helpers="clr-namespace:SatinalmaPro.Helpers"
             helpers:ScrollWheelHelper.IsEnabled="True"
             Background="#EEF2F5">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="32,28,32,28">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Hero -->
      <Border Grid.Row="0" CornerRadius="20" Padding="28,26" Margin="0,0,0,20">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#102A43" Offset="0" />
            <GradientStop Color="#0D7377" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="MALZEME &amp; TAKİP ÖZETİ" FontSize="11" FontWeight="Bold" Foreground="#9FE7E5" Margin="0,0,0,8" />
            <TextBlock x:Name="TxtKarsilama" FontSize="28" FontWeight="SemiBold" Foreground="White" />
            <TextBlock x:Name="TxtAltBaslik" FontSize="14" Foreground="#D9E2EC" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="640" />
            <TextBlock x:Name="TxtTarihSaat" FontSize="12" Foreground="#9FB3C8" Margin="0,10,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BtnStokGit" Padding="14,12" Cursor="Hand" Margin="0,0,10,0"
                    Click="BtnStokGit_Click" Content="Stok" FontWeight="SemiBold"
                    Background="#1A3A5C" Foreground="White" BorderThickness="0">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}"
                          BorderBrush="#2E4A66" BorderThickness="1">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </ControlTemplate>
              </Button.Template>
            </Button>
            <Button x:Name="BtnRaporOlustur" Padding="16,12" Cursor="Hand"
                    Click="BtnRaporOlustur_Click" Content="Alınan" FontWeight="SemiBold"
                    Background="#0D7377" Foreground="White" BorderThickness="0">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </ControlTemplate>
              </Button.Template>
            </Button>
          </StackPanel>
          <Button x:Name="BtnYeniTalep" Visibility="Collapsed" Click="BtnYeniTalep_Click" />
        </Grid>
      </Border>

      <!-- Uyarı şeridi -->
      <Border x:Name="UyariSeridi" Grid.Row="1" Visibility="Collapsed" CornerRadius="12"
              Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1"
              Padding="16,12" Margin="0,0,0,20">
        <DockPanel>
          <TextBlock Text="!" FontWeight="Bold" Foreground="#B45309" Margin="0,0,12,0" VerticalAlignment="Center" />
          <TextBlock x:Name="TxtUyari" TextWrapping="Wrap" Foreground="#78350F" FontSize="13" VerticalAlignment="Center" />
        </DockPanel>
      </Border>

      <!-- KPI -->
      <UniformGrid x:Name="StatGrid" Grid.Row="2" Rows="1" Columns="5" Margin="0,0,0,24" />

      <!-- Modüller — yalnızca malzeme / takip -->
      <StackPanel Grid.Row="3" Margin="0,0,0,24">
        <TextBlock Text="Takip Modülleri" FontSize="15" FontWeight="SemiBold" Foreground="#102A43" Margin="0,0,0,14" />
        <WrapPanel x:Name="ModulPanel" />
      </StackPanel>

      <!-- Grafikler -->
      <Grid Grid.Row="4" Margin="0,0,0,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.4*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <dash:ErpLineChartPanel x:Name="HarcamaGrafik" Grid.Column="0" />
        <dash:ErpDonutChartPanel x:Name="DagilimGrafik" Grid.Column="2" />
      </Grid>

      <!-- Stok + Aktivite + Finans -->
      <Grid Grid.Row="5" Margin="0,0,0,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="0.9*" />
        </Grid.ColumnDefinitions>
        <dash:StockAlertPanelControl x:Name="StokUyariPanel" Grid.Column="0" />
        <dash:ActivityPanelControl x:Name="AktivitePanel" Grid.Column="2" />
        <dash:ErpRightWidgetsPanel x:Name="SagOzet" Grid.Column="4" />
      </Grid>

      <!-- Hızlı işlemler -->
      <Border Grid.Row="6" Style="{StaticResource DashCardBorderStyle}" Padding="20,18" Margin="0,0,0,8">
        <StackPanel>
          <TextBlock Text="Hızlı Erişim" FontSize="15" FontWeight="SemiBold"
                     Foreground="{StaticResource DashTextBrush}" Margin="0,0,0,14" />
          <dash:ErpQuickActionsPanel x:Name="QuickActions" />
        </StackPanel>
      </Border>

      <!-- Gizli: CS referansları -->
      <Grid Grid.Row="7" Visibility="Collapsed" Height="0">
        <TextBlock x:Name="TxtListeOzet" />
        <Border x:Name="FiltreHepsi" MouseLeftButtonUp="Filtre_Click" Tag="Hepsi"><TextBlock x:Name="TxtFiltreHepsi" /></Border>
        <Border x:Name="FiltreOnay" MouseLeftButtonUp="Filtre_Click" Tag="Onay"><TextBlock x:Name="TxtFiltreOnay" /></Border>
        <Border x:Name="FiltreTeklif" MouseLeftButtonUp="Filtre_Click" Tag="Teklif"><TextBlock x:Name="TxtFiltreTeklif" /></Border>
        <Border x:Name="FiltreSiparis" MouseLeftButtonUp="Filtre_Click" Tag="Siparis"><TextBlock x:Name="TxtFiltreSiparis" /></Border>
        <DataGrid x:Name="KayitGrid" SelectionChanged="KayitGrid_SelectionChanged" MouseDoubleClick="KayitGrid_MouseDoubleClick" />
        <TextBlock x:Name="TxtAltKayit" />
        <TextBlock x:Name="TxtDetayNo" />
        <TextBlock x:Name="TxtDetayCari" />
        <TextBlock x:Name="TxtDetayTarih" />
        <TextBlock x:Name="TxtDetayVade" />
        <TextBlock x:Name="TxtDetayTutar" />
        <TextBlock x:Name="TxtDetayKalan" />
        <Border x:Name="DetayDurumKutu"><TextBlock x:Name="TxtDetayDurum" /></Border>
        <ItemsControl x:Name="ListeSonIslem" />
        <Button Click="BtnDetaySatinalma_Click" />
        <Button Click="BtnDetayAc_Click" />
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
