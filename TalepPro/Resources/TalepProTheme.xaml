<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Talep Pro — indigo profesyonel palet (SP kırmızısından ayrı) -->
  <Color x:Key="TpAccent">#4F46E5</Color>
  <Color x:Key="TpAccentDark">#3730A3</Color>
  <Color x:Key="TpAccentSoft">#EEF2FF</Color>
  <Color x:Key="TpSidebar">#0F172A</Color>
  <Color x:Key="TpSidebarHover">#1E293B</Color>
  <Color x:Key="TpCanvas">#F1F5F9</Color>
  <Color x:Key="TpInk">#0F172A</Color>
  <Color x:Key="TpMuted">#64748B</Color>
  <Color x:Key="TpLine">#E2E8F0</Color>
  <Color x:Key="TpCard">#FFFFFF</Color>

  <SolidColorBrush x:Key="TpAccentBrush" Color="{StaticResource TpAccent}" />
  <SolidColorBrush x:Key="TpAccentDarkBrush" Color="{StaticResource TpAccentDark}" />
  <SolidColorBrush x:Key="TpAccentSoftBrush" Color="{StaticResource TpAccentSoft}" />
  <SolidColorBrush x:Key="TpSidebarBrush" Color="{StaticResource TpSidebar}" />
  <SolidColorBrush x:Key="TpSidebarHoverBrush" Color="{StaticResource TpSidebarHover}" />
  <SolidColorBrush x:Key="TpCanvasBrush" Color="{StaticResource TpCanvas}" />
  <SolidColorBrush x:Key="TpInkBrush" Color="{StaticResource TpInk}" />
  <SolidColorBrush x:Key="TpMutedBrush" Color="{StaticResource TpMuted}" />
  <SolidColorBrush x:Key="TpLineBrush" Color="{StaticResource TpLine}" />
  <SolidColorBrush x:Key="TpCardBrush" Color="{StaticResource TpCard}" />

  <!-- SatinalmaModuleTheme override — yalnızca Talep Pro App merge sırası -->
  <Color x:Key="SatModAccent">#4F46E5</Color>
  <Color x:Key="SatModAccentSoft">#EEF2FF</Color>
  <Color x:Key="SatModRose">#4F46E5</Color>
  <Color x:Key="SatModBg">#F1F5F9</Color>
  <Color x:Key="SatModInk">#0F172A</Color>

  <SolidColorBrush x:Key="SatModAccentBrush" Color="{StaticResource SatModAccent}" />
  <SolidColorBrush x:Key="SatModAccentSoftBrush" Color="{StaticResource SatModAccentSoft}" />
  <SolidColorBrush x:Key="SatModBgBrush" Color="{StaticResource SatModBg}" />
  <SolidColorBrush x:Key="SatModInkBrush" Color="{StaticResource SatModInk}" />

  <LinearGradientBrush x:Key="SatModHeroGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#0F172A" Offset="0" />
    <GradientStop Color="#4F46E5" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="SatModIconGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#6366F1" Offset="0" />
    <GradientStop Color="#312E81" Offset="1" />
  </LinearGradientBrush>

  <Style x:Key="TpGhostButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#CBD5E1" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#1E293B" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TpPrimaryButton" TargetType="Button">
    <Setter Property="Background" Value="#4F46E5" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#4338CA" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TpToolbarButton" TargetType="Button">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="Foreground" Value="#334155" />
    <Setter Property="BorderBrush" Value="#E2E8F0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#EEF2FF" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="#C7D2FE" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
