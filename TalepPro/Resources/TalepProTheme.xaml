<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Talep Pro — referans: açık kurumsal turkuaz masaüstü teması -->
  <Color x:Key="PrimaryTeal">#07858E</Color>
  <Color x:Key="PrimaryTealDark">#046C75</Color>
  <Color x:Key="PrimaryTealLight">#E8F7F7</Color>
  <Color x:Key="NavyText">#10233F</Color>
  <Color x:Key="SecondaryText">#607089</Color>
  <Color x:Key="AppBackground">#F5F7FA</Color>
  <Color x:Key="Surface">#FFFFFF</Color>
  <Color x:Key="Border">#DDE4EC</Color>
  <Color x:Key="Danger">#E83F45</Color>
  <Color x:Key="Warning">#F28C28</Color>
  <Color x:Key="Success">#24964A</Color>
  <Color x:Key="Info">#246FE5</Color>
  <Color x:Key="Purple">#7447D8</Color>
  <Color x:Key="BadgeCream">#F5E6A8</Color>
  <Color x:Key="RowHover">#F3F6F9</Color>
  <Color x:Key="RowSelected">#E8F7F7</Color>
  <Color x:Key="HeaderSurface">#F8FAFC</Color>

  <SolidColorBrush x:Key="PrimaryTealBrush" Color="{StaticResource PrimaryTeal}" />
  <SolidColorBrush x:Key="PrimaryTealDarkBrush" Color="{StaticResource PrimaryTealDark}" />
  <SolidColorBrush x:Key="PrimaryTealLightBrush" Color="{StaticResource PrimaryTealLight}" />
  <SolidColorBrush x:Key="NavyTextBrush" Color="{StaticResource NavyText}" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryText}" />
  <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackground}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}" />
  <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource Info}" />
  <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource Purple}" />
  <SolidColorBrush x:Key="BadgeCreamBrush" Color="{StaticResource BadgeCream}" />
  <SolidColorBrush x:Key="RowHoverBrush" Color="{StaticResource RowHover}" />
  <SolidColorBrush x:Key="RowSelectedBrush" Color="{StaticResource RowSelected}" />
  <SolidColorBrush x:Key="HeaderSurfaceBrush" Color="{StaticResource HeaderSurface}" />

  <!-- Geriye dönük Tp* anahtarları -->
  <Color x:Key="TpAccent">#07858E</Color>
  <Color x:Key="TpAccentDark">#046C75</Color>
  <Color x:Key="TpAccentSoft">#E8F7F7</Color>
  <Color x:Key="TpSidebar">#FFFFFF</Color>
  <Color x:Key="TpSidebarHover">#F3F6F9</Color>
  <Color x:Key="TpCanvas">#F5F7FA</Color>
  <Color x:Key="TpInk">#10233F</Color>
  <Color x:Key="TpMuted">#607089</Color>
  <Color x:Key="TpLine">#DDE4EC</Color>
  <Color x:Key="TpCard">#FFFFFF</Color>

  <SolidColorBrush x:Key="TpAccentBrush" Color="{StaticResource TpAccent}" />
  <SolidColorBrush x:Key="TpAccentDarkBrush" Color="{StaticResource TpAccentDark}" />
  <SolidColorBrush x:Key="TpAccentSoftBrush" Color="{StaticResource TpAccentSoft}" />
  <SolidColorBrush x:Key="TpSidebarBrush" Color="{StaticResource TpSidebar}" />
  <SolidColorBrush x:Key="TpSidebarHoverBrush" Color="{StaticResource TpSidebarHover}" />
  <SolidColorBrush x:Key="TpCanvasBrush" Color="{StaticResource TpCanvas}" />
  <SolidColorBrush x:Key="TpInkBrush" Color="{StaticResource TpInk}" />
  <SolidColorBrush x:Key="TpMutedBrush" Color="{StaticResource TpMuted}" />
  <SolidColorBrush x:Key="TpLineBrush" Color="{StaticResource TpLine}" />
  <SolidColorBrush x:Key="TpCardBrush" Color="{StaticResource TpCard}" />

  <!-- SatinalmaModuleTheme override — Talep Pro merge sırası -->
  <Color x:Key="SatModAccent">#07858E</Color>
  <Color x:Key="SatModAccentSoft">#E8F7F7</Color>
  <Color x:Key="SatModRose">#07858E</Color>
  <Color x:Key="SatModBg">#F5F7FA</Color>
  <Color x:Key="SatModInk">#10233F</Color>

  <SolidColorBrush x:Key="SatModAccentBrush" Color="{StaticResource SatModAccent}" />
  <SolidColorBrush x:Key="SatModAccentSoftBrush" Color="{StaticResource SatModAccentSoft}" />
  <SolidColorBrush x:Key="SatModBgBrush" Color="{StaticResource SatModBg}" />
  <SolidColorBrush x:Key="SatModInkBrush" Color="{StaticResource SatModInk}" />

  <LinearGradientBrush x:Key="SatModHeroGradient" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#10233F" Offset="0" />
    <GradientStop Color="#07858E" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="SatModIconGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#07858E" Offset="0" />
    <GradientStop Color="#046C75" Offset="1" />
  </LinearGradientBrush>

  <DropShadowEffect x:Key="TpCardShadow" BlurRadius="8" ShadowDepth="1" Opacity="0.06" Color="#10233F" />

  <!-- Tipografi -->
  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource NavyTextBrush}" />
  </Style>

  <Style x:Key="SectionSubtitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="BreadcrumbText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
  </Style>

  <Style x:Key="NavGroupLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    <Setter Property="Margin" Value="14,16,14,6" />
  </Style>

  <!-- Butonlar -->
  <Style x:Key="PrimaryButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource PrimaryTealBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="14,9" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10"
                  Padding="{TemplateBinding Padding}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryTealDarkBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#035A61" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryTealDarkBrush}" />
              <Setter TargetName="Bd" Property="BorderThickness" Value="1.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SecondaryButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{StaticResource NavyTextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14,9" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryTealLightBrush}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="#B7E0E2" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#D7F0F1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryTealBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTealDarkBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource PrimaryTealBrush}" />
  </Style>

  <Style x:Key="PurpleOutlineButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
    <Setter Property="Foreground" Value="{StaticResource PurpleBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource PurpleBrush}" />
  </Style>

  <Style x:Key="IconButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="18"
                  Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHoverBrush}" />
              <Setter Property="Foreground" Value="{StaticResource NavyTextBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryTealLightBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FilterButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style x:Key="TabButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
            <Grid>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom"
                      Background="Transparent" CornerRadius="1" Margin="0,0,0,-2" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource NavyTextBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Active">
              <Setter Property="Foreground" Value="{StaticResource PrimaryTealDarkBrush}" />
              <Setter TargetName="Underline" Property="Background" Value="{StaticResource PrimaryTealBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PaginationButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontFamily" Value="Segoe UI" />
  </Style>

  <!-- Navigasyon -->
  <Style x:Key="NavigationItem" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="8,1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Shell" Background="Transparent" CornerRadius="10" Padding="10,9">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Shell" Property="Background" Value="{StaticResource RowHoverBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Active">
              <Setter TargetName="Shell" Property="Background" Value="{StaticResource PrimaryTealLightBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource PrimaryTealBrush}" />
              <Setter TargetName="Shell" Property="BorderThickness" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ActiveNavigationItem" TargetType="Button" BasedOn="{StaticResource NavigationItem}" />

  <Style x:Key="NotificationBadge" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource DangerBrush}" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="MinWidth" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="StatusBadge" TargetType="Border">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="SummaryCard" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16,14" />
    <Setter Property="Margin" Value="0,0,12,0" />
  </Style>

  <Style x:Key="SearchBox" TargetType="TextBox">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource NavyTextBrush}" />
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CaretBrush" Value="{StaticResource PrimaryTealBrush}" />
  </Style>

  <Style x:Key="UserProfilePanel" TargetType="Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="14,12" />
  </Style>

  <Style x:Key="ModernDataGrid" TargetType="DataGrid" BasedOn="{StaticResource SatModDataGrid}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="RowBackground" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="AlternatingRowBackground" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="RowHeight" Value="48" />
    <Setter Property="ColumnHeaderHeight" Value="40" />
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="SelectionUnit" Value="FullRow" />
    <Setter Property="CanUserAddRows" Value="False" />
    <Setter Property="CanUserDeleteRows" Value="False" />
    <Setter Property="AutoGenerateColumns" Value="False" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="EnableRowVirtualization" Value="True" />
    <Setter Property="EnableColumnVirtualization" Value="True" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource NavyTextBrush}" />
  </Style>

  <!-- Alias eski stiller -->
  <Style x:Key="TpPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}" />
  <Style x:Key="TpToolbarButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}" />
  <Style x:Key="TpGhostButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
    <Setter Property="Width" Value="Auto" />
    <Setter Property="Height" Value="Auto" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

</ResourceDictionary>
