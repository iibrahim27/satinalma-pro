<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>TalepPro</AssemblyName>
    <Product>Talep Pro</Product>
    <AssemblyTitle>Talep Pro</AssemblyTitle>
    <Company>MV İNŞAAT</Company>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>2.1.106</Version>
    <AssemblyVersion>2.1.106.0</AssemblyVersion>
    <FileVersion>2.1.106.0</FileVersion>
    <InformationalVersion>2.1.106</InformationalVersion>
    <RootNamespace>TalepPro</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
    <Resource Include="Resources\TalepProTheme.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModernWpfUI" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- Satınalma UI + servisler Pro derlemesinden paylaşılır; aynı oturum/Firebase -->
    <ProjectReference Include="..\Satinalma Pro\SatinalmaPro.csproj"
                      GlobalPropertiesToRemove="Version;PackageVersion;AssemblyVersion;FileVersion;InformationalVersion" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Satinalma Pro\firebase_ayarlar.json" Link="firebase_ayarlar.json"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\Satinalma Pro\firebase_ayarlar.json')" />
    <None Include="..\Satinalma Pro\fcm-service-account.json" Link="fcm-service-account.json"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\Satinalma Pro\fcm-service-account.json')" />
  </ItemGroup>

</Project>
